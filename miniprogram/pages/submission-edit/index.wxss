.editor-page{padding:24px 20px 32px;color:var(--ink,#172638)}.editor-page.with-dock{padding-bottom:calc(112px + env(safe-area-inset-bottom))}.editor-intro{margin-bottom:24px}.editor-title{font-size:25px;font-weight:650;line-height:1.4;display:block}.small-copy{font-size:14px;color:var(--muted,#647084);line-height:1.65;display:block;margin-top:8px}.form-section{background:var(--surface,#fff);border-radius:12px;margin-bottom:12px;padding:0 16px}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:80px;padding:16px 0;margin:0;width:100%;background:transparent;border-radius:0;text-align:left;font-weight:400;line-height:1.5}.section-title{display:block;font-size:18px;font-weight:600;color:var(--ink,#172638)}.section-summary{display:block;font-size:13px;color:var(--muted,#647084);margin-top:4px;line-height:1.6}.disclosure{font-size:25px;color:var(--blue,#165dcc);line-height:1;min-width:24px;text-align:center}.section-body{border-top:1px solid var(--line,#e5eaf1);padding:20px 0 16px}.field{margin-bottom:20px;min-width:0}.field-label{display:block;font-size:14px;color:var(--ink,#172638);font-weight:500;margin-bottom:8px;line-height:1.5}.field input,.field textarea,.picker-field{box-sizing:border-box;width:100%;background:#fff;border:1px solid #aab8ca;border-radius:8px;color:var(--ink,#172638);font-size:16px;line-height:1.5}.field input{height:48px;padding:0 12px}.field textarea{padding:12px;min-height:108px}.field input[disabled],.field textarea[disabled]{background:#f5f7fa;color:#43536a;border-color:var(--line,#e5eaf1)}.picker-field{min-height:48px;padding:11px 12px;display:flex;align-items:center;justify-content:space-between;gap:8px;word-break:break-word}.picker-field>text{color:var(--muted,#647084);flex:none}.placeholder{color:#657389}.field-hint{display:block;font-size:12px;color:var(--muted,#647084);line-height:1.65;margin-top:8px}.field-error{display:block;font-size:13px;color:#a43128;line-height:1.6;margin-top:8px}.field-pair{display:flex;gap:12px;align-items:flex-start}.field-pair>.field{width:calc(50% - 6px)}.standalone-hint{margin:-12px 0 20px}.check-option{display:flex;align-items:center;gap:8px;min-height:48px;font-size:14px;line-height:1.5;color:var(--ink,#172638)}.check-option checkbox{flex:none}.network-options{display:flex;flex-wrap:wrap;column-gap:16px}.network-options .check-option{min-width:calc(50% - 8px)}.switch-row,.verify-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;padding:12px 0;font-size:15px;line-height:1.5}.switch-row+.switch-row{border-top:1px solid var(--line,#e5eaf1)}.switch-row>view,.verify-row>view{flex:1}.switch-row switch,.verify-row switch{flex:none}.verify-row{border-top:1px solid var(--line,#e5eaf1);border-bottom:1px solid var(--line,#e5eaf1);margin:8px 0 20px}.verify-label{font-weight:600}.next-section{min-height:48px;display:flex;align-items:center;justify-content:space-between;background:transparent;padding:8px 0;margin:0;color:var(--blue,#165dcc);font-size:14px;text-align:left;border-top:1px solid var(--line,#e5eaf1);border-radius:0}.next-section>text{font-size:22px}.image-row{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--line,#e5eaf1)}.image-preview{flex:1;min-height:48px;padding:8px 0;display:flex;align-items:center;justify-content:space-between;gap:12px;background:transparent;text-align:left;color:var(--ink,#172638);font-size:14px;margin:0}.image-status{color:var(--blue,#165dcc);font-size:12px}.remove-image{flex:none;background:transparent;color:#9c3429;min-height:48px;margin:0;padding:8px;font-size:13px}.upload-button,.copy-button{display:flex;align-items:center;justify-content:center;min-height:48px;padding:8px 12px;color:var(--blue,#165dcc);background:#edf4ff;border-radius:8px;font-size:14px;margin:12px 0}.copy-button{margin:0 0 20px}.editor-dock{position:fixed;bottom:0;left:0;right:0;padding:12px 20px calc(12px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid var(--line,#e5eaf1);display:flex;gap:12px;z-index:10}.primary-button,.secondary-button{display:flex;align-items:center;justify-content:center;min-height:48px;padding:12px 16px;border-radius:8px;font-size:16px;line-height:1.5;margin:0;font-weight:500}.primary-button{flex:1;background:var(--blue,#165dcc);color:#fff}.secondary-button{background:#fff;color:var(--ink,#172638);border:1px solid #aab8ca}.primary-button[disabled],.secondary-button[disabled],.upload-button[disabled]{opacity:.55}.section-heading::after,.next-section::after,.image-preview::after,.remove-image::after,.upload-button::after,.copy-button::after,.primary-button::after,.secondary-button::after,.text-button::after{border:0}.section-heading:active,.next-section:active,.image-preview:active{opacity:.65}.return-notice{padding:16px;background:#fff6ea;color:#874311;border-radius:8px;font-size:14px;line-height:1.65;margin-bottom:16px}.notice-title{display:block;font-weight:600;margin-bottom:4px}.published-notice{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#edf4ff;color:var(--blue,#165dcc);border-radius:8px;padding:8px 12px;font-size:14px;margin-bottom:16px}.error-banner{padding:12px 16px;background:#fff3f1;color:#9c3429;border-radius:8px;font-size:14px;line-height:1.6;margin-bottom:16px}.text-button{background:transparent;color:var(--blue,#165dcc);min-height:48px;font-size:14px;display:flex;align-items:center;justify-content:center}.loading{padding:32px 0;font-size:14px;color:var(--muted,#647084)}.empty{text-align:center;padding:32px 16px;background:#fff;border-radius:12px}.empty-title{font-size:19px;font-weight:600}
@media(max-width:350px){.editor-page{padding-left:16px;padding-right:16px}.field-pair{display:block}.field-pair>.field{width:100%}.editor-dock{padding-left:16px;padding-right:16px}.secondary-button,.primary-button{font-size:14px;padding-left:12px;padding-right:12px}}
.image-thumbnail{width:48px;height:48px;flex:none;border-radius:6px;background:#f0f4fa}.image-label{flex:1}
