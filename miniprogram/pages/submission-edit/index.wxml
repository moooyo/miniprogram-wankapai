<design-nav title="{{reviewMode ? (readOnly ? '处理结果' : '核实活动') : (readOnly ? '投稿详情' : submissionId ? '修改投稿' : '分享活动')}}" back />
<view class="editor-page {{ready && !readOnly && !denied ? 'with-dock' : ''}}">
  <view wx:if="{{loading}}" class="loading">正在读取稿件…</view>
  <view wx:elif="{{denied}}" class="empty-state"><text class="empty-title">此账号没有审核权限</text><text class="small-copy">请使用已获授权的运营账号。</text><button class="text-button" bindtap="goBack">返回</button></view>
  <view wx:elif="{{!ready}}" class="empty-state"><text class="empty-title">稿件未能读取</text><text class="small-copy">{{error}}</text><button class="text-button" bindtap="load">重新读取</button></view>
  <block wx:else>
    <text class="lead-intro">{{readOnly ? '处理后的稿件保留只读记录。' : reviewMode ? '核对原始出处与参与入口，完善规则后再公开。' : '补齐活动规则与来源后提交审核，审核通过后公开。草稿可分次填写。'}}</text>
    <view wx:if="{{pendingCreationUnconfirmed && !saving && !submitted}}" class="status-notice" role="status"><text class="notice-title">上次提交结果尚未确认</text><text>内容暂时锁定，重试将确认原提交。若旧版草稿中另有修改，会保留副本，确认后继续编辑同一份投稿。</text><button class="text-button" bindtap="viewSubmissions">去我的投稿核对</button></view>
    <view wx:if="{{submitted && importedLead}}" class="status-notice" role="status"><text class="notice-title">完整投稿已提交审核</text><text>原线索草稿和未公开截图仍保存在本机，之后可从分享线索页恢复。</text><button class="text-button" bindtap="viewSubmissions" loading="{{openingSubmissions}}" disabled="{{openingSubmissions}}">{{openingSubmissions ? '正在打开投稿列表' : '查看我的投稿'}}</button></view>
    <view wx:elif="{{importedLead}}" class="status-notice"><text class="notice-title">已带入刚才填写的活动线索</text><text>请继续核对完整规则。原线索仍保存在本机草稿中；未选作参与入口的截图不会随完整稿提交，也不会自动公开。</text></view>
    <view wx:if="{{submission.status === 'returned'}}" class="return-notice"><text class="notice-title">{{reviewMode ? '已退回补充' : '请补充这些信息'}}</text><text>{{submission.reviewNote}}</text></view>
    <view wx:if="{{submission.status === 'published'}}" class="status-notice"><text class="notice-title">已审核发布</text><button wx:if="{{submission.activityId}}" class="text-button" bindtap="viewActivity">查看公开活动</button></view>
    <view wx:if="{{error || conflict}}" class="error-banner" role="alert"><text>{{error || '稿件已有更新，请读取最新版本。'}}</text><button wx:if="{{conflict}}" class="text-button" bindtap="reloadLatest" loading="{{reloading}}" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed}}">{{reloading ? '正在读取最新稿件' : '读取最新稿件'}}</button></view>
    <view wx:if="{{errorSummary.length}}" class="validation-summary" id="validation-summary" role="alert" aria-label="还有 {{errorSummary.length}} 项内容需要检查">
      <text class="notice-title">还有 {{errorSummary.length}} 项需要检查</text>
      <button wx:for="{{errorSummary}}" wx:key="field" class="validation-link" bindtap="goToError" data-field="{{item.field}}"><view><text class="validation-label">{{item.label}}</text><text>{{item.message}}</text></view><text class="validation-action">前往修改 ›</text></button>
    </view>

    <view class="editor-form {{reviewMode ? 'review-form' : ''}}">
    <view wx:if="{{reviewMode}}" class="form-section original-section">
      <view class="original-bank"><image wx:if="{{originalBankLogo}}" src="{{originalBankLogo}}" mode="aspectFit" /><text class="original-bank-name">{{originalBankName || (selectedBank && selectedBank.name) || '尚未选择银行'}}</text><text class="original-tag">投稿原文</text></view>
      <text class="original-title">{{submission.lead.title || submission.draft.title || draft.title || '未填写活动名称'}}</text>
      <text wx:if="{{leadReview}}" class="section-copy">这是一条待核实的活动线索。请按银行规则补齐完整信息，默认选项仅作为填写起点。</text>
      <view wx:if="{{sourceImageRows.length || imageRows.length}}" class="original-shots">
        <view class="section-heading-copy"><text class="field-label">{{sourceImageRows.length ? '投稿人提供的活动截图' : '投稿人提供的入口截图'}}</text><text class="section-copy">点击截图查看大图，核对活动名称、时间与规则。</text></view>
        <view wx:if="{{sourceImageRows.length}}" class="screenshot-grid">
          <view wx:for="{{sourceImageRows}}" wx:key="id" class="source-shot">
            <view class="screenshot-card" bindtap="openShot" data-id="{{item.id}}" data-scope="source" aria-label="查看{{item.label}}"><image wx:if="{{item.url}}" class="screenshot-image" src="{{item.url}}" mode="aspectFill" /><view wx:else class="screenshot-placeholder">{{loadingImages ? '读取中' : item.label}}</view></view>
            <button wx:if="{{!readOnly}}" class="source-image-action" bindtap="useSourceImage" data-id="{{item.id}}" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed || item.used}}">{{item.used ? '已用作入口' : '用作参与入口'}}</button>
          </view>
        </view>
        <view wx:else class="screenshot-grid"><view wx:for="{{imageRows}}" wx:key="id" class="screenshot-card" bindtap="openShot" data-id="{{item.id}}" data-scope="entrance" aria-label="查看{{item.label}}"><image wx:if="{{item.url}}" class="screenshot-image" src="{{item.url}}" mode="aspectFill" /><view wx:else class="screenshot-placeholder">{{loadingImages ? '读取中' : item.label}}</view></view></view>
      </view>
      <view wx:if="{{submission.lead.sourceUrl || submission.draft.sourceUrl}}" class="original-source"><text class="source-caption">来源链接</text><text class="source-content">{{submission.lead.sourceUrl || submission.draft.sourceUrl}}</text></view>
      <view wx:if="{{submission.lead.sourceNote || submission.draft.sourceNote}}" class="original-source"><text class="source-caption">出处说明或 App 入口路径</text><text class="source-content">{{submission.lead.sourceNote || submission.draft.sourceNote}}</text></view>
      <button wx:if="{{submission.lead.sourceUrl || submission.draft.sourceUrl || submission.lead.sourceNote || submission.draft.sourceNote}}" class="copy-button" bindtap="copySource" data-scope="original">复制来源内容</button>
    </view>

    <view class="form-section information-section" id="section-basic">
      <view class="section-heading-copy"><text class="section-title">活动信息</text><text class="section-copy">{{reviewMode ? '按核实后的内容修订活动名称与所属银行' : '活动名称与适用卡片将公开展示'}}</text></view>
      <view class="field" id="field-bankId"><text class="field-label">所属银行（必填）</text><view class="bank-grid"><button wx:for="{{bankGrid}}" wx:key="id" class="bank-option {{draft.bankId === item.id ? 'selected' : ''}}" bindtap="selectBankGrid" data-id="{{item.id}}" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><image src="{{item.logo}}" mode="aspectFit" /><text>{{item.shortName}}</text></button></view><text wx:if="{{errors.bankId}}" class="field-error">{{errors.bankId}}</text></view>
      <view class="field" id="field-title"><label for="title" class="field-label">活动名称（必填）</label><input id="title" value="{{draft.title}}" data-field="title" bindinput="input" maxlength="60" placeholder="例如：周末餐饮消费返现" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.title}}" class="field-error">{{errors.title}}</text></view>
      <view class="detail-disclosure"><button class="rules-heading" data-section="basic" bindtap="toggleSection" aria-expanded="{{openSection === 'basic'}}"><view><text class="section-title">适用卡片与参与条件</text><text class="section-copy">{{bankSummary}}</text></view><text class="disclosure {{openSection === 'basic' ? 'expanded' : ''}}" aria-hidden="true">⌄</text></button>
        <view wx:if="{{openSection === 'basic'}}" class="rules-body">
          <view wx:if="{{issuerOptions.length}}" class="field" id="field-issuerIds"><text class="field-label">适用发卡机构（必填）</text><checkbox-group class="check-options" bindchange="selectIssuers"><label wx:for="{{issuerOptions}}" wx:key="id" class="check-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#1F61D8" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text>{{item.name}}</text></label></checkbox-group><text class="field-hint">同一家银行的不同发卡机构，活动资格可能不同。</text><text wx:if="{{errors.issuerIds}}" class="field-error">{{errors.issuerIds}}</text></view>
          <view class="field" id="field-cardKind"><text class="field-label">卡片类型</text><picker range="{{cardKinds}}" range-key="name" value="{{cardKindIndex}}" data-field="cardKind" aria-label="卡片类型，{{cardKinds[cardKindIndex].name}}" bindchange="select" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="picker-field">{{cardKinds[cardKindIndex].name}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.cardKind}}" class="field-error">{{errors.cardKind}}</text></view>
          <view class="field" id="field-networks"><text class="field-label">卡组织（选填）</text><text class="field-hint">不勾选表示不限卡组织。</text><checkbox-group class="check-options" bindchange="selectNetworks"><label wx:for="{{networkOptions}}" wx:key="id" class="check-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#1F61D8" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text>{{item.name}}</text></label></checkbox-group><text wx:if="{{errors.networks}}" class="field-error">{{errors.networks}}</text></view>
          <view class="field" id="field-cardDescription"><label for="cardDescription" class="field-label">适用卡片说明（必填）</label><input id="cardDescription" value="{{draft.cardDescription}}" data-field="cardDescription" bindinput="input" maxlength="200" placeholder="例如：指定 Visa 信用卡，附属卡除外" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.cardDescription}}" class="field-error">{{errors.cardDescription}}</text></view>
          <view class="field" id="field-conditions"><label for="conditions" class="field-label">参与条件（必填）</label><textarea id="conditions" value="{{draft.conditions}}" data-field="conditions" bindinput="input" maxlength="2000" auto-height placeholder="说明消费要求、适用商户、报名方式、奖励上限和到账时间。" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.conditions}}" class="field-error">{{errors.conditions}}</text></view>
          <button class="next-section" data-section="rules" bindtap="toggleSection">{{readOnly || pendingCreationUnconfirmed ? '查看完整规则' : '继续完善完整规则'}}<text aria-hidden="true">›</text></button>
        </view>
      </view>
    </view>

    <view class="form-section core-rule-section">
      <view class="section-heading-copy"><text class="section-title">{{reviewMode ? '完善规则后发布' : '奖励与重置周期'}}</text><text class="section-copy">{{reviewMode ? '奖励数值大于 0，并选择重置周期后可发布' : '每个周期单独记录进度，上一期的记录与收益会保留'}}</text></view>
      <view wx:if="{{leadReview && (submission.lead.rules.rewardMinor || submission.lead.rules.cycle)}}" class="imported-rule-copy">投稿人已填写奖励与重置周期，核对无误后可直接发布。</view>
      <view class="field" id="field-rewardKind"><text class="field-label">奖励类型</text><view class="pills"><button wx:for="{{rewardOptions}}" wx:key="id" class="pill {{draft.rewardKind === item.id ? 'selected' : ''}}" bindtap="selectReward" data-id="{{item.id}}" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}">{{item.name}}</button></view><text wx:if="{{errors.rewardKind}}" class="field-error">{{errors.rewardKind}}</text></view>
      <view class="field" id="field-rewardText"><label for="rewardText" class="field-label">{{draft.rewardKind === 'gift' ? '参考价值（必填）' : draft.rewardKind === 'points' ? '奖励积分（必填）' : '奖励金额（必填）'}}</label><view class="reward-input"><text>{{draft.rewardKind === 'gift' ? '参考价值' : '金额'}}</text><input id="rewardText" type="{{draft.rewardKind === 'points' ? 'number' : 'digit'}}" value="{{rewardText}}" data-field="rewardText" bindinput="input" maxlength="9" placeholder="{{draft.rewardKind === 'points' ? '0' : '0.00'}}" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text>{{rewardUnit}}</text></view><text wx:if="{{errors.rewardText}}" class="field-error">{{errors.rewardText}}</text></view>
      <view class="field" id="field-frequency"><text class="field-label">重置周期</text><view class="cycle-control"><button wx:for="{{cycleOptions}}" wx:key="id" class="cycle-option {{cycleType === item.id ? 'selected' : ''}}" bindtap="selectCycle" data-id="{{item.id}}" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}">{{item.name}}</button></view>
        <view wx:if="{{cycleType && cycleType !== 'once'}}" class="cycle-panel">
          <view wx:if="{{cycleType === 'week'}}"><text class="panel-label">每周几重置</text><view class="weekdays"><button wx:for="{{weekdayOptions}}" wx:key="id" class="weekday {{cycleWeekday === item.id ? 'selected' : ''}}" bindtap="selectWeekday" data-id="{{item.id}}" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}">{{item.name}}</button></view></view>
          <view wx:if="{{cycleType === 'month' || cycleType === 'custom'}}" class="stepper-row"><text>{{cycleType === 'month' ? '每月几号重置' : '重置间隔'}}</text><view class="stepper"><button bindtap="stepCycle" data-delta="-1" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed || (cycleType === 'month' ? cycleDay <= 1 : cycleN <= 1)}}" aria-label="减少重置间隔">−</button><text>{{cycleType === 'month' ? '每月 ' + cycleDay + ' 日' : '每 ' + cycleN + ' ' + intervalLabel}}</text><button bindtap="stepCycle" data-delta="1" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed || (cycleType === 'month' ? cycleDay >= 28 : cycleN >= (cycleUnit === 'day' ? 90 : 12))}}" aria-label="增加重置间隔">+</button></view></view>
          <view wx:if="{{cycleType === 'custom'}}" class="interval-row"><text>间隔单位</text><view class="pills"><button wx:for="{{intervalOptions}}" wx:key="id" class="pill {{cycleUnit === item.id ? 'selected' : ''}}" bindtap="selectInterval" data-id="{{item.id}}" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}">{{item.name}}</button></view></view>
          <text wx:if="{{cycleType === 'custom'}}" class="cycle-anchor">{{draft.startsOn ? '从活动开始日期（' + draft.startsOn + '）起算' : '请选择活动开始日期，作为周期起算日期'}}</text><text class="cycle-preview">{{cyclePreview}}</text>
        </view>
        <text wx:elif="{{cycleType === 'once'}}" class="single-cycle-copy">活动期内参与一次，结束后不再重置。</text>
        <text wx:if="{{errors.frequency || errors.cycle}}" class="field-error">{{errors.frequency || errors.cycle}}</text>
      </view>
    </view>

    <view class="form-section rule-section section-rules" id="section-rules"><button class="rules-heading" data-section="rules" bindtap="toggleSection" aria-expanded="{{openSection === 'rules'}}"><view><text class="section-title">活动时间与完整规则</text><text class="section-copy">{{ruleSummary}}</text></view><text class="disclosure {{openSection === 'rules' ? 'expanded' : ''}}" aria-hidden="true">⌄</text></button>
      <view wx:if="{{openSection === 'rules'}}" class="rules-body">
        <view class="field"><text class="field-label">活动时间（必填）</text><view class="date-pair"><view class="date-field" id="field-startsOn"><picker mode="date" value="{{draft.startsOn}}" start="2025-01-01" end="2028-12-31" data-field="startsOn" aria-label="开始日期，{{draft.startsOn || '尚未选择'}}" bindchange="selectDate" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="date-box"><view><text class="date-label">开始日期</text><text class="date-value {{!draft.startsOn ? 'placeholder' : ''}}">{{draft.startsOn || '请选择'}}</text></view><view class="calendar-icon" /></view></picker><text wx:if="{{errors.startsOn}}" class="field-error">{{errors.startsOn}}</text></view><text class="date-to">至</text><view class="date-field" id="field-endsOn"><picker mode="date" value="{{draft.endsOn}}" start="{{draft.startsOn || '2025-01-01'}}" end="2028-12-31" data-field="endsOn" aria-label="最终结束日期，{{draft.endsOn || '尚未选择'}}" bindchange="selectDate" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="date-box"><view><text class="date-label">结束日期</text><text class="date-value {{!draft.endsOn ? 'placeholder' : ''}}">{{draft.endsOn || '请选择'}}</text></view><view class="calendar-icon" /></view></picker><text wx:if="{{errors.endsOn}}" class="field-error">{{errors.endsOn}}</text></view></view></view>
        <view class="field-pair"><view class="field" id="field-targetText"><label for="targetText" class="field-label">每期累计门槛（必填）</label><input id="targetText" type="digit" value="{{targetText}}" data-field="targetText" bindinput="input" maxlength="11" placeholder="例如：3" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.targetText}}" class="field-error">{{errors.targetText}}</text></view><view class="field unit-field" id="field-unit"><text class="field-label">单位</text><picker range="{{unitOptions}}" value="{{unitIndex}}" data-field="unit" aria-label="每期累计门槛单位，{{unitOptions[unitIndex]}}" bindchange="select" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="picker-field">{{unitOptions[unitIndex]}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.unit}}" class="field-error">{{errors.unit}}</text></view></view>
        <text class="field-hint">单次立减可填写 1 次；单笔金额限制请写在参与条件中。</text>
        <view class="field" id="field-currency"><text class="field-label">奖励币种</text><picker range="{{currencies}}" range-key="name" value="{{currencyIndex}}" data-field="currency" aria-label="奖励币种，{{currencies[currencyIndex].name}}" bindchange="select" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="picker-field">{{currencies[currencyIndex].name}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.currency}}" class="field-error">{{errors.currency}}</text></view>
        <view class="field" id="field-scope"><text class="field-label">参与名额</text><picker range="{{scopes}}" range-key="name" value="{{scopeIndex}}" data-field="scope" aria-label="参与名额，{{scopes[scopeIndex].name}}" bindchange="select" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="picker-field">{{scopes[scopeIndex].name}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.scope}}" class="field-error">{{errors.scope}}</text></view>
        <label class="switch-row"><view><text>需要银行报名</text><text class="field-hint">用户需要先在银行的活动入口报名</text></view><switch color="#1F61D8" checked="{{draft.requiresRegistration}}" data-field="requiresRegistration" bindchange="toggle" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /></label>
        <label class="switch-row"><view><text>仅限受邀用户</text><text class="field-hint">持有适用卡片不等于已获得邀请</text></view><switch color="#1F61D8" checked="{{draft.requiresInvitation}}" data-field="requiresInvitation" bindchange="toggle" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /></label>
        <button class="next-section" data-section="entrance" bindtap="toggleSection">{{readOnly || pendingCreationUnconfirmed ? '查看参与入口' : '继续完善参与入口'}}<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="form-section rule-section section-entrance" id="section-entrance"><button class="rules-heading" data-section="entrance" bindtap="toggleSection" aria-expanded="{{openSection === 'entrance'}}"><view><text class="section-title">参与入口</text><text class="section-copy">{{entranceSummary}}</text></view><text class="disclosure {{openSection === 'entrance' ? 'expanded' : ''}}" aria-hidden="true">⌄</text></button>
      <view wx:if="{{openSection === 'entrance'}}" class="rules-body">
        <view class="field" id="field-entrance-kind"><text class="field-label">入口形式</text><picker range="{{entranceKinds}}" range-key="name" value="{{entranceKindIndex}}" data-field="entrance.kind" aria-label="入口形式，{{entranceKinds[entranceKindIndex].name}}" bindchange="select" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}"><view class="picker-field">{{entranceKinds[entranceKindIndex].name}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.entrance.kind}}" class="field-error">{{errors.entrance.kind}}</text></view>
        <view class="field" id="field-entrance-label"><label for="entranceLabel" class="field-label">入口名称</label><input id="entranceLabel" value="{{draft.entrance.label}}" data-field="entrance.label" bindinput="input" maxlength="30" placeholder="例如：前往银行报名" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.entrance.label}}" class="field-error">{{errors.entrance.label}}</text></view>
        <view wx:if="{{draft.entrance.kind === 'web'}}" class="field" id="field-entrance-url"><label for="entranceUrl" class="field-label">活动入口链接（必填）</label><input id="entranceUrl" value="{{draft.entrance.url}}" data-field="entrance.url" bindinput="input" maxlength="2048" placeholder="https://" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text class="field-hint">填写实际参与地址。来源页面不一定是报名入口。</text><text wx:if="{{errors.entrance.url}}" class="field-error">{{errors.entrance.url}}</text></view>
        <block wx:if="{{draft.entrance.kind === 'miniprogram'}}">
          <view class="field" id="field-entrance-shortLink"><label for="shortLink" class="field-label">小程序短链接</label><input id="shortLink" value="{{draft.entrance.shortLink}}" data-field="entrance.shortLink" bindinput="input" maxlength="1024" placeholder="#小程序://名称/链接标识" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text class="field-hint">填写银行提供的短链接，或者填写下方 AppID 与页面路径。</text><text wx:if="{{errors.entrance.shortLink}}" class="field-error">{{errors.entrance.shortLink}}</text></view>
          <view class="field" id="field-entrance-appId"><label for="appId" class="field-label">小程序 AppID</label><input id="appId" value="{{draft.entrance.appId}}" data-field="entrance.appId" bindinput="input" maxlength="18" placeholder="wx 开头的 18 位 AppID" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.entrance.appId}}" class="field-error">{{errors.entrance.appId}}</text></view>
          <view class="field" id="field-entrance-path"><label for="entrancePath" class="field-label">页面路径（选填）</label><input id="entrancePath" value="{{draft.entrance.path}}" data-field="entrance.path" bindinput="input" maxlength="1024" placeholder="留空时打开小程序首页" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.entrance.path}}" class="field-error">{{errors.entrance.path}}</text></view>
        </block>
        <view class="field" id="field-entrance-instructions"><label for="instructions" class="field-label">操作说明或路径</label><textarea id="instructions" value="{{draft.entrance.instructions}}" data-field="entrance.instructions" bindinput="input" maxlength="1000" auto-height placeholder="例如：银行 App → 信用卡 → 优惠活动 → 活动名称" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.entrance.instructions}}" class="field-error">{{errors.entrance.instructions}}</text></view>
        <view class="field" id="field-imageIds"><view class="section-heading-copy"><text class="field-label">入口图片（{{imageRows.length}}/6，选填）</text><text class="section-copy">展示银行活动入口或操作步骤，请裁掉个人信息。</text></view><view class="screenshot-grid"><view wx:for="{{imageRows}}" wx:key="id" class="screenshot-card" bindtap="openShot" data-id="{{item.id}}" data-scope="entrance" aria-label="查看{{item.label}}"><image wx:if="{{item.url}}" class="screenshot-image" src="{{item.url}}" mode="aspectFill" /><view wx:else class="screenshot-placeholder">{{loadingImages ? '读取中' : item.label}}</view><button wx:if="{{!readOnly}}" class="shot-delete" catchtap="removeImage" data-id="{{item.id}}" aria-label="移除{{item.label}}" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed}}">×</button></view><button wx:if="{{!readOnly && imageRows.length < 6}}" class="add-screenshot" bindtap="addImage" loading="{{uploading}}" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed}}"><text class="add-sign">+</text><text>{{uploading ? '正在上传' : imageRows.length ? '继续添加' : '添加入口图片'}}</text></button></view><text wx:if="{{errors.imageIds}}" class="field-error">{{errors.imageIds}}</text></view>
        <button class="next-section" data-section="source" bindtap="toggleSection">{{readOnly || pendingCreationUnconfirmed ? '查看规则来源' : '继续核对规则来源'}}<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="form-section rule-section section-source" id="section-source"><button class="rules-heading" data-section="source" bindtap="toggleSection" aria-expanded="{{openSection === 'source'}}"><view><text class="section-title">{{reviewMode ? '来源核验与审核意见' : '规则来源'}}</text><text class="section-copy">{{sourceSummary}}</text></view><text class="disclosure {{openSection === 'source' ? 'expanded' : ''}}" aria-hidden="true">⌄</text></button>
      <view wx:if="{{openSection === 'source'}}" class="rules-body">
        <view wx:if="{{!reviewMode && sourceImageRows.length}}" class="field"><view class="section-heading-copy"><text class="field-label">线索中的原始来源图片</text><text class="section-copy">这些图片用于核实来源，确认适合公开且能说明参与步骤后，可选作参与入口。</text></view><view class="screenshot-grid"><view wx:for="{{sourceImageRows}}" wx:key="id" class="source-shot"><view class="screenshot-card" bindtap="openShot" data-id="{{item.id}}" data-scope="source" aria-label="查看{{item.label}}"><image wx:if="{{item.url}}" class="screenshot-image" src="{{item.url}}" mode="aspectFill" /><view wx:else class="screenshot-placeholder">{{loadingImages ? '读取中' : item.label}}</view></view><button wx:if="{{!readOnly}}" class="source-image-action" bindtap="useSourceImage" data-id="{{item.id}}" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed || item.used}}">{{item.used ? '已用作入口' : '用作参与入口'}}</button></view></view></view>
        <text class="field-hint">官方来源链接与出处说明至少填写一项。</text>
        <view class="field" id="field-sourceUrl"><label for="sourceUrl" class="field-label">官方来源链接</label><input id="sourceUrl" value="{{draft.sourceUrl}}" data-field="sourceUrl" bindinput="input" maxlength="2048" placeholder="https://，没有链接时填写下方出处" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.sourceUrl}}" class="field-error">{{errors.sourceUrl}}</text></view>
        <view class="field" id="field-sourceNote"><label for="sourceNote" class="field-label">出处说明</label><textarea id="sourceNote" value="{{draft.sourceNote}}" data-field="sourceNote" bindinput="input" maxlength="500" auto-height placeholder="例如：银行 App → 活动详情 → 条款与细则；请注明查阅日期。" disabled="{{readOnly || saving || reloading || pendingCreationUnconfirmed}}" /><text wx:if="{{errors.sourceNote}}" class="field-error">{{errors.sourceNote}}</text></view>
        <button wx:if="{{draft.sourceUrl || draft.sourceNote}}" class="copy-button" bindtap="copySource">复制完整来源内容</button>
        <block wx:if="{{reviewMode && !readOnly}}">
          <label class="verify-row" id="field-sourceVerified"><view><text class="verify-label">已核对来源与入口</text><text class="field-hint">确认适用卡、门槛、周期、奖励及参与入口准确后，手动勾选。</text></view><switch checked="{{sourceVerified}}" color="#1F61D8" data-field="sourceVerified" bindchange="toggle" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed}}" /></label><text wx:if="{{errors.sourceVerified}}" class="field-error">{{errors.sourceVerified}}</text>
          <view class="field" id="field-reviewNote"><label for="reviewNote" class="field-label">退回原因</label><textarea id="reviewNote" value="{{reviewNote}}" data-field="reviewNote" bindinput="input" maxlength="600" auto-height placeholder="退回时必填：说明需要投稿人补充什么。" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed}}" /><text class="field-hint">退回只发送补充意见，不会保存上方对活动内容的修改。</text><text wx:if="{{errors.reviewNote}}" class="field-error">{{errors.reviewNote}}</text></view>
        </block>
      </view>
    </view>
    <text class="privacy-copy">审核前，稿件仅对你与运营可见。发布后不会公开你的卡包、参与记录或收益。</text>
    <text wx:if="{{!readOnly && !reviewMode}}" class="draft-status">已填写 {{filledSections}} / 4 组 · {{localDraftStatus || '本机草稿不会公开'}}</text>
    </view>
  </block>
</view>
<view wx:if="{{!loading && ready && !readOnly && !denied}}" class="editor-dock">
  <button wx:if="{{!reviewMode}}" class="secondary-button" bindtap="saveLocalDraft" disabled="{{saving || uploading || reloading || pendingCreationUnconfirmed}}">保存草稿</button>
  <button wx:if="{{reviewMode}}" class="secondary-button" bindtap="returnSubmission" disabled="{{saving || uploading || reloading || conflict}}">退回补充</button>
  <button class="primary-button {{reviewMode && !publishReady ? 'not-ready' : ''}}" bindtap="save" loading="{{saving}}" disabled="{{saving || uploading || reloading || conflict || (reviewMode && !publishReady)}}">{{saving ? '正在提交' : pendingCreationUnconfirmed ? '重试确认提交' : reviewMode ? '发布' : '提交审核'}}</button>
</view>
<screenshot-viewer id="editor-viewer" show="{{viewerShow}}" items="{{viewerItems}}" index="{{viewerIndex}}" context="review" bindclose="closeViewer" bindcopy="copyViewerSource" />
