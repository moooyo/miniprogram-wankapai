<view class="editor-page {{!readOnly && !denied ? 'with-dock' : ''}}">
  <view wx:if="{{loading}}" class="loading">正在读取稿件…</view>
  <view wx:elif="{{denied}}" class="empty"><text class="empty-title">此账号没有审核权限</text><text class="small-copy">请使用已获授权的运营账号。</text><button class="text-button" bindtap="goBack">返回</button></view>
  <view wx:elif="{{!ready}}" class="empty"><text class="empty-title">稿件未能读取</text><text class="small-copy">{{error}}</text><button class="text-button" bindtap="load">重新读取</button></view>
  <block wx:else>
    <view class="editor-intro"><text class="editor-title">{{reviewMode ? (readOnly ? '处理结果' : '核实活动') : (readOnly ? '投稿详情' : submissionId ? '修改投稿' : '分享活动')}}</text><text class="small-copy">{{readOnly ? '处理后的稿件保留只读记录。' : reviewMode ? '核对规则与参与入口，可直接修订后发布。' : '填写活动规则和出处，审核通过后公开。'}}</text></view>
    <view wx:if="{{submission.status === 'returned'}}" class="return-notice"><text class="notice-title">{{reviewMode ? '已退回补充' : '请补充这些信息'}}</text><text>{{submission.reviewNote}}</text></view>
    <view wx:if="{{submission.status === 'published'}}" class="published-notice"><text>已审核发布</text><button wx:if="{{submission.activityId}}" class="text-button" bindtap="viewActivity">查看公开活动</button></view>
    <view wx:if="{{error || conflict}}" class="error-banner"><text>{{error || '稿件已有更新，请读取最新版本。'}}</text><button wx:if="{{conflict}}" class="text-button" bindtap="reloadLatest">读取最新稿件</button><button wx:elif="{{!draft.title && submissionId}}" class="text-button" bindtap="load">重新读取</button></view>

    <view class="form-section" id="section-basic">
      <button class="section-heading" data-section="basic" bindtap="toggleSection" aria-expanded="{{openSection === 'basic'}}"><view><text class="section-title">基本信息</text><text class="section-summary">{{bankSummary}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'basic' ? '−' : '+'}}</text></button>
      <view wx:if="{{openSection === 'basic'}}" class="section-body">
        <view class="field"><label for="title" class="field-label">活动标题</label><input id="title" value="{{draft.title}}" data-field="title" bindinput="input" maxlength="60" placeholder="例如：周末餐饮消费返现" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.title}}" class="field-error">{{errors.title}}</text></view>
        <view class="field"><text class="field-label">银行</text><picker range="{{bankOptions}}" range-key="name" value="{{bankIndex}}" data-field="bankId" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field {{!draft.bankId ? 'placeholder' : ''}}">{{bankOptions[bankIndex].name}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.bankId}}" class="field-error">{{errors.bankId}}</text></view>
        <view wx:if="{{issuerOptions.length}}" class="field"><text class="field-label">适用发卡机构</text><checkbox-group bindchange="selectIssuers"><label wx:for="{{issuerOptions}}" wx:key="id" class="check-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#165dcc" disabled="{{readOnly || saving}}" /><text>{{item.name}}</text></label></checkbox-group><text class="field-hint">同一家银行的不同发卡机构，活动资格可能不同。</text><text wx:if="{{errors.issuerIds}}" class="field-error">{{errors.issuerIds}}</text></view>
        <view class="field"><text class="field-label">卡片类型</text><picker range="{{cardKinds}}" range-key="name" value="{{cardKindIndex}}" data-field="cardKind" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{cardKinds[cardKindIndex].name}}<text aria-hidden="true">⌄</text></view></picker></view>
        <view class="field"><text class="field-label">卡组织</text><text class="field-hint">不勾选表示不限卡组织。</text><checkbox-group class="network-options" bindchange="selectNetworks"><label wx:for="{{networkOptions}}" wx:key="id" class="check-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#165dcc" disabled="{{readOnly || saving}}" /><text>{{item.name}}</text></label></checkbox-group></view>
        <view class="field"><label for="cardDescription" class="field-label">适用卡片说明</label><input id="cardDescription" value="{{draft.cardDescription}}" data-field="cardDescription" bindinput="input" maxlength="200" placeholder="例如：指定 Visa 信用卡，附属卡除外" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.cardDescription}}" class="field-error">{{errors.cardDescription}}</text></view>
        <view class="field"><label for="conditions" class="field-label">参与条件</label><textarea id="conditions" value="{{draft.conditions}}" data-field="conditions" bindinput="input" maxlength="2000" auto-height placeholder="说明消费要求、适用商户、报名方式、奖励上限和到账时间。" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.conditions}}" class="field-error">{{errors.conditions}}</text></view>
        <button class="next-section" data-section="rules" bindtap="toggleSection">{{readOnly ? '查看活动规则' : '继续填写活动规则'}}<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="form-section" id="section-rules">
      <button class="section-heading" data-section="rules" bindtap="toggleSection" aria-expanded="{{openSection === 'rules'}}"><view><text class="section-title">活动规则</text><text class="section-summary">{{ruleSummary}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'rules' ? '−' : '+'}}</text></button>
      <view wx:if="{{openSection === 'rules'}}" class="section-body">
        <view class="field"><text class="field-label">活动周期</text><picker range="{{frequencies}}" range-key="name" value="{{frequencyIndex}}" data-field="frequency" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{frequencies[frequencyIndex].name}}<text aria-hidden="true">⌄</text></view></picker><text class="field-hint">每个周期单独记录，上一期的进度和收益会保留。</text></view>
        <view class="field-pair"><view class="field"><text class="field-label">开始日期</text><picker mode="date" value="{{draft.startsOn}}" data-field="startsOn" bindchange="selectDate" disabled="{{readOnly || saving}}"><view class="picker-field">{{draft.startsOn || '选择日期'}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.startsOn}}" class="field-error">{{errors.startsOn}}</text></view><view class="field"><text class="field-label">最终结束日期</text><picker mode="date" value="{{draft.endsOn}}" start="{{draft.startsOn}}" data-field="endsOn" bindchange="selectDate" disabled="{{readOnly || saving}}"><view class="picker-field {{!draft.endsOn ? 'placeholder' : ''}}">{{draft.endsOn || '选择日期'}}<text aria-hidden="true">⌄</text></view></picker><text wx:if="{{errors.endsOn}}" class="field-error">{{errors.endsOn}}</text></view></view>
        <view class="field-pair"><view class="field"><label for="targetText" class="field-label">每期累计门槛</label><input id="targetText" type="digit" value="{{targetText}}" data-field="targetText" bindinput="input" maxlength="11" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.targetText}}" class="field-error">{{errors.targetText}}</text></view><view class="field"><text class="field-label">单位</text><picker range="{{unitOptions}}" value="{{unitIndex}}" data-field="unit" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{unitOptions[unitIndex]}}<text aria-hidden="true">⌄</text></view></picker></view></view>
        <text class="field-hint standalone-hint">单次立减可以填写 1 次；单笔金额限制请写在参与条件里。</text>
        <view class="field"><text class="field-label">奖励类型</text><picker range="{{rewardKinds}}" range-key="name" value="{{rewardKindIndex}}" data-field="rewardKind" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{rewardKinds[rewardKindIndex].name}}<text aria-hidden="true">⌄</text></view></picker></view>
        <view class="field-pair"><view class="field"><label for="rewardText" class="field-label">预计奖励金额</label><input id="rewardText" type="digit" value="{{rewardText}}" data-field="rewardText" bindinput="input" maxlength="11" placeholder="0.00" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.rewardText}}" class="field-error">{{errors.rewardText}}</text></view><view class="field"><text class="field-label">奖励币种</text><picker range="{{currencies}}" range-key="name" value="{{currencyIndex}}" data-field="currency" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{currencies[currencyIndex].name}}<text aria-hidden="true">⌄</text></view></picker></view></view>
        <view class="field"><text class="field-label">参与名额</text><picker range="{{scopes}}" range-key="name" value="{{scopeIndex}}" data-field="scope" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{scopes[scopeIndex].name}}<text aria-hidden="true">⌄</text></view></picker></view>
        <label class="switch-row"><view><text>需要银行报名</text><text class="field-hint">用户需要先在银行的活动入口报名</text></view><switch color="#165dcc" checked="{{draft.requiresRegistration}}" data-field="requiresRegistration" bindchange="toggle" disabled="{{readOnly || saving}}" /></label>
        <label class="switch-row"><view><text>仅限受邀用户</text><text class="field-hint">持有适用卡片不等于已获得邀请</text></view><switch color="#165dcc" checked="{{draft.requiresInvitation}}" data-field="requiresInvitation" bindchange="toggle" disabled="{{readOnly || saving}}" /></label>
        <button class="next-section" data-section="entrance" bindtap="toggleSection">{{readOnly ? '查看参与入口' : '继续填写参与入口'}}<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="form-section" id="section-entrance">
      <button class="section-heading" data-section="entrance" bindtap="toggleSection" aria-expanded="{{openSection === 'entrance'}}"><view><text class="section-title">参与入口</text><text class="section-summary">{{entranceSummary}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'entrance' ? '−' : '+'}}</text></button>
      <view wx:if="{{openSection === 'entrance'}}" class="section-body">
        <view class="field"><text class="field-label">入口形式</text><picker range="{{entranceKinds}}" range-key="name" value="{{entranceKindIndex}}" data-field="entrance.kind" bindchange="select" disabled="{{readOnly || saving}}"><view class="picker-field">{{entranceKinds[entranceKindIndex].name}}<text aria-hidden="true">⌄</text></view></picker></view>
        <view class="field"><label for="entranceLabel" class="field-label">入口名称</label><input id="entranceLabel" value="{{draft.entrance.label}}" data-field="entrance.label" bindinput="input" maxlength="30" placeholder="例如：前往银行报名" disabled="{{readOnly || saving}}" /></view>
        <view wx:if="{{draft.entrance.kind === 'web'}}" class="field"><label for="entranceUrl" class="field-label">活动入口链接</label><input id="entranceUrl" value="{{draft.entrance.url}}" data-field="entrance.url" bindinput="input" maxlength="2048" placeholder="https://" disabled="{{readOnly || saving}}" /><text class="field-hint">填写实际参与地址。来源页面不一定是报名入口。</text><text wx:if="{{errors.entrance.url}}" class="field-error">{{errors.entrance.url}}</text></view>
        <block wx:if="{{draft.entrance.kind === 'miniprogram'}}">
          <view class="field"><label for="shortLink" class="field-label">小程序短链接</label><input id="shortLink" value="{{draft.entrance.shortLink}}" data-field="entrance.shortLink" bindinput="input" maxlength="1024" placeholder="#小程序://名称/链接标识" disabled="{{readOnly || saving}}" /><text class="field-hint">填写银行提供的短链接，或者填写下方 AppID 与页面路径。</text><text wx:if="{{errors.entrance.shortLink}}" class="field-error">{{errors.entrance.shortLink}}</text></view>
          <view class="field"><label for="appId" class="field-label">小程序 AppID</label><input id="appId" value="{{draft.entrance.appId}}" data-field="entrance.appId" bindinput="input" maxlength="18" placeholder="wx 开头的 18 位 AppID" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.entrance.appId}}" class="field-error">{{errors.entrance.appId}}</text></view>
          <view class="field"><label for="entrancePath" class="field-label">页面路径（选填）</label><input id="entrancePath" value="{{draft.entrance.path}}" data-field="entrance.path" bindinput="input" maxlength="1024" placeholder="留空时打开小程序首页" disabled="{{readOnly || saving}}" /></view>
        </block>
        <view class="field"><label for="instructions" class="field-label">操作说明或路径</label><textarea id="instructions" value="{{draft.entrance.instructions}}" data-field="entrance.instructions" bindinput="input" maxlength="1000" auto-height placeholder="例如：银行 App → 信用卡 → 优惠活动 → 活动名称" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.entrance.instructions}}" class="field-error">{{errors.entrance.instructions}}</text></view>
        <view class="field"><text class="field-label">入口图片（选填）</text><text class="field-hint">展示银行活动入口或操作步骤；请裁掉个人信息。</text><view wx:for="{{imageRows}}" wx:key="id" class="image-row"><button class="image-preview" bindtap="previewImage" data-id="{{item.id}}" disabled="{{loadingImages}}"><image wx:if="{{item.url}}" class="image-thumbnail" src="{{item.url}}" mode="aspectFill" aria-label="{{item.label}}" /><text class="image-label">{{item.label}}</text><text class="image-status">{{loadingImages ? '读取中' : '查看'}}</text></button><button wx:if="{{!readOnly}}" class="remove-image" bindtap="removeImage" data-id="{{item.id}}" disabled="{{saving}}">移除</button></view><button wx:if="{{!readOnly && imageRows.length < 6}}" class="upload-button" bindtap="addImage" loading="{{uploading}}" disabled="{{saving || uploading}}">{{uploading ? '正在上传' : '添加入口图片'}}</button><text wx:if="{{errors.imageIds}}" class="field-error">{{errors.imageIds}}</text></view>
        <button class="next-section" data-section="source" bindtap="toggleSection">{{readOnly ? '查看规则来源' : '继续填写规则来源'}}<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="form-section" id="section-source">
      <button class="section-heading" data-section="source" bindtap="toggleSection" aria-expanded="{{openSection === 'source'}}"><view><text class="section-title">规则来源</text><text class="section-summary">{{sourceSummary}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'source' ? '−' : '+'}}</text></button>
      <view wx:if="{{openSection === 'source'}}" class="section-body">
        <view class="field"><label for="sourceUrl" class="field-label">官方来源链接</label><input id="sourceUrl" value="{{draft.sourceUrl}}" data-field="sourceUrl" bindinput="input" maxlength="2048" placeholder="https://，没有链接时填写下方出处" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.sourceUrl}}" class="field-error">{{errors.sourceUrl}}</text></view>
        <view class="field"><label for="sourceNote" class="field-label">出处说明</label><textarea id="sourceNote" value="{{draft.sourceNote}}" data-field="sourceNote" bindinput="input" maxlength="500" auto-height placeholder="例如：银行 App → 活动详情 → 条款与细则；请注明查阅日期。" disabled="{{readOnly || saving}}" /><text wx:if="{{errors.sourceNote}}" class="field-error">{{errors.sourceNote}}</text></view>
        <button wx:if="{{draft.sourceUrl || draft.sourceNote}}" class="copy-button" bindtap="copySource">复制来源{{draft.sourceUrl ? '链接' : '说明'}}</button>
        <block wx:if="{{reviewMode && !readOnly}}">
          <label class="verify-row"><view><text class="verify-label">已核对来源与入口</text><text class="field-hint">已确认适用卡、门槛、周期、奖励，以及参与入口的准确性。</text></view><switch checked="{{sourceVerified}}" color="#165dcc" data-field="sourceVerified" bindchange="toggle" disabled="{{saving}}" /></label><text wx:if="{{errors.sourceVerified}}" class="field-error">{{errors.sourceVerified}}</text>
          <view class="field"><label for="reviewNote" class="field-label">退回原因</label><textarea id="reviewNote" value="{{reviewNote}}" data-field="reviewNote" bindinput="input" maxlength="600" auto-height placeholder="仅退回时必填：说明需要投稿人补充什么。" disabled="{{saving}}" /><text wx:if="{{errors.reviewNote}}" class="field-error">{{errors.reviewNote}}</text></view>
        </block>
        <text class="field-hint">审核前，稿件仅对你与运营可见。发布后不会公开你的卡包、参与记录或收益。</text>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{!loading && ready && !readOnly && !denied}}" class="editor-dock">
  <button wx:if="{{reviewMode}}" class="secondary-button" bindtap="returnSubmission" disabled="{{saving || uploading || conflict}}">退回补充</button>
  <button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving || uploading || conflict}}">{{saving ? '正在提交' : reviewMode ? '审核通过并发布' : '提交审核'}}</button>
</view>
