<view class="entry-page">
  <view wx:if="{{loading}}" class="entry-state" role="status">正在读取进度…</view>
  <view wx:elif="{{loadError}}" class="entry-state">
    <view class="entry-error">{{loadError}}</view>
    <button class="entry-secondary" bindtap="load">重新加载</button>
  </view>
  <block wx:else>
    <view class="entry-context">
      <text class="entry-eyebrow">{{periodText}}</text>
      <view class="entry-title">{{title}}</view>
    </view>
    <view wx:if="{{!editable}}" class="entry-notice">这期记录已归档为完成、到账或不参与。如需更正，请先返回详情调整状态。</view>
    <view class="entry-field">
      <label class="entry-label" for="progress">当前累计</label>
      <view class="entry-input-line {{progressError ? 'entry-input-invalid' : ''}}">
        <input id="progress" class="entry-amount" type="digit" value="{{progressInput}}" bindinput="onProgressInput" disabled="{{busy || !editable}}" maxlength="16" aria-label="当前累计进度" placeholder="0" adjust-position="{{true}}" />
        <text class="entry-unit">{{unit}}</text>
      </view>
      <view wx:if="{{progressError}}" class="entry-error" role="alert">{{progressError}}</view>
      <view class="entry-hint">本期目标 {{target}} {{unit}}</view>
    </view>
    <checkbox-group wx:if="{{showRegistration}}" bindchange="onRegistrationChange" class="entry-registration">
      <label class="entry-check-label">
        <checkbox value="registered" checked="{{registered}}" disabled="{{busy || !editable}}" color="#1768df" />
        <view>
          <view>已完成银行报名</view>
          <view class="entry-hint">如活动需要报名，可在这里记录</view>
        </view>
      </label>
    </checkbox-group>
    <view class="entry-explanation">保存进度后，可在活动详情直接标记完成或确认到账。</view>
    <view wx:if="{{formError}}" class="entry-form-error" role="alert">{{formError}}</view>
    <view class="entry-actions">
      <button class="entry-secondary" bindtap="back" disabled="{{busy}}">取消</button>
      <button class="entry-primary" bindtap="save" loading="{{busy}}" disabled="{{busy || !editable}}">{{busy ? '正在保存' : '保存进度'}}</button>
    </view>
  </block>
</view>
