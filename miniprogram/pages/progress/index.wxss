.entry-page { padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); color: var(--text, #172438); background: var(--surface, #fff); min-height: 100vh; box-sizing: border-box; }
.entry-context { padding: 8rpx 0 40rpx; border-bottom: 1rpx solid var(--border, #e2e7ee); }
.entry-eyebrow { color: var(--muted, #657184); font-size: 26rpx; line-height: 1.5; }
.entry-title { margin-top: 12rpx; font-size: 40rpx; font-weight: 600; line-height: 1.45; }
.entry-card { margin-top: 16rpx; color: var(--muted, #657184); font-size: 26rpx; line-height: 1.6; }
.entry-field { padding: 40rpx 0 24rpx; }
.entry-label { display: block; font-size: 30rpx; font-weight: 500; line-height: 1.5; }
.entry-input-line { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid var(--control, #8a97a8); }
.entry-input-invalid { border-color: var(--danger, #b52631); }
.entry-amount { flex: 1; min-width: 0; height: 48px; font-size: 64rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.entry-unit { color: var(--muted, #657184); font-size: 30rpx; max-width: 140rpx; }
.entry-hint { margin-top: 12rpx; color: var(--muted, #657184); font-size: 26rpx; line-height: 1.6; }
.entry-registration { padding: 16rpx 0; }
.entry-check-label { min-height: 48px; display: flex; align-items: center; gap: 16rpx; font-size: 30rpx; line-height: 1.5; }
.entry-check-label .entry-hint { margin-top: 4rpx; }
.entry-explanation { margin-top: 24rpx; color: var(--muted, #657184); font-size: 26rpx; line-height: 1.7; }
.entry-actions { display: flex; gap: 16rpx; margin-top: 48rpx; }
.entry-primary, .entry-secondary { margin: 0; padding: 16rpx 24rpx; min-height: 48px; border-radius: 12rpx; font-size: 30rpx; line-height: 1.8; box-sizing: border-box; }
.entry-primary { flex: 1.7; color: #fff; background: var(--primary, #1768df); }
.entry-secondary { flex: 1; color: var(--text, #172438); background: var(--surface, #fff); border: 1rpx solid var(--control, #8a97a8); }
.entry-primary::after, .entry-secondary::after { border: 0; }
.entry-primary[disabled] { color: #fff; background: #647d9f; }
.entry-error, .entry-form-error { margin-top: 12rpx; color: var(--danger, #b52631); font-size: 26rpx; line-height: 1.6; }
.entry-form-error { margin-top: 24rpx; }
.entry-state { padding-top: 64rpx; text-align: center; color: var(--muted, #657184); font-size: 30rpx; }
.entry-state .entry-secondary { margin-top: 32rpx; }
.entry-notice { margin-top: 24rpx; padding: 24rpx; background: var(--surface-soft, #f0f5fb); font-size: 28rpx; line-height: 1.7; }
