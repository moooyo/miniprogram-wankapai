<design-nav title="活动详情" back custom-back="{{true}}" bindback="back"/>
<view class="detail-page" aria-hidden="{{showManage || showRules || showCards || showExpected || showGuide || showQuit || showConsumption || showConsumptionRecord || showCelebration || viewerOpen}}">
  <view wx:if="{{preparingCards}}" class="refresh-notice" role="status"><text>正在读取卡包。查看指引或规则会取消本次选卡。</text><button class="text-button" bindtap="cancelCardSelection">取消选卡</button></view>
  <view wx:if="{{refreshing || refreshError}}" class="refresh-notice" role="status"><text>{{refreshing ? mutationNotice + '正在更新活动记录…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="retry" disabled="{{busy || expectedClosing}}">重新刷新</button></view>
  <view wx:if="{{loading && !detail}}" class="state-block">正在加载活动…</view>
  <view wx:elif="{{error && !detail}}" class="state-block" role="alert"><text>{{error}}</text><button class="button secondary" bindtap="retry">重新加载</button><button class="text-button" bindtap="back">返回活动列表</button></view>
  <block wx:elif="{{detail && view}}">
    <view class="activity-summary">
      <view class="summary-top"><image class="bank-logo" src="{{view.logo}}" mode="aspectFit" aria-hidden="true"/><text class="bank-name">{{view.bankName}} · {{selectedCardName || view.activity.cardDescription}}</text><view class="cycle-chip {{view.cycle.repeating ? 'is-repeating' : ''}}"><text wx:if="{{view.cycle.repeating}}" class="cycle-symbol">↻</text><text>{{view.frequencyLabel}}</text></view></view>
      <text class="activity-title">{{view.activity.title}}</text><view class="summary-reward"><text class="reward-value">{{view.reward}}</text><text>{{view.rewardKindLabel}}</text></view>
      <view wx:if="{{view.joined}}" class="summary-progress"><view class="progress-heading"><text>{{view.progressHint}}</text><text class="progress-number">{{view.progressText}} {{view.activity.unit}}</text></view><view wx:if="{{view.segmented}}" class="progress-segments"><view wx:for="{{view.segments}}" wx:key="id" class="{{item.filled ? 'is-filled' : ''}}"/></view><view wx:else class="progress-track"><view style="width:{{view.progressPercent}}%;"/></view><view class="due-line"><text class="clock-symbol">◷</text><text>{{view.dueLine}}</text></view></view>
      <view wx:else class="eligibility-section"><view class="eligibility {{view.canJoin ? 'can-join' : ''}}"><view class="eligibility-dot">{{view.canJoin ? '✓' : '×'}}</view><view><text class="eligibility-title">{{view.withdrawn && !detail.eligible ? '原有参与记录已保留' : view.eligibilityTitle}}</text><text class="eligibility-help">{{view.eligibilitySubtitle}}</text></view></view><text wx:if="{{view.activity.requiresInvitation}}" class="qualification">仅限受邀用户，请核对资格</text></view>
      <text wx:if="{{view.isPast}}" class="past-note">正在查看历史参与期，修改只影响这一期。</text>
    </view>
    <view wx:if="{{view.joined}}" class="stepper"><view wx:for="{{view.steps}}" wx:key="id" class="step {{item.current ? 'is-current' : ''}} {{item.done ? 'is-done' : ''}}"><view wx:if="{{index}}" class="step-line {{item.lineFilled ? 'is-filled' : ''}}"/><view class="step-dot">{{item.done ? '✓' : item.number}}</view><text class="step-label">{{item.label}}</text><text class="step-sub">{{item.sub}}</text></view></view>
    <view class="section-heading"><text class="section-title">活动截图</text><text class="section-count">{{view.shots.length ? view.shots.length + ' 张' : ''}}</text><button wx:if="{{view.shots.length}}" class="text-button" bindtap="uploadShot">上传截图</button></view>
    <scroll-view wx:if="{{view.shots.length}}" scroll-x enhanced show-scrollbar="{{false}}" enable-flex class="screenshot-rail"><view class="screenshot-items"><button wx:for="{{view.shots}}" wx:key="id" class="screenshot-card" data-id="{{item.id}}" bindtap="openShot"><view class="screenshot-image"><image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill"/><text wx:else>截图暂未加载</text></view><view class="screenshot-caption"><text>{{item.label}}</text><text>{{item.uploader}}{{item.uploadedOn ? ' · ' + item.uploadedOn : ''}}</text></view></button></view></scroll-view>
    <view wx:else class="screenshots-empty"><text>暂无活动截图。如有活动页截图，可上传供其他用户核对规则。</text><button bindtap="uploadShot">上传截图</button></view>
    <view class="cycle-panel"><view class="cycle-heading"><text class="section-title">活动周期</text><text class="cycle-kind {{view.cycle.repeating ? 'is-repeating' : ''}}">{{view.cycle.kindLine}}</text></view><text class="cycle-description">{{view.cycle.description}}</text>
      <view wx:if="{{view.cycle.isWeek}}" class="week-grid"><view wx:for="{{view.cycle.days}}" wx:key="date" class="week-day {{item.today ? 'is-today' : ''}} {{item.past ? 'is-past' : ''}} {{item.usable ? 'is-usable' : ''}}"><text class="weekday">{{item.weekday}}</text><text class="week-date">{{item.day}}</text><text class="week-tag">{{item.label}}</text></view></view>
      <view wx:else class="cycle-timeline"><view class="today-label-row {{!view.cycle.isOnce ? 'is-recurring' : ''}}"><text wx:if="{{view.cycle.showToday}}" style="left:{{view.cycle.todayPercent}}%;">{{view.cycle.todayLabel}}</text></view><view class="timeline-row"><view wx:if="{{!view.cycle.isOnce}}" class="timeline-previous">上期</view><view class="timeline-current {{view.cycle.isOnce ? 'is-once' : ''}}"><view class="timeline-fill" style="width:{{view.cycle.percent}}%;"/><view wx:if="{{view.cycle.showToday}}" class="today-marker" style="left:{{view.cycle.percent}}%;"/><text>{{view.cycle.isOnce ? '单次' : '本期'}}</text><text>{{view.cycle.currentLabel}}</text></view><view wx:if="{{!view.cycle.isOnce}}" class="timeline-next">下期</view></view><view class="timeline-ticks"><text wx:if="{{!view.cycle.isOnce}}" class="previous-tick">{{view.cycle.previousTick}}</text><view><text>{{view.cycle.startTick}}{{view.cycle.isOnce ? ' 开始' : ''}}</text><text>{{view.cycle.endTick}}{{view.cycle.isOnce ? ' 结束' : ''}}</text></view><text wx:if="{{!view.cycle.isOnce}}" class="next-tick">{{view.cycle.nextTick}}</text></view></view>
      <view class="cycle-footnote"><text class="footnote-symbol">{{view.cycle.repeating ? '↻' : '◷'}}</text><text>{{view.cycle.foot}}</text></view>
    </view>
    <block wx:if="{{detail.participation}}">
      <view class="section-heading"><text class="section-title">我的记录</text><text class="section-count">{{view.consumptionCount}} 笔</text><button class="text-button" bindtap="openHistory">全部参与记录 ›</button></view>
      <view class="consumption-records"><button wx:for="{{view.consumptions}}" wx:key="id" class="consumption-row {{item.reversed ? 'is-reversed' : ''}}" data-id="{{item.id}}" bindtap="openConsumptionRecord"><text class="consumption-row-date">{{item.date}}</text><view class="consumption-row-merchant"><text>{{item.merchant}}</text><text wx:if="{{item.reversed}}" class="consumption-row-status">已撤销</text></view><text class="consumption-row-amount">{{item.amount}}</text></button><text wx:if="{{!view.consumptions.length}}" class="consumption-empty">暂无消费记录</text></view>
      <button wx:if="{{detail.participation.stage === 'completed' && !view.benefit.isDiscount && !view.withdrawn}}" class="date-setting" bindtap="openExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><text>{{detail.participation.expectedOn ? '预计 ' + detail.participation.expectedOn + ' 到账' : '设置预计到账日'}}</text><text>›</text></button>
      <view wx:if="{{consumptionPending || consumptionRevokePending}}" class="refresh-notice"><text>上次操作结果尚未确认，原记录已保留。</text><button wx:if="{{consumptionPending}}" class="text-button" bindtap="openConsumption" disabled="{{busy}}">核对消费保存结果</button><button wx:else class="text-button" bindtap="retryConsumptionRevoke" disabled="{{busy}}">核对撤销结果</button></view>
    </block>
    <view class="section-heading"><text class="section-title">规则与入口</text><button class="text-button" bindtap="openRules">完整规则</button></view><view class="rules-panel"><view class="rule-row"><text>条件</text><text>{{view.activity.conditions}}</text></view><view class="rule-row"><text>时间</text><text>{{view.periodDescription}}</text></view><view class="rule-row"><text>用卡</text><text>{{selectedCardName || view.activity.cardDescription}}</text></view><view class="rule-row"><text>入口</text><text>{{view.activity.entrance.instructions || view.activity.entrance.label || '请核对银行官方活动规则'}}</text><button class="text-button" bindtap="copyEntry">复制</button></view></view>
    <view class="detail-links"><button class="text-button" bindtap="entrance">{{view.entryAction}}</button><button class="text-button" bindtap="openManage" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">更多操作</button><button wx:if="{{detail.participation || detail.history.length}}" class="text-button" bindtap="openHistory">参与记录</button></view>
    <text wx:if="{{reminderReady && (detail.participation.stage === 'completed' || !view.deadlineReminderExpired)}}" class="rules-note">已核对提醒偏好，请点击下方按钮申请本期微信授权。下一期需重新授权。</text><text wx:if="{{view.joined && !view.finished && detail.participation.stage !== 'skipped' && view.deadlineReminderExpired}}" class="rules-note deadline-reminder-expired">已过截止日，不补发微信提醒。记录仍会保留，可补填本期进度和结果。</text>
    <button wx:if="{{view.joined && !view.finished && detail.participation.stage !== 'skipped' && !view.deadlineReminderExpired}}" class="reminder-link" bindtap="reminder" loading="{{reminderChecking}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{reminderChecking ? '正在核对提醒设置…' : reminderReady ? '申请本期微信授权' : '开启本期截止提醒'}}</button><button wx:if="{{view.joined && detail.participation.stage === 'completed' && detail.participation.expectedOn && !view.benefit.isDiscount}}" class="reminder-link" bindtap="reminder" loading="{{reminderChecking}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{reminderChecking ? '正在核对提醒设置…' : reminderReady ? '申请本期微信授权' : '开启预计到账提醒'}}</button>
    <view wx:if="{{reminderError}}" class="refresh-notice" role="alert"><text>{{reminderError}}</text><button class="text-button" bindtap="reminder" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">重试提醒设置</button></view>
    <button wx:if="{{view.joined}}" class="quit-button" bindtap="openQuit" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><text>退出活动</text><text>停止跟进与提醒，已有记录将保留</text></button><text class="source-note">以银行官方规则为准 · 最近核对：{{view.lastChecked}}</text>
  </block>
</view>
<view wx:if="{{detail && view}}" class="detail-bottom-bar" aria-hidden="{{showManage || showRules || showCards || showExpected || showGuide || showQuit || showConsumption || showConsumptionRecord || showCelebration || viewerOpen}}"><button wx:if="{{view.primaryUiAction !== 'disabled' && view.primaryUiAction !== 'done'}}" class="button secondary copy-entry" bindtap="copyEntry">复制入口</button>
  <button wx:if="{{view.primaryUiAction === 'join' || view.primaryUiAction === 'rejoin'}}" class="button primary detail-primary" bindtap="join" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}" loading="{{busy}}">{{view.primaryUiLabel}}</button><button wx:elif="{{view.primaryUiAction === 'register'}}" class="button primary detail-primary registration-button" bindtap="register" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryUiLabel}}</button><button wx:elif="{{view.primaryUiAction === 'consumption'}}" class="button primary detail-primary" bindtap="openConsumption" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryUiLabel}}</button><button wx:elif="{{view.primaryUiAction === 'progress'}}" class="button primary detail-primary" bindtap="editProgress" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryUiLabel}}</button><button wx:elif="{{view.primaryUiAction === 'complete'}}" class="button primary detail-primary" bindtap="complete" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}" loading="{{busy}}">{{view.primaryUiLabel}}</button><button wx:elif="{{view.primaryUiAction === 'resume'}}" class="button primary detail-primary" bindtap="resume" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryUiLabel}}</button><button wx:elif="{{view.primaryUiAction === 'receipt'}}" class="button primary detail-primary receipt-button" bindtap="receipt" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryUiLabel}}</button><button wx:else class="button detail-primary completed-button {{view.primaryUiAction === 'disabled' ? 'unavailable-button' : ''}}" disabled>{{view.primaryUiLabel}}</button>
</view>
<app-sheet id="detail-card-picker" show="{{showCards}}" title="选择参加的卡片" content-state="{{[cards, matchingCardCount, cardSelectionError, selectedCardId]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeCards">
  <text class="sheet-caption">这个活动按卡计算。请选择实际使用、且符合当前条件的卡片：{{cardRequirement}}。</text>
  <view class="card-options"><button wx:for="{{cards}}" wx:key="id" class="card-option {{selectedCardId === item.id ? 'is-selected' : ''}} {{!item.matches ? 'is-unavailable' : ''}}" data-id="{{item.id}}" bindtap="chooseCard" disabled="{{!item.matches || loading || refreshing || outdated || busy || expectedClosing}}" aria-pressed="{{selectedCardId === item.id}}"><view class="card-option-text"><text class="card-option-title">{{item.name}}</text><text class="card-option-description">{{item.issuer}}</text><text class="card-qualification">{{item.qualification}}</text></view><text class="selection-mark">{{selectedCardId === item.id ? '✓' : ''}}</text></button></view>
  <text wx:if="{{!cards.length}}" class="sheet-caption">卡包里还没有这家银行的卡片，请先添加。</text>
  <text wx:elif="{{!matchingCardCount}}" class="sheet-caption">现有卡片均不符合条件。请添加符合条件的卡片后继续。</text>
  <text wx:if="{{cardSelectionError}}" class="field-error">{{cardSelectionError}}</text>
  <text class="sheet-caption">参加后可随时在活动详情中退出</text>
  <button wx:if="{{matchingCardCount}}" class="button primary sheet-confirm" bindtap="confirmCard" disabled="{{!selectedCardId || loading || refreshing || outdated || busy || expectedClosing}}">{{pendingAction === 'join' ? '加入进度' : pendingAction === 'complete' ? '标记完成' : view.benefit.recordAction}}</button>
  <button class="text-button sheet-wide" bindtap="addCard" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">添加符合条件的卡片</button>
</app-sheet>

<app-sheet id="detail-rules" show="{{showRules}}" title="活动规则" content-state="{{[view]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeRules">
  <view class="full-rules"><text class="rule-title">{{view.activity.title}}</text><text class="rule-label">适用卡片</text><text>{{view.activity.cardDescription}}</text><text class="rule-label">发卡机构</text><text>{{view.issuerNames}}</text><text class="rule-label">参与要求</text><text>{{view.activity.conditions}}</text><text class="rule-label">活动时间</text><text>{{view.activity.startsOn}} 至 {{view.activity.endsOn}}</text><text class="rule-label">次数与周期</text><text>{{view.frequencyLabel}} · {{view.activity.scope === 'card' ? '每张卡单独计算' : '每位用户计算'}}</text><text class="rule-label">规则来源</text><text>{{view.activity.sourceNote || '以银行官方活动规则为准'}}</text><button wx:if="{{view.activity.sourceUrl}}" class="button secondary" bindtap="source">{{view.sourceAction}}</button></view>
</app-sheet>

<app-sheet id="detail-guide" show="{{showGuide}}" title="参与指引" content-state="{{[view]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeGuide">
  <text class="guide-instructions">{{view.activity.entrance.instructions}}</text>
  <view wx:for="{{view.entryImages}}" wx:key="id" class="guide-item"><button class="guide-image-button" bindtap="previewImage" data-id="{{item.id}}" aria-label="{{item.url ? '放大查看' : '重新加载'}}第 {{index + 1}} 张入口截图"><image wx:if="{{item.url}}" src="{{item.url}}" mode="widthFix" class="guide-image"/><text wx:else class="sheet-caption">第 {{index + 1}} 张截图暂未加载，点击重试</text></button><text wx:if="{{item.url}}" class="sheet-caption">点击图片可放大查看</text></view>
  <text wx:if="{{!view.entryImages.length}}" class="sheet-caption">这项活动暂未提供入口截图，可按上方路径前往银行应用。</text>
</app-sheet>

<app-sheet id="detail-expected" show="{{showExpected}}" title="预计到账日" content-state="{{[expectedOn, expectedError, expectedLatestNote, refreshing, refreshError]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeExpected">
  <view wx:if="{{refreshing || refreshError}}" class="sheet-caption" role="status"><text>{{refreshing ? '正在更新记录，当前日期选择仍然保留…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="retry" disabled="{{busy || expectedClosing}}">重新刷新</button></view>
  <text class="sheet-caption">可以跨月设置。返现到账前会一直保留在收益页的待确认列表中。</text>
  <text wx:if="{{expectedLatestNote}}" class="sheet-caption" role="status">{{expectedLatestNote}}</text>
  <picker mode="date" value="{{expectedOn}}" start="{{detail.participation.startsOn}}" bindchange="changeExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing || detail.participation.stage !== 'completed'}}" aria-label="选择预计到账日期"><view class="date-input"><text>{{expectedOn || '选择预计到账日期'}}</text><text aria-hidden="true">›</text></view></picker>
  <text wx:if="{{expectedDirty}}" class="sheet-caption">日期已修改，保存后生效。</text>
  <text wx:if="{{expectedError}}" class="field-error" role="alert">{{expectedError}}</text>
  <button class="button primary sheet-confirm" bindtap="saveExpected" loading="{{busy}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing || detail.participation.stage !== 'completed'}}">{{busy ? '正在保存' : '保存'}}</button>
  <button wx:if="{{expectedOn}}" class="text-button sheet-wide" bindtap="clearExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing || detail.participation.stage !== 'completed'}}">清除日期</button>
</app-sheet>

<app-sheet id="detail-manage" show="{{showManage}}" title="更多操作" content-state="{{[view, detail]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeManage">
  <button wx:if="{{view.joined && !view.finished && detail.participation.stage !== 'skipped'}}" class="sheet-option" bindtap="editProgress" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">更新累计进度</text><text class="option-help">仅调整累计进度，不生成消费记录</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{view.canComplete && view.primaryAction !== 'complete'}}" class="sheet-option" bindtap="complete" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">直接标记完成</text><text class="option-help">{{detail.participation ? '更新本期完成状态，收益可稍后记录' : '无需先加入待办，直接保存本期完成记录'}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{view.canReceipt && view.primaryAction !== 'receipt'}}" class="sheet-option" bindtap="receipt" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">{{view.benefit.recordAction}}</text><text class="option-help">{{view.benefit.isDiscount ? '按实际优惠金额和享受日期记录' : '按实际收到的金额和到账日期记录'}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation.stage === 'completed' && !view.benefit.isDiscount}}" class="sheet-option" bindtap="openExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">预计到账日</text><text class="option-help">{{detail.participation.expectedOn || '设置预计收到返现的日期'}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation && view.activity.scope === 'card' && !view.isPast}}" class="sheet-option" bindtap="anotherCard" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">用另一张卡参加</text><text class="option-help">每张卡独立保留进度与收益</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation && detail.participation.stage !== 'completed' && detail.participation.stage !== 'received' && detail.participation.stage !== 'skipped'}}" class="sheet-option" bindtap="skip" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">本期不参加</text><text class="option-help">只跳过这一期，后续仍会继续</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation.stage === 'completed'}}" class="sheet-option" bindtap="undoComplete" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">撤销完成</text><text class="option-help">恢复完成之前的参与状态</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation.stage === 'received'}}" class="sheet-option danger" bindtap="revokeReceipt" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">{{view.benefit.revokeAction}}</text><text class="option-help">移除{{view.benefit.actualLabel}}金额，恢复为{{view.benefit.pendingStatus}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.tracking.enabled && view.activity.frequency !== 'once'}}" class="sheet-option" bindtap="untrack" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">停止后续周期追踪</text><text class="option-help">本期、待确认和历史记录都会保留</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.tracking && !detail.tracking.enabled && view.activity.frequency !== 'once' && !view.isPast}}" class="sheet-option" bindtap="join" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">恢复后续周期追踪</text><text class="option-help">下个周期继续生成待办</text></view><text aria-hidden="true">›</text></button>
  <button class="sheet-option" bindtap="openHistory"><view><text class="option-title">参与与操作记录</text><text class="option-help">查看各期结果和本期修改记录</text></view><text aria-hidden="true">›</text></button>
</app-sheet>

<app-sheet id="detail-quit" show="{{showQuit}}" title="确认退出该活动？" content-state="{{[view, selectedCardName]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeQuit"><view class="quit-summary">{{view.bankShortName}} · {{selectedCardName || view.activity.cardDescription}} · {{view.activity.title}}</view><view class="quit-effects"><view wx:for="{{view.quitRows}}" wx:key="*this" class="quit-effect"><view/><text>{{item}}</text></view></view><view class="quit-actions"><button class="button secondary" bindtap="closeQuit" disabled="{{busy || expectedClosing}}">取消</button><button class="button danger" bindtap="confirmQuit" loading="{{busy}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">确认退出</button></view></app-sheet>
<screenshot-viewer id="activity-viewer" show="{{viewerOpen}}" items="{{viewerItems}}" index="{{viewerIndex}}" context="activity" bindclose="closeViewer"/>
<app-sheet id="detail-consumption" show="{{showConsumption}}" title="记录消费" content-state="{{[consumptionAmount, consumptionOn, consumptionDelta, consumptionPending, consumptionError, consumptionConflict, consumptionReapplyRequired]}}" dismissible="{{!busy && !consumptionReloading}}" bindclose="closeConsumption">
  <view class="consumption-form"><text class="consumption-subtitle">{{view.bankShortName}} · {{selectedCardName || view.activity.cardDescription}} · {{view.activity.title}}</text>
    <view class="consumption-amount-group"><text class="consumption-field-label">{{consumptionMode === 'amount' ? '消费金额' : '消费金额（选填，用于核对单笔门槛）'}}</text><view class="consumption-amount-box"><text>{{consumptionCurrencySymbol}}</text><input class="consumption-amount-input" type="digit" value="{{consumptionAmount}}" placeholder="0.00" bindinput="changeConsumptionAmount" maxlength="12" disabled="{{busy || consumptionReloading || consumptionPending || consumptionConflict || consumptionReapplyRequired}}" aria-label="消费金额"/></view><view class="consumption-presets"><button wx:for="{{consumptionPresets}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseConsumptionPreset" disabled="{{busy || consumptionReloading || consumptionPending || consumptionConflict || consumptionReapplyRequired}}">{{item.label}}</button></view></view>
    <view class="consumption-input-row"><text>消费日期</text><picker mode="date" value="{{consumptionOn}}" start="{{detail.participation.startsOn}}" end="{{detail.participation.endsOn < serverToday ? detail.participation.endsOn : serverToday}}" bindchange="changeConsumptionDate" disabled="{{busy || consumptionReloading || consumptionPending || consumptionConflict || consumptionReapplyRequired}}"><view class="consumption-date-value">{{consumptionDateLabel || '请选择'}}<text>›</text></view></picker></view>
    <view class="consumption-input-row"><text>商户或备注</text><input class="consumption-merchant-input" value="{{consumptionMerchant}}" placeholder="选填" maxlength="80" bindinput="changeConsumptionMerchant" disabled="{{busy || consumptionReloading || consumptionPending || consumptionConflict || consumptionReapplyRequired}}" aria-label="商户或备注"/></view>
    <view wx:if="{{consumptionMode === 'custom'}}" class="consumption-input-row"><text>本次增加的进度</text><input class="consumption-delta-input" value="{{consumptionDelta}}" placeholder="{{view.activity.unit}}" type="digit" bindinput="changeConsumptionDelta" disabled="{{busy || consumptionReloading || consumptionPending || consumptionConflict || consumptionReapplyRequired}}" aria-label="本次增加的进度"/><text>{{view.activity.unit}}</text></view>
    <text wx:if="{{consumptionMode === 'amount'}}" class="consumption-guidance">消费金额按 {{view.activity.currency}} 记入累计{{view.activity.unit}}数。</text><text wx:else class="consumption-guidance">{{consumptionMode === 'count' ? '每次保存增加 1 ' + view.activity.unit + '。' : '请按活动规则填写本次可计入的进度。'}}是否计入活动，以银行实际规则为准。</text>
    <view class="consumption-preview">{{consumptionPreview}}</view><text wx:if="{{consumptionNotice}}" class="consumption-guidance" role="status">{{consumptionNotice}}</text><text wx:if="{{consumptionError}}" class="field-error" role="alert">{{consumptionError}}</text>
    <button wx:if="{{consumptionPending}}" class="button primary consumption-save" bindtap="retryConsumption" loading="{{busy}}" disabled="{{busy || consumptionReloading}}">继续核对原保存</button><button wx:elif="{{consumptionConflict}}" class="button secondary consumption-save" bindtap="reloadConsumption" loading="{{consumptionReloading}}" disabled="{{busy || consumptionReloading}}">读取最新记录</button><button wx:elif="{{consumptionReapplyRequired}}" class="button secondary consumption-save" bindtap="reviewConsumption" disabled="{{busy || consumptionReloading}}">已核对，采用最新进度</button><button wx:else class="button primary consumption-save" bindtap="saveConsumption" loading="{{busy}}" disabled="{{busy || loading || refreshing || outdated || consumptionReloading}}">{{consumptionSaveLabel}}</button>
  </view>
</app-sheet>
<app-sheet id="detail-consumption-record" show="{{showConsumptionRecord}}" title="消费记录" content-state="{{[selectedConsumption, consumptionRevokePending, consumptionError]}}" dismissible="{{!busy}}" bindclose="closeConsumptionRecord"><view wx:if="{{selectedConsumption}}" class="consumption-record-details"><view><text>消费日期</text><text>{{selectedConsumption.consumedOn}}</text></view><view><text>商户或备注</text><text>{{selectedConsumption.merchant || '手动记录'}}</text></view><view><text>消费金额</text><text>{{selectedConsumptionAmount}}</text></view><view><text>计入进度</text><text>{{selectedConsumption.progressDelta}} {{view.activity.unit}}</text></view><text wx:if="{{selectedConsumption.reversedAt}}" class="consumption-guidance">已撤销，历史记录保留，不再计入当前进度。</text><text wx:elif="{{!view.withdrawn && detail.participation.stage !== 'received' && detail.participation.stage !== 'skipped'}}" class="consumption-guidance">撤销后将扣回这笔消费计入的进度，历史记录保留。若因此未达到目标，将恢复为进行中。</text><text wx:if="{{consumptionError}}" class="field-error">{{consumptionError}}</text><button wx:if="{{consumptionRevokePending}}" class="button danger consumption-save" bindtap="revokeConsumption" loading="{{busy}}" disabled="{{busy}}">继续核对原撤销</button><button wx:elif="{{!selectedConsumption.reversedAt && !view.withdrawn && detail.participation.stage !== 'received' && detail.participation.stage !== 'skipped'}}" class="button danger consumption-save" bindtap="revokeConsumption" loading="{{busy}}" disabled="{{busy || loading || refreshing || outdated}}">确认撤销本笔消费</button></view></app-sheet>
<view wx:if="{{showCelebration}}" class="celebration-mask"><view class="celebration-card"><view class="celebration-art"><text>小羊插画</text><text>占位</text></view><text class="celebration-title">已达标</text><text class="celebration-activity">{{view.activity.title}}</text><text class="celebration-note">{{view.benefit.expectedLabel}} {{view.reward}} · {{view.benefit.pendingDescription}}</text><button class="button primary" bindtap="closeCelebration">知道了</button></view></view>
