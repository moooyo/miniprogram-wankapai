<view class="detail-page" aria-hidden="{{showManage || showRules || showCards || showExpected || showGuide}}">
  <view wx:if="{{preparingCards}}" class="refresh-notice" role="status"><text>正在读取卡包。查看指引或规则会取消本次选卡，稍后可重新选择。</text><button class="text-button" bindtap="cancelCardSelection">取消选卡</button></view>
  <view wx:if="{{refreshing || refreshError}}" class="refresh-notice" role="status"><text>{{refreshing ? mutationNotice + '正在更新活动记录，已读内容仍然保留…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="retry" disabled="{{busy || expectedClosing}}">重新刷新</button></view>
  <view wx:if="{{loading && !detail}}" class="state-block">正在加载活动…</view>
  <view wx:elif="{{error && !detail}}" class="state-block" role="alert"><text>{{error}}</text><button class="button secondary" bindtap="retry">重新加载</button><button class="text-button" bindtap="back">返回活动列表</button></view>
  <block wx:elif="{{detail && view}}">
    <view class="activity-summary">
      <view class="summary-top"><view class="bank-name"><image class="bank-logo" src="{{view.logo}}" mode="aspectFit" aria-hidden="true"/><text>{{view.bankName}}</text><text class="frequency">{{view.frequencyLabel}}</text></view></view>
      <text class="activity-title">{{view.activity.title}}</text>
      <view class="summary-reward"><view class="reward-line"><text class="reward-value">{{view.reward}}</text><text>{{view.rewardLabel}}</text></view><text>{{view.endsOn}} 截止</text></view>
      <text class="summary-card">{{view.activity.cardDescription}}{{view.activity.requiresInvitation ? ' · 需受邀' : ''}}{{view.activity.requiresRegistration ? ' · 需报名' : ''}}</text>
      <text wx:if="{{view.isPast}}" class="past-note">正在查看历史参与期，修改只影响这一期。</text>
    </view>

    <view wx:if="{{detail.participation}}" class="progress-panel">
      <view class="progress-heading"><text>我的参与 · {{view.periodLabel}}</text><button wx:if="{{!view.finished && detail.participation.stage !== 'skipped'}}" class="text-button" bindtap="editProgress" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">更新进度</button></view>
      <text class="progress-current">{{view.progressLabel}}</text>
      <text wx:if="{{selectedCardName}}" class="progress-help">{{selectedCardName}}</text>
      <progress wx:if="{{view.showProgress}}" percent="{{view.progressPercent}}" stroke-width="4" activeColor="#568be5" backgroundColor="#e8eef8" aria-label="活动完成进度"/>
      <text wx:if="{{!view.finished && detail.participation.stage !== 'skipped'}}" class="progress-help">{{view.progressHelp}}{{detail.participation.registeredAt && detail.participation.progress > 0 ? ' · 已报名' : ''}}</text>
      <button wx:if="{{detail.participation.stage === 'completed' && !view.benefit.isDiscount}}" class="date-setting" bindtap="openExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><text>{{detail.participation.expectedOn ? '预计 ' + detail.participation.expectedOn + ' 到账' : '设置预计到账日'}}</text><text aria-hidden="true">›</text></button>
      <text wx:elif="{{detail.participation.stage === 'received'}}" class="progress-help">{{detail.participation.receivedOn}} {{view.benefit.dateEvent}} · 计入 {{view.receivedMonth}}{{view.benefit.isDiscount ? '已享优惠' : '返现到账'}}</text>
      <text wx:elif="{{detail.participation.stage === 'skipped'}}" class="progress-help">仅跳过这一期，历史记录和后续周期保留。</text>
    </view>
    <view class="entry-panel">
      <view class="entry-heading"><text>参与入口</text><text wx:if="{{view.activity.entrance.verifiedAt}}" class="entry-verified">已核验</text></view>
      <view class="entry-body"><view class="entry-description"><text class="entry-title">{{view.activity.entrance.label || '银行活动入口'}}</text><text class="entry-instructions">{{view.activity.entrance.instructions || '请先核对银行规则与参与资格。'}}</text></view><button class="entry-open {{detail.participation ? 'is-secondary' : ''}}" bindtap="entrance">{{view.entryAction}}</button></view>
      <view wx:if="{{view.entryImages.length}}" class="entry-extras"><button class="entry-image-link" bindtap="openGuide"><image wx:if="{{view.entryImages[0].url}}" src="{{view.entryImages[0].url}}" mode="aspectFill" aria-hidden="true"/><text>入口截图 · {{view.entryImages.length}} 张</text><text aria-hidden="true">›</text></button></view>
    </view>
    <text wx:if="{{!detail.participation}}" class="join-help join-note">{{view.activity.frequency === 'once' ? '加入待办后，可随时记录进度。' : '加入待办后，每期独立记录，历史会一直保留。'}}已完成的活动也可从“更多”直接记录。</text>
    <text wx:if="{{!detail.eligible && !detail.participation}}" class="qualification-note">{{view.activity.scope === 'card' ? '这项活动按卡片记录，请先添加符合条件的卡片。最终参与资格仍以银行为准。' : '尚未匹配到适用卡片。你仍可手动记录，参与资格以银行为准。'}}</text>

    <view class="participation-rules"><view class="rules-heading"><text class="section-title">怎么参加</text><button class="text-button" bindtap="openRules">完整规则</button></view><text class="conditions">{{view.activity.conditions}}</text><text wx:if="{{view.activity.requiresRegistration}}" class="rules-note">需先在银行完成报名，再按规则消费。</text><text wx:if="{{view.activity.requiresInvitation}}" class="rules-note">仅限受邀用户，请先核对活动资格。</text><text wx:if="{{view.activity.scope === 'card'}}" class="rules-note">每张卡单独计算进度与收益。</text></view>
    <button wx:if="{{detail.participation || detail.history.length}}" class="history-link" bindtap="openHistory"><text>参与记录</text><text>查看全部　›</text></button>
    <text wx:if="{{reminderReady && (detail.participation.stage === 'completed' || !view.deadlineReminderExpired)}}" class="rules-note">已核对提醒偏好，请点击下方按钮申请本期微信授权。下一期需重新授权。</text>
    <text wx:if="{{detail.participation && !view.finished && detail.participation.stage !== 'skipped' && view.deadlineReminderExpired}}" class="rules-note deadline-reminder-expired">已过截止日，不补发微信提醒。记录仍会保留，可补填本期进度和结果。</text>
    <button wx:if="{{detail.participation && !view.finished && detail.participation.stage !== 'skipped' && !view.deadlineReminderExpired}}" class="reminder-link" bindtap="reminder" loading="{{reminderChecking}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{reminderChecking ? '正在核对提醒设置…' : reminderReady ? '申请本期微信授权' : '开启本期截止提醒'}}</button>
    <button wx:if="{{detail.participation.stage === 'completed' && detail.participation.expectedOn && !view.benefit.isDiscount}}" class="reminder-link" bindtap="reminder" loading="{{reminderChecking}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{reminderChecking ? '正在核对提醒设置…' : reminderReady ? '申请本期微信授权' : '开启预计到账提醒'}}</button>
    <view wx:if="{{reminderError}}" class="refresh-notice" role="alert"><text>{{reminderError}}</text><button class="text-button" bindtap="reminder" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">重试提醒设置</button></view>
  </block>
</view>

<view wx:if="{{detail && view}}" class="detail-bottom-bar" aria-hidden="{{showManage || showRules || showCards || showExpected || showGuide}}">
  <button class="button secondary detail-more" bindtap="openManage" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}" aria-label="更多活动操作">更多</button>
  <button wx:if="{{view.primaryAction === 'join'}}" class="button primary detail-primary" bindtap="join" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}" loading="{{busy}}">{{view.primaryLabel}}</button>
  <button wx:elif="{{view.primaryAction === 'progress'}}" class="button primary detail-primary" bindtap="editProgress" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryLabel}}</button>
  <button wx:elif="{{view.primaryAction === 'complete'}}" class="button primary detail-primary" bindtap="complete" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}" loading="{{busy}}">{{view.primaryLabel}}</button>
  <button wx:elif="{{view.primaryAction === 'resume'}}" class="button primary detail-primary" bindtap="resume" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}" loading="{{busy}}">{{view.primaryLabel}}</button>
  <button wx:else class="button primary detail-primary" bindtap="receipt" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">{{view.primaryLabel}}</button>
</view>

<app-sheet id="detail-card-picker" show="{{showCards}}" title="用哪张卡参加？" content-state="{{[cards, matchingCardCount, cardSelectionError, selectedCardId]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeCards">
  <text class="sheet-caption">这个活动按卡计算。请选择实际使用、且符合当前条件的卡片：{{cardRequirement}}。</text>
  <view class="card-options"><button wx:for="{{cards}}" wx:key="id" class="card-option {{selectedCardId === item.id ? 'is-selected' : ''}} {{!item.matches ? 'is-unavailable' : ''}}" data-id="{{item.id}}" bindtap="chooseCard" disabled="{{!item.matches || loading || refreshing || outdated || busy || expectedClosing}}" aria-pressed="{{selectedCardId === item.id}}"><view class="card-option-text"><text class="card-option-title">{{item.name}}</text><text class="card-option-description">{{item.issuer}}</text><text class="card-qualification">{{item.qualification}}</text></view><text class="selection-mark">{{selectedCardId === item.id ? '✓' : ''}}</text></button></view>
  <text wx:if="{{!cards.length}}" class="sheet-caption">卡包里还没有这家银行的卡片，请先添加。</text>
  <text wx:elif="{{!matchingCardCount}}" class="sheet-caption">现有卡片均不符合条件。请添加符合条件的卡片后继续。</text>
  <text wx:if="{{cardSelectionError}}" class="field-error">{{cardSelectionError}}</text>
  <button wx:if="{{matchingCardCount}}" class="button primary sheet-confirm" bindtap="confirmCard" disabled="{{!selectedCardId || loading || refreshing || outdated || busy || expectedClosing}}">继续{{pendingAction === 'join' ? '加入待办' : pendingAction === 'complete' ? '标记完成' : view.benefit.recordAction}}</button>
  <button class="text-button sheet-wide" bindtap="addCard" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}">添加符合条件的卡片</button>
</app-sheet>

<app-sheet id="detail-rules" show="{{showRules}}" title="活动规则" content-state="{{[view]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeRules">
  <view class="full-rules"><text class="rule-title">{{view.activity.title}}</text><text class="rule-label">适用卡片</text><text>{{view.activity.cardDescription}}</text><text class="rule-label">发卡机构</text><text>{{view.issuerNames}}</text><text class="rule-label">参与要求</text><text>{{view.activity.conditions}}</text><text class="rule-label">活动时间</text><text>{{view.activity.startsOn}} 至 {{view.activity.endsOn}}</text><text class="rule-label">次数与周期</text><text>{{view.frequencyLabel}} · {{view.activity.scope === 'card' ? '每张卡单独计算' : '每位用户计算'}}</text><text class="rule-label">规则来源</text><text>{{view.activity.sourceNote || '以银行官方活动规则为准'}}</text><button wx:if="{{view.activity.sourceUrl}}" class="button secondary" bindtap="source">{{view.sourceAction}}</button></view>
</app-sheet>

<app-sheet id="detail-guide" show="{{showGuide}}" title="参与指引" content-state="{{[view]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeGuide">
  <text class="guide-instructions">{{view.activity.entrance.instructions}}</text>
  <view wx:for="{{view.entryImages}}" wx:key="id" class="guide-item"><button class="guide-image-button" bindtap="previewImage" data-id="{{item.id}}" aria-label="{{item.url ? '放大查看' : '重新加载'}}第 {{index + 1}} 张入口截图"><image wx:if="{{item.url}}" src="{{item.url}}" mode="widthFix" class="guide-image"/><text wx:else class="sheet-caption">第 {{index + 1}} 张截图暂未加载，点击重试</text></button><text wx:if="{{item.url}}" class="sheet-caption">点击图片可放大查看</text></view>
  <text wx:if="{{!view.entryImages.length}}" class="sheet-caption">这项活动暂未提供入口截图，可按上方路径前往银行应用。</text>
</app-sheet>

<app-sheet id="detail-expected" show="{{showExpected}}" title="预计到账日" content-state="{{[expectedOn, expectedError, expectedLatestNote, refreshing, refreshError]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeExpected">
  <view wx:if="{{refreshing || refreshError}}" class="sheet-caption" role="status"><text>{{refreshing ? '正在更新记录，当前日期选择仍然保留…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="retry" disabled="{{busy || expectedClosing}}">重新刷新</button></view>
  <text class="sheet-caption">可以跨月设置。返现到账前会一直保留在收益页的待确认列表中。</text>
  <text wx:if="{{expectedLatestNote}}" class="sheet-caption" role="status">{{expectedLatestNote}}</text>
  <picker mode="date" value="{{expectedOn}}" start="{{detail.participation.startsOn}}" bindchange="changeExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing || detail.participation.stage !== 'completed'}}" aria-label="选择预计到账日期"><view class="date-input"><text>{{expectedOn || '选择预计到账日期'}}</text><text aria-hidden="true">›</text></view></picker>
  <text wx:if="{{expectedDirty}}" class="sheet-caption">日期已修改，保存后生效。</text>
  <text wx:if="{{expectedError}}" class="field-error" role="alert">{{expectedError}}</text>
  <button class="button primary sheet-confirm" bindtap="saveExpected" loading="{{busy}}" disabled="{{loading || refreshing || outdated || busy || expectedClosing || detail.participation.stage !== 'completed'}}">{{busy ? '正在保存' : '保存'}}</button>
  <button wx:if="{{expectedOn}}" class="text-button sheet-wide" bindtap="clearExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing || detail.participation.stage !== 'completed'}}">清除日期</button>
</app-sheet>

<app-sheet id="detail-manage" show="{{showManage}}" title="更多操作" content-state="{{[view, detail]}}" dismissible="{{!busy && !expectedClosing}}" bindclose="closeManage">
  <button wx:if="{{view.canComplete && view.primaryAction !== 'complete'}}" class="sheet-option" bindtap="complete" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">直接标记完成</text><text class="option-help">{{detail.participation ? '更新本期完成状态，收益可稍后记录' : '无需先加入待办，直接保存本期完成记录'}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{view.canReceipt && view.primaryAction !== 'receipt'}}" class="sheet-option" bindtap="receipt" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">{{view.benefit.recordAction}}</text><text class="option-help">{{view.benefit.isDiscount ? '按实际优惠金额和享受日期记录' : '按实际收到的金额和到账日期记录'}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation.stage === 'completed' && !view.benefit.isDiscount}}" class="sheet-option" bindtap="openExpected" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">预计到账日</text><text class="option-help">{{detail.participation.expectedOn || '设置预计收到返现的日期'}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation && view.activity.scope === 'card' && !view.isPast}}" class="sheet-option" bindtap="anotherCard" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">用另一张卡参加</text><text class="option-help">每张卡独立保留进度与收益</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation && detail.participation.stage !== 'completed' && detail.participation.stage !== 'received' && detail.participation.stage !== 'skipped'}}" class="sheet-option" bindtap="skip" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">本期不参加</text><text class="option-help">只跳过这一期，后续仍会继续</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation.stage === 'completed'}}" class="sheet-option" bindtap="undoComplete" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">撤销完成</text><text class="option-help">恢复完成之前的参与状态</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.participation.stage === 'received'}}" class="sheet-option danger" bindtap="revokeReceipt" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">{{view.benefit.revokeAction}}</text><text class="option-help">移除{{view.benefit.actualLabel}}金额，恢复为{{view.benefit.pendingStatus}}</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.tracking.enabled && view.activity.frequency !== 'once'}}" class="sheet-option" bindtap="untrack" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">停止后续周期追踪</text><text class="option-help">本期、待确认和历史记录都会保留</text></view><text aria-hidden="true">›</text></button>
  <button wx:if="{{detail.tracking && !detail.tracking.enabled && view.activity.frequency !== 'once' && !view.isPast}}" class="sheet-option" bindtap="join" disabled="{{loading || refreshing || outdated || busy || expectedClosing}}"><view><text class="option-title">恢复后续周期追踪</text><text class="option-help">下个周期继续生成待办</text></view><text aria-hidden="true">›</text></button>
  <button class="sheet-option" bindtap="openHistory"><view><text class="option-title">参与与操作记录</text><text class="option-help">查看各期结果和本期修改记录</text></view><text aria-hidden="true">›</text></button>
</app-sheet>
