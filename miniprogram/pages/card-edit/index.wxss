.card-form-page{background:#F3F6FB;min-height:calc(100vh - 98px);padding:4px 16px calc(108px + env(safe-area-inset-bottom));color:#0F1B2D}.form-intro{font-size:13px;color:#5E6E84;line-height:1.5;padding:0 4px;margin-bottom:14px}.draft-note{font-size:13px;line-height:1.6;background:#E6EEFC;color:#1A56C4;border-radius:12px;padding:12px 14px;margin-bottom:14px}.draft-warning{background:#FDF1DE;color:#9A5B07}.draft-note .secondary{margin-top:8px!important}.form-section{padding:16px;background:#FFFFFF;border:1px solid #E3E9F2;border-radius:18px;margin-bottom:14px}.field{display:flex;flex-direction:column;gap:8px;margin-bottom:18px}.field:last-child{margin-bottom:0}.field-label{display:block;color:#3F4D63;font-size:13px;line-height:1.5;margin-bottom:0}.optional{font-size:12px;color:#5E6E84;display:inline-block}.select-input{min-height:48px;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 14px;border:1px solid #E3E9F2;border-radius:12px;color:#0F1B2D;font-size:15px;line-height:1.5;background:#F3F6FB}.select-input>text:last-child:not(:first-child){color:#5E6E84;flex:none}.select-input>text:first-child{min-width:0}.readonly{border-color:transparent}.bank-choice{display:flex;align-items:center;gap:10px;flex:1;min-width:0;font-weight:500}.bank-logo{width:26px;height:26px;border-radius:50%;background:#fff;flex:none}.bank-lock{font-size:12px;font-weight:400}.bank-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.bank-grid .bank-grid-choice{padding:8px 0;display:flex;flex-direction:column;gap:4px;min-height:68px;background:#FFFFFF;border:1px solid #E3E9F2;border-radius:12px;font-size:12px;color:#3F4D63;font-weight:400}.bank-grid .selected{background:#E6EEFC;border-color:#9DBBF2;color:#1A56C4;font-weight:600}.bank-grid-logo{width:26px;height:26px;border-radius:50%;background:#fff}.kind-switch{display:flex;gap:0;padding:3px;border-radius:12px;background:#EBF0F7}.kind-switch button.kind-button{flex:1;min-width:0;margin:0;height:38px;min-height:38px;line-height:1.4;padding:0;background:transparent;color:#5E6E84;border-radius:9px;font-size:14px;font-weight:500}.kind-button.selected{color:#0F1B2D;background:#FFFFFF;box-shadow:0 2px 5px rgba(15,35,70,.08)}.kind-button::after{border:0}.network-chips{display:flex;gap:8px;flex-wrap:wrap}.network-chips button.form-chip{height:36px;min-height:36px;padding:0 14px;border-radius:999px;border:1px solid #E3E9F2;background:#FFFFFF;color:#3F4D63;font-size:13px;font-weight:400}.network-chips .selected{background:#E6EEFC;border-color:#9DBBF2;color:#1A56C4;font-weight:500}.form-input{height:48px;min-height:48px;width:100%;border:1.5px solid #E3E9F2;border-radius:12px;padding:0 14px;background:#F3F6FB;color:#0F1B2D;font-size:15px}.field-help{display:block;color:#5E6E84;font-size:12px;line-height:1.5;margin-top:0}.issuer-summary{display:block;color:#5E6E84;font-size:12px;line-height:1.5}.field-error{display:block;color:#B8392C;font-size:12px;line-height:1.5}.placeholder{color:#5E6E84}.billing-section{padding:8px 16px 16px}.reminder-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;min-height:56px}.reminder-head>view{flex:1;min-width:0}.reminder-head switch{flex:none;transform:scale(.78);transform-origin:right center}.section-title{color:#0F1B2D;font-size:15px;font-weight:600;line-height:1.5}.billing-section>.field{border-top:1px solid #EBF0F7;padding-top:14px}.sharing-note{color:#3F4D63;font-size:13px;line-height:1.5;background:#F3F6FB;border-radius:12px;padding:10px 12px;margin-bottom:14px}.notification-note{color:#5E6E84;font-size:12px;line-height:1.6;margin-top:12px}button.cycle-summary{width:100%!important;display:flex;justify-content:space-between;align-items:center;background:#F3F6FB;color:#5E6E84;font-size:13px;text-align:left;padding:10px 12px;border-radius:12px;margin:0 0 18px!important;line-height:1.5;gap:10px}.cycle-summary>view{min-width:0}.cycle-value{color:#3F4D63;font-size:13px;margin-top:2px}.cycle-edit{color:#1A56C4;font-size:13px;flex:none}.cycle-fields{border-left:2px solid #9DBBF2;padding:0 0 14px 14px;margin-bottom:14px}button.remove-button{color:#B8392C;min-height:50px;background:#fff;border:1px solid #F1C7C1;border-radius:14px;width:100%!important;margin:0;padding:0 14px;font-size:15px}.advanced-section{border:1px solid #E3E9F2;background:#fff;border-radius:18px;margin-bottom:14px;padding:0 16px}button.advanced-toggle{display:flex;justify-content:space-between;align-items:center;min-height:54px;padding:12px 0;background:transparent;color:#5E6E84;font-size:13px;width:100%!important}.advanced-content{padding:0 0 16px;display:flex;flex-direction:column;gap:6px}.debit-notice{padding:12px 14px;border-radius:14px;background:#E6EEFC;color:#1A56C4;font-size:13px;line-height:1.5;margin-bottom:14px}.bottom-bar{padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:#FFFFFF;border-top:1px solid #E3E9F2}.bottom-bar button.save-button{width:100%;height:50px;min-height:50px;border-radius:14px;background:#1F61D8;color:#fff;font-size:16px;font-weight:600}.loading,.empty{padding:40px 12px;text-align:center;font-size:13px;line-height:1.65;color:#5E6E84}.empty-title{color:#0F1B2D;font-size:16px;font-weight:600;margin-bottom:12px}.empty button{margin-top:14px}.validation-summary{padding:14px;margin-bottom:14px;border:1px solid #F1C7C1;border-radius:14px;background:#fff5f3;color:#B8392C}.validation-title{display:block;font-size:14px;font-weight:600}button.validation-link{display:block;width:100%!important;min-height:44px;padding:10px 0;text-align:left;background:transparent;color:#B8392C;font-size:13px;line-height:1.5;white-space:normal;overflow-wrap:anywhere}.validation-link::after{border:0}.field-label,.bank-choice,.cycle-summary>view{overflow-wrap:anywhere}
.kind-switch button.kind-button.selected{color:#0F1B2D;background:#FFFFFF;box-shadow:0 2px 5px rgba(15,35,70,.08)}.network-chips button.form-chip.selected{background:#E6EEFC;border-color:#9DBBF2;color:#1A56C4;font-weight:500}
