<design-nav title="{{editing ? '编辑卡片' : '添加卡片'}}" back />
<view class="page card-form-page">
  <view class="form-intro">用于匹配活动和安排还款，无需填写卡号。</view>
  <view wx:if="{{loading}}" class="loading text-muted">正在读取卡片…</view>
  <view wx:elif="{{failed}}" class="empty"><view class="empty-title">卡片暂时无法加载</view><button class="secondary" bindtap="load">重试</button><button class="secondary" bindtap="back">返回卡包</button></view>
  <block wx:else>
    <view wx:if="{{dirty && !pendingLookupOnly}}" class="draft-note {{draftSaved ? '' : 'draft-warning'}}">{{draftSaved ? '修改已保存在本机草稿，仍需保存卡片后生效。' : '草稿暂未保存在本机，请保存卡片后再离开。'}}</view>
    <view wx:if="{{pendingRetryNotice}}" class="draft-note" role="status">{{pendingRetryNotice}}</view>
    <view wx:if="{{pendingLookupOnly || pendingLookupNotice}}" class="draft-note" role="status"><text wx:if="{{pendingLookupNotice}}">{{pendingLookupNotice}}</text><button class="secondary" bindtap="openWalletForVerification" disabled="{{saving || removing || rebasing}}">去卡包核对</button></view>
    <view wx:if="{{recoveredDraftLookupAvailable}}" class="draft-note" role="status">
      <view>发现同名卡片，可以先核对这份恢复的草稿是否已保存。核对只查询已有结果，不会再次添加。</view>
      <view wx:if="{{recoveredDraftLookupNotice}}" class="field-help">{{recoveredDraftLookupNotice}}</view>
      <button class="secondary" bindtap="resolveRecoveredDraftCreation" loading="{{saving}}" disabled="{{saving || removing || rebasing}}">核对这份草稿是否已保存</button>
      <button class="secondary" bindtap="openWalletForVerification" disabled="{{saving || removing || rebasing}}">去卡包查看</button>
    </view>
    <view wx:if="{{errorSummary.length > 1}}" id="card-error-summary" class="validation-summary" role="alert" aria-label="请检查以下{{errorSummary.length}}项内容">
      <text class="validation-title">有 {{errorSummary.length}} 项内容需要检查</text>
      <text class="field-help">点击下方提示，跳转到对应位置。</text>
      <button wx:for="{{errorSummary}}" wx:key="field" class="validation-link" data-field="{{item.field}}" bindtap="focusErrorField" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}">{{item.label}}：{{item.message}}</button>
    </view>
    <view class="form-section">
      <view id="field-bankId" class="field"><text class="field-label">银行</text><view wx:if="{{!editing}}" class="bank-grid"><button wx:for="{{banks}}" wx:key="id" class="bank-grid-choice {{bankIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectBank" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}"><image class="bank-grid-logo" src="{{item.logo}}" mode="aspectFit" /><text>{{item.shortName}}</text></button></view><view wx:else class="select-input readonly"><view class="bank-choice"><image class="bank-logo" src="{{banks[bankIndex].logo}}" mode="aspectFit" /><text>{{banks[bankIndex].name}}</text></view><text class="bank-lock">编辑时不可修改</text></view><text wx:if="{{errors.bankId}}" class="field-error" role="alert">{{errors.bankId}}</text><text wx:if="{{issuerOptions.length === 1 && !errors.issuerId}}" id="field-issuerId" class="issuer-summary">发卡机构：{{issuerOptions[issuerIndex].name}}</text></view>
      <view wx:if="{{issuerOptions.length !== 1 || errors.issuerId}}" id="field-issuerId" class="field"><text class="field-label">发卡机构</text><picker range="{{issuerOptions}}" range-key="name" value="{{issuerIndex}}" disabled="{{editing || issuerOptions.length === 1 || saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="changeIssuer" aria-label="发卡机构，{{issuerOptions[issuerIndex].name}}{{editing ? '，编辑时不可修改' : ''}}"><view class="select-input {{editing ? 'readonly' : ''}}"><text>{{issuerOptions[issuerIndex].name || '请选择发卡机构'}}</text><text wx:if="{{!editing && issuerOptions.length > 1}}">⌄</text></view></picker><text class="field-help">按卡片实际发卡机构匹配活动。</text><text wx:if="{{errors.issuerId}}" class="field-error" role="alert">{{errors.issuerId}}</text></view>
      <view id="field-kind" class="field"><text class="field-label">卡片类型</text><view class="kind-switch"><button class="kind-button {{kind === 'credit' ? 'selected' : ''}}" data-kind="credit" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindtap="changeKind" aria-pressed="{{kind === 'credit'}}">信用卡</button><button class="kind-button {{kind === 'debit' ? 'selected' : ''}}" data-kind="debit" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindtap="changeKind" aria-pressed="{{kind === 'debit'}}">借记卡</button></view><text wx:if="{{errors.kind}}" class="field-error" role="alert">{{errors.kind}}</text></view>
      <view id="field-network" class="field"><text class="field-label">卡组织</text><view class="network-chips"><button wx:for="{{networks}}" wx:key="value" class="form-chip {{networkIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectNetwork" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" aria-pressed="{{networkIndex === index}}">{{item.label}}</button></view><text wx:if="{{errors.network}}" class="field-error" role="alert">{{errors.network}}</text></view>
      <view id="field-nickname" class="field"><label class="field-label" for="card-nickname">卡片昵称 <text class="optional">同类卡重复时请填写</text></label><input id="card-nickname" aria-label="卡片昵称" focus="{{focusField === 'nickname'}}" class="form-input" value="{{nickname}}" maxlength="40" placeholder="例如：日常消费卡、旅行卡" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindinput="changeNickname" /><text class="field-help">按用途取名即可，无需填写银行卡号或尾号。</text><text wx:if="{{errors.nickname}}" class="field-error" role="alert">{{errors.nickname}}</text></view>
    </view>
    <view wx:if="{{kind === 'credit'}}" id="field-billing" class="form-section billing-section">
      <view class="reminder-head row-between"><view><view class="section-title">还款计划</view><text class="field-help">登记账单日和实际还款日期</text></view><switch checked="{{reminderEnabled}}" color="#1764D9" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="toggleReminder" aria-label="设置还款计划" /></view>
      <text wx:if="{{errors.billing}}" class="field-error" role="alert">{{errors.billing}}</text>
      <block wx:if="{{reminderEnabled}}">
        <view wx:if="{{periodRebaseNeeded}}" class="draft-note" role="alert"><text>{{billingTargetUnavailable ? '账单关联已变化，原账单目标暂不可用。重新读取这张卡当前关联的账单会保留填写，再由你核对新目标和实际日期。' : '账期或账单关联需要重新核对。更新会保留已填写内容，再由你确认当前账单和实际日期。'}}</text><button class="secondary" bindtap="rebaseBillingPeriod" loading="{{rebasing}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}">{{billingTargetUnavailable ? '保留填写，重新读取账单' : '保留填写，更新当前账期'}}</button></view>
        <view id="field-billingAccountId" class="field"><text class="field-label">账单</text><picker range="{{billingChoices}}" range-key="label" value="{{billingIndex}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="changeBilling" aria-label="账单，{{billingChoices[billingIndex].label}}"><view class="select-input"><text>{{billingChoices[billingIndex].label}}</text><text>⌄</text></view></picker><text wx:if="{{errors.billingAccountId}}" class="field-error" role="alert">{{errors.billingAccountId}}</text></view>
        <view wx:if="{{billingIndex > 0}}" class="sharing-note">{{sharingNote}}</view>
        <block wx:else>
          <view id="field-statementDay" class="field"><text class="field-label">每月账单日</text><picker range="{{days}}" value="{{statementDay ? statementDay - 1 : 0}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="changeStatement" aria-label="每月账单日，{{statementDay ? statementDay + '日' : '未选择'}}"><view class="select-input"><text class="{{statementDay ? '' : 'placeholder'}}">{{statementDay ? '每月 ' + statementDay + ' 日' : '请选择账单日'}}</text><text>⌄</text></view></picker><text wx:if="{{errors.statementDay}}" class="field-error" role="alert">{{errors.statementDay}}</text></view>
          <view id="field-dueOn" class="field"><text class="field-label">{{datePeriodLabel}}账单实际还款日期</text><picker mode="date" value="{{dueOn}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="changeDueDate" aria-label="{{datePeriodLabel}}账单实际还款日期，{{dueOn || '未选择'}}"><view class="select-input"><text class="{{dueOn ? '' : 'placeholder'}}">{{dueOn || '按银行账单选择日期'}}</text><text>⌄</text></view></picker><text class="field-help">{{billingContextNotice}}</text><view wx:if="{{dateNeedsReview}}" class="field-help"><text>已保留原填写日期，请按当前显示账期重新选择，或核对后确认继续使用。</text><button class="secondary" bindtap="confirmDueDate" disabled="{{!dueOn || saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}">确认使用已填日期</button></view><text wx:if="{{errors.dueOn}}" class="field-error" role="alert">{{errors.dueOn}}</text></view>
          <button class="cycle-summary" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindtap="toggleCycle" aria-expanded="{{showCycle}}"><view><text>后续每期</text><view class="cycle-value">{{dueDay ? offsets[dueMonthOffset] + ' ' + dueDay + ' 日还款' : '选择本期日期后设置'}}</view></view><text class="cycle-edit">{{showCycle ? '收起' : '调整'}}</text></button>
          <view wx:if="{{showCycle}}" class="cycle-fields"><view id="field-dueMonthOffset" class="field"><text class="field-label">还款月份</text><picker range="{{offsets}}" value="{{dueMonthOffset}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="changeOffset" aria-label="还款月份，{{offsets[dueMonthOffset]}}"><view class="select-input"><text>{{offsets[dueMonthOffset]}}</text><text>⌄</text></view></picker><text wx:if="{{errors.dueMonthOffset}}" class="field-error" role="alert">{{errors.dueMonthOffset}}</text></view><view id="field-dueDay" class="field"><text class="field-label">常规还款日</text><picker range="{{days}}" value="{{dueDay ? dueDay - 1 : 0}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindchange="changeDueDay" aria-label="常规还款日，{{dueDay ? dueDay + '日' : '未选择'}}"><view class="select-input"><text>{{dueDay ? dueDay + ' 日' : '请选择'}}</text><text>⌄</text></view></picker><text wx:if="{{errors.dueDay}}" class="field-error" role="alert">{{errors.dueDay}}</text></view><text class="field-help">遇到不足该天数的月份，取当月最后一天；仍可按实际账单修正。</text></view>
          <view id="field-remindDays" class="field"><text class="field-label">提前提醒</text><view class="network-chips"><button wx:for="{{remindLabels}}" wx:key="*this" class="form-chip {{remindIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectRemind" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" aria-pressed="{{remindIndex === index}}">{{item}}</button></view><text wx:if="{{errors.remindDays}}" class="field-error" role="alert">{{errors.remindDays}}</text></view>
          <view class="sharing-note">{{independentNote}}</view>
        </block>
        <view class="notification-note">这里会生成站内还款待办。微信通知需到“卡包” → 具体未还账单 → “开启本期微信提醒”，每期单独授权。“我的”仅保存提醒意愿；演示模式不会发送微信通知。</view>
      </block>
    </view>
    <view wx:if="{{kind === 'debit'}}" class="debit-notice">借记卡无需还款，仅用于匹配活动与权益。</view><view wx:if="{{editing}}" class="advanced-section">
      <button class="advanced-toggle" bindtap="toggleAdvanced" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" aria-expanded="{{showAdvanced}}">高级信息<text aria-hidden="true">{{showAdvanced ? '收起' : '展开'}}</text></button>
      <view wx:if="{{showAdvanced}}" class="advanced-content"><text class="field-label">系统标识 · {{systemReference}}</text><text class="field-help">用于核对本应用中的卡片记录，不是银行卡号，也不包含卡号尾号。</text></view>
    </view>
    <button wx:if="{{editing}}" class="remove-button" loading="{{removing}}" disabled="{{saving || removing || rebasing || pendingCreationUnconfirmed || pendingLookupOnly}}" bindtap="remove">移除此卡</button>
  </block>
</view>
<view wx:if="{{!loading && !failed}}" class="bottom-bar"><button class="primary save-button" loading="{{saving}}" disabled="{{saving || removing || rebasing}}" bindtap="save">{{pendingLookupOnly ? '核对上次保存结果' : pendingCreationUnconfirmed ? '确认上次保存' : '保存卡片'}}</button></view>
