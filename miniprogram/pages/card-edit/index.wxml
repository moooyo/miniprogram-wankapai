<view class="page card-form-page">
  <view class="form-intro">用于匹配活动和安排还款，无需填写卡号。</view>
  <view wx:if="{{loading}}" class="loading text-muted">正在读取卡片…</view>
  <view wx:elif="{{failed}}" class="empty"><view class="empty-title">卡片暂时无法加载</view><button class="secondary" bindtap="load">重试</button></view>
  <block wx:else>
    <view class="form-section">
      <view class="field"><text class="field-label">银行</text><picker range="{{banks}}" range-key="name" value="{{bankIndex}}" disabled="{{editing}}" bindchange="changeBank"><view class="select-input {{editing ? 'readonly' : ''}}"><view class="bank-choice"><image class="bank-logo" src="{{banks[bankIndex].logo}}" mode="aspectFit" /><text>{{banks[bankIndex].name}}</text></view><text wx:if="{{!editing}}">⌄</text></view></picker><text wx:if="{{errors.bankId}}" class="field-error">{{errors.bankId}}</text></view>
      <view class="field"><text class="field-label">发卡机构</text><picker range="{{issuerOptions}}" range-key="name" value="{{issuerIndex}}" disabled="{{editing || issuerOptions.length === 1}}" bindchange="changeIssuer"><view class="select-input {{editing ? 'readonly' : ''}}"><text>{{issuerOptions[issuerIndex].name || '请选择发卡机构'}}</text><text wx:if="{{!editing && issuerOptions.length > 1}}">⌄</text></view></picker><text class="field-help">按卡片实际发卡机构匹配活动。</text><text wx:if="{{errors.issuerId}}" class="field-error">{{errors.issuerId}}</text></view>
      <view class="field"><text class="field-label">卡片类型</text><view class="kind-switch"><button class="kind-button {{kind === 'credit' ? 'selected' : ''}}" data-kind="credit" bindtap="changeKind" aria-pressed="{{kind === 'credit'}}">信用卡</button><button class="kind-button {{kind === 'debit' ? 'selected' : ''}}" data-kind="debit" bindtap="changeKind" aria-pressed="{{kind === 'debit'}}">借记卡</button></view></view>
      <view class="field"><text class="field-label">卡组织</text><picker range="{{networks}}" range-key="label" value="{{networkIndex}}" bindchange="changeNetwork"><view class="select-input"><text>{{networks[networkIndex].label}}</text><text>⌄</text></view></picker><text wx:if="{{errors.network}}" class="field-error">{{errors.network}}</text></view>
      <view class="field"><text class="field-label">卡片昵称 <text class="optional">选填</text></text><input class="form-input" value="{{nickname}}" maxlength="40" placeholder="例如：日常消费卡" bindinput="changeNickname" /><text class="field-help">同一家银行有多张卡时，方便区分。</text><text wx:if="{{errors.nickname}}" class="field-error">{{errors.nickname}}</text></view>
    </view>
    <view wx:if="{{kind === 'credit'}}" class="form-section billing-section">
      <view class="reminder-head row-between"><view><view class="section-title">还款计划</view><text class="field-help">登记账单日和实际还款日期</text></view><switch checked="{{reminderEnabled}}" color="#1764D9" bindchange="toggleReminder" aria-label="设置还款计划" /></view>
      <block wx:if="{{reminderEnabled}}">
        <view class="field"><text class="field-label">账单</text><picker range="{{billingChoices}}" range-key="label" value="{{billingIndex}}" bindchange="changeBilling"><view class="select-input"><text>{{billingChoices[billingIndex].label}}</text><text>⌄</text></view></picker><text wx:if="{{errors.billingAccountId}}" class="field-error">{{errors.billingAccountId}}</text></view>
        <view wx:if="{{billingIndex > 0}}" class="sharing-note">{{sharingNote}}</view>
        <block wx:else>
          <view class="field"><text class="field-label">每月账单日</text><picker range="{{days}}" value="{{statementDay ? statementDay - 1 : 0}}" bindchange="changeStatement"><view class="select-input"><text class="{{statementDay ? '' : 'placeholder'}}">{{statementDay ? '每月 ' + statementDay + ' 日' : '请选择账单日'}}</text><text>⌄</text></view></picker><text wx:if="{{errors.statementDay}}" class="field-error">{{errors.statementDay}}</text></view>
          <view class="field"><text class="field-label">本期实际还款日期</text><picker mode="date" value="{{dueOn}}" bindchange="changeDueDate"><view class="select-input"><text class="{{dueOn ? '' : 'placeholder'}}">{{dueOn || '按银行账单选择日期'}}</text><text>⌄</text></view></picker><text wx:if="{{errors.dueOn}}" class="field-error">{{errors.dueOn}}</text></view>
          <button class="cycle-summary" bindtap="toggleCycle" aria-expanded="{{showCycle}}"><view><text>后续每期</text><view class="cycle-value">{{dueDay ? offsets[dueMonthOffset] + ' ' + dueDay + ' 日还款' : '选择本期日期后设置'}}</view></view><text class="cycle-edit">{{showCycle ? '收起' : '调整'}}</text></button>
          <view wx:if="{{showCycle}}" class="cycle-fields"><view class="field"><text class="field-label">还款月份</text><picker range="{{offsets}}" value="{{dueMonthOffset}}" bindchange="changeOffset"><view class="select-input"><text>{{offsets[dueMonthOffset]}}</text><text>⌄</text></view></picker><text wx:if="{{errors.dueMonthOffset}}" class="field-error">{{errors.dueMonthOffset}}</text></view><view class="field"><text class="field-label">常规还款日</text><picker range="{{days}}" value="{{dueDay ? dueDay - 1 : 0}}" bindchange="changeDueDay"><view class="select-input"><text>{{dueDay ? dueDay + ' 日' : '请选择'}}</text><text>⌄</text></view></picker><text wx:if="{{errors.dueDay}}" class="field-error">{{errors.dueDay}}</text></view><text class="field-help">遇到不足该天数的月份，取当月最后一天；仍可按实际账单修正。</text></view>
          <view class="field"><text class="field-label">提前提醒</text><picker range="{{remindLabels}}" value="{{remindIndex}}" bindchange="changeRemind"><view class="select-input"><text>{{remindLabels[remindIndex]}}</text><text>⌄</text></view></picker><text wx:if="{{errors.remindDays}}" class="field-error">{{errors.remindDays}}</text></view>
          <view class="sharing-note">{{independentNote}}</view>
        </block>
        <view class="notification-note">这里会生成站内还款待办。微信通知需在“我的”中订阅，以实际授权结果为准。</view>
      </block>
    </view>
    <button wx:if="{{editing}}" class="remove-button" loading="{{removing}}" disabled="{{saving || removing}}" bindtap="remove">移除此卡</button>
  </block>
</view>
<view wx:if="{{!loading && !failed}}" class="bottom-bar"><button class="primary save-button" loading="{{saving}}" disabled="{{saving || removing}}" bindtap="save">保存卡片</button></view>
