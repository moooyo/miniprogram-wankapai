page{background:#F3F6FB;color:#0F1B2D;font-family:"PingFang SC","Microsoft YaHei",sans-serif}button{margin:0;padding:0;line-height:1.4;border:0}button::after{border:0}button[disabled]{opacity:.5}button:active{opacity:.8}
