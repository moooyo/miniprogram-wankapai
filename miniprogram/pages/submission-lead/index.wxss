color:#B8392C}.rule-error{padding-bottom:16px}.status-notice,.return-notice,.error-banner{padding:12px 14px;border-radius:14px;background:#E6EEFC;color:#1A56C4;display:flex;flex-direction:column;gap:4px;font-size:13px;line-height:1.5;word-break:break-word}.return-notice{background:#FDF1DE;color:#9A5B07}.error-banner{background:#FFF1EF;color:#B8392C}.notice-title{font-weight:600}.text-button{min-height:44px;background:transparent;color:#1A56C4;font-size:13px;display:flex;align-items:center;justify-content:center}.lead-dock{position:fixed;bottom:0;left:0;right:0;display:flex;gap:10px;padding:12px 16px max(34px, env(safe-area-inset-bottom));background:#FFFFFF;border-top:1px solid #E3E9F2;z-index:10;box-sizing:border-box}button.primary-button,button.secondary-button{display:flex;align-items:center;justify-content:center;height:50px;border-radius:14px;font-size:16px;font-weight:600;box-sizing:border-box;min-height:50px}.primary-button{flex:1;background:#1F61D8;color:#FFFFFF}button.secondary-button{width:112px;flex:none;background:#EEF3FA;color:#0F1B2D;font-size:15px;font-weight:500}.loading{padding:32px 0;font-size:13px;text-align:center;color:#5E6E84}.empty-state{padding:32px 16px;text-align:center;background:#FFFFFF;border:1px solid #E3E9F2;border-radius:18px}.empty-title{display:block;font-size:19px;font-weight:600}.small-copy{display:block;margin-top:8px;font-size:13px;color:#5E6E84;line-height:1.55}
