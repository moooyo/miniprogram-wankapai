page { background:var(--page); color:var(--ink); }
.review-page { padding:0 16px 28px; }
.review-heading { display:flex; flex-direction:column; gap:10px; padding-bottom:12px; }
.page-description { display:block; color:var(--muted); font-size:13px; line-height:1.55; }
.review-heading .page-description { padding:0 4px; }
.tabs { display:flex; padding:3px; border-radius:13px; background:var(--sunk); }
button.tab { flex:1; min-width:0; height:38px; min-height:38px; padding:0; border-radius:10px; background:transparent; color:var(--muted); font-size:14px; font-weight:500; }
button.tab.active { background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(15,35,70,.14); }
.review-list { display:flex; flex-direction:column; gap:12px; }
.review-list.is-session-pending { visibility:hidden; }
.review-row { overflow:hidden; border:1px solid var(--line); border-radius:18px; background:var(--surface); }
.card-content { display:flex; flex-direction:column; gap:8px; padding:14px; }
.row-top { display:flex; align-items:center; gap:8px; }
.bank-logo { flex:none; width:22px; height:22px; padding:2px; border:1px solid var(--sunk); border-radius:50%; background:var(--surface); }
.bank-name { flex:1; min-width:0; color:var(--ink2); font-size:13px; }
.date-label { flex:none; color:var(--muted); font-size:12px; font-variant-numeric:tabular-nums; }
.submission-title { display:block; color:var(--ink); font-size:16px; font-weight:600; line-height:1.35; }
.source-type { display:block; color:var(--muted); font-size:12px; line-height:1.5; }
.review-content { display:flex; flex-direction:column; gap:10px; padding:0 14px 14px; }
.source-panel { display:flex; flex-direction:column; gap:8px; padding:10px 12px; border-radius:12px; background:var(--page); }
.source-row { display:flex; align-items:flex-start; gap:8px; font-size:13px; line-height:1.5; }
.source-link-row { align-items:center; }
.source-label { flex:none; width:30px; color:var(--muted); }
.source-url { flex:1; min-width:0; overflow:hidden; color:var(--ink); font-size:12px; white-space:nowrap; text-overflow:ellipsis; font-family:"DM Mono","SFMono-Regular",Consolas,"PingFang SC",monospace; }
.source-note { flex:1; min-width:0; color:var(--ink); overflow-wrap:anywhere; }
button.copy-link { flex:none; height:20px; min-height:20px; padding:0; border-radius:4px; background:transparent; color:var(--primary-text); font-size:13px; font-weight:500; }
.screenshot-scroll { flex:1; min-width:0; width:0; height:64px; white-space:nowrap; }
.screenshots { display:inline-flex; gap:6px; height:64px; padding-right:1px; }
button.screenshot-button { flex:none; width:48px; height:64px; min-height:64px; overflow:hidden; padding:0; border:1px solid var(--line); border-radius:8px; background:var(--surface); }
.screenshot { display:block; width:46px; height:62px; }
.inline-rules { display:flex; flex-direction:column; gap:8px; }
.rules-title { display:block; color:var(--ink2); font-size:12px; font-weight:600; }
.inline-field { display:flex; flex-direction:column; gap:8px; }
.field-label { display:block; color:var(--muted); font-size:12px; line-height:1.5; }
.pills { display:flex; flex-wrap:wrap; gap:6px; }
button.pill { flex:none; height:32px; min-height:32px; padding:0 11px; border:1px solid var(--line); border-radius:999px; background:var(--surface); color:var(--ink2); font-size:13px; font-weight:400; white-space:nowrap; }
button.pill.selected { border-color:var(--brand); background:var(--brand); color:#FFFFFF; }
.reward-input { display:flex; align-items:center; gap:8px; height:44px; padding:0 12px; border:1.5px solid var(--line); border-radius:10px; background:var(--page); }
.reward-input label { flex:none; color:var(--muted); font-size:13px; }
.reward-input input { flex:1; min-width:0; height:40px; padding:0; background:transparent; color:var(--ink); font-family:"DM Mono","SFMono-Regular",Consolas,"PingFang SC",monospace; font-size:16px; font-weight:500; text-align:right; }
.reward-placeholder { color:var(--placeholder); }
.reward-unit { flex:none; color:var(--ink2); font-size:13px; }
.cycle-field { padding-top:4px; }
.cycle-control { display:flex; padding:3px; border-radius:11px; background:var(--sunk); }
button.cycle-option { flex:1; min-width:0; height:32px; min-height:32px; padding:0; border-radius:8px; background:transparent; color:var(--muted); font-size:13px; font-weight:500; }
button.cycle-option.selected { background:var(--surface); color:var(--ink); box-shadow:0 1px 3px rgba(15,35,70,.14); }
.weekdays { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:4px; }
button.weekday { min-width:0; height:32px; min-height:32px; padding:0; border:1px solid var(--line); border-radius:8px; background:var(--surface); color:var(--ink2); font-size:13px; font-weight:400; }
button.weekday.selected { border-color:var(--brand); background:var(--brand); color:#FFFFFF; }
.stepper-row,.interval-row { display:flex; align-items:center; gap:8px; color:var(--ink2); font-size:13px; }
.stepper-label { flex:1; min-width:0; }
.stepper { display:flex; align-items:center; gap:8px; }
button.stepper-button { flex:none; width:34px; height:34px; min-height:34px; padding:0; border-radius:10px; background:var(--soft); color:var(--primary-text); }
button.stepper-button:active:not([disabled]) { background:#E2E9F3; opacity:1; }
.minus-icon,.plus-icon { position:relative; width:14px; height:14px; }
.minus-icon::before,.plus-icon::before { position:absolute; top:6px; left:1px; width:12px; height:2px; border-radius:2px; background:var(--primary-text); content:""; }
.plus-icon::after { position:absolute; top:1px; left:6px; width:2px; height:12px; border-radius:2px; background:var(--primary-text); content:""; }
.stepper-value { min-width:64px; color:var(--ink); font-size:14px; font-weight:500; text-align:center; white-space:nowrap; font-variant-numeric:tabular-nums; }
.stepper-value.custom-value { min-width:80px; }
.interval-row { gap:6px; }
.interval-pills { flex:none; }
.interval-pills button.pill { min-width:44px; padding:0 10px; }
.cycle-preview,.ocr-hint { display:block; color:var(--primary-text); font-size:12px; line-height:1.5; }
.dates-field { display:flex; gap:8px; padding-top:4px; }
.date-picker { flex:1; min-width:0; }
.date-field { display:flex; flex-direction:column; justify-content:center; gap:2px; height:54px; padding:0 10px; border:1.5px solid var(--line); border-radius:10px; background:var(--page); }
.date-value { display:flex; align-items:center; justify-content:space-between; gap:4px; color:var(--ink); font-family:"DM Mono","SFMono-Regular",Consolas,"PingFang SC",monospace; font-size:13px; line-height:1.5; }
.date-placeholder { color:var(--placeholder); font-family:"PingFang SC","Noto Sans SC",sans-serif; }
.date-picker[disabled] { opacity:.55; }
.chevron { flex:none; color:var(--muted); font-family:inherit; font-size:19px; line-height:1; }
.full-rules-row { display:flex; flex-direction:column; align-items:flex-start; gap:2px; padding-top:2px; }
.missing-copy,.complete-copy,.draft-notice { display:block; color:var(--muted); font-size:12px; line-height:1.5; }
button.inline-link { min-height:28px; height:auto; padding:0; border-radius:4px; background:transparent; color:var(--primary-text); font-size:12px; font-weight:500; }
.verification-row { display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:12px; background:var(--page); }
.verification-label { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
.verification-title { display:block; color:var(--ink2); font-size:13px; font-weight:500; line-height:1.5; }
.verification-description { display:block; color:var(--muted); font-size:12px; line-height:1.5; }
.verification-row switch { flex:none; transform:scale(.78); transform-origin:right center; margin-left:-8px; }
.conflict-notice { display:flex; flex-direction:column; align-items:flex-start; gap:4px; padding:8px 12px; border-radius:10px; background:var(--warning-bg); color:var(--warning); font-size:13px; line-height:1.5; }
.row-error { display:block; color:var(--danger); font-size:13px; line-height:1.5; }
.review-actions { display:flex; gap:10px; padding-top:2px; }
button.return-button { flex:none; width:96px; height:46px; min-height:46px; padding:0; border-radius:12px; background:var(--soft); color:var(--ink); font-size:15px; font-weight:500; }
button.return-button:active:not([disabled]) { background:#E2E9F3; opacity:1; }
button.publish-button { flex:1; min-width:0; height:46px; min-height:46px; padding:0; border-radius:12px; background:var(--brand); color:#FFFFFF; font-size:15px; font-weight:600; }
button.publish-button[disabled] { background:#C5D0DF; opacity:1; }
.result-content { display:flex; flex-direction:column; gap:10px; padding:0 14px 14px; }
.review-note { display:block; padding:10px 12px; border-radius:12px; background:var(--warning-bg); color:var(--warning); font-size:13px; line-height:1.5; }
.published-note { padding:10px 12px; border-radius:12px; background:var(--success-bg); color:var(--success); font-size:13px; font-weight:500; }
button.result-link { align-self:flex-end; display:flex; align-items:center; justify-content:center; gap:6px; min-height:36px; padding:0 12px; border-radius:12px; background:var(--tint); color:var(--primary-text); font-size:13px; font-weight:500; }
.result-link .chevron { color:var(--primary-text); }
button.text-button { min-height:44px; padding:0 12px; border-radius:12px; background:transparent; color:var(--primary-text); font-size:14px; }
button.more-button { width:100%; margin-top:12px; }
.empty { display:flex; flex-direction:column; align-items:center; gap:10px; padding:28px 16px; border:1px dashed var(--control-border); border-radius:18px; text-align:center; }
.empty-art { display:flex; align-items:center; justify-content:center; width:92px; height:92px; border:1.5px dashed var(--control-border); border-radius:50%; background:var(--soft); }
.document-icon { position:relative; width:32px; height:40px; padding:9px 6px; border:2px solid var(--placeholder); border-radius:6px; }
.document-line { height:2px; margin-bottom:5px; border-radius:2px; background:var(--placeholder); }
.document-line.short { width:12px; }
.document-check { position:absolute; right:-7px; bottom:-3px; width:16px; height:16px; border:2px solid var(--soft); border-radius:50%; background:var(--brand); }
.document-check::after { position:absolute; left:3px; top:3px; width:6px; height:3px; border-left:1.5px solid #FFFFFF; border-bottom:1.5px solid #FFFFFF; transform:rotate(-45deg); content:""; }
.empty-title { display:block; color:var(--ink); font-size:16px; font-weight:600; line-height:1.4; }
.permission-empty { margin-top:4px; }
.error { display:block; margin-bottom:12px; padding:12px 14px; border:1px solid #F1C7C1; border-radius:14px; background:#FFF2F0; color:var(--danger); font-size:13px; line-height:1.6; }
.error .text-button { margin-top:8px; }
.error .page-description { margin-top:4px; }
.more-error { margin-top:12px; }
.loading { padding:28px 16px; border:1px solid var(--line); border-radius:18px; background:var(--surface); color:var(--muted); font-size:13px; text-align:center; }
.refresh-notice,.refresh-copy { display:block; font-size:13px; line-height:1.6; }
.refresh-notice { margin-bottom:12px; padding:0 4px; color:var(--muted); }
.refresh-copy { margin-top:6px; }
.return-sheet { display:flex; flex-direction:column; gap:12px; }
.return-title { display:block; color:var(--ink); font-size:15px; font-weight:600; line-height:1.5; }
.return-description { display:block; color:var(--muted); font-size:13px; line-height:1.55; }
.return-reasons { gap:8px; }
.return-reasons button.pill { height:34px; min-height:34px; }
.return-note-label { color:var(--ink2); font-size:13px; font-weight:500; }
.return-note-input { width:100%; min-height:96px; padding:10px 12px; border:1.5px solid var(--line); border-radius:12px; background:var(--page); color:var(--ink); font-size:14px; line-height:1.55; }
.return-placeholder { color:var(--placeholder); }
.return-sheet-actions { display:flex; gap:10px; padding-top:4px; }
button.sheet-cancel,button.sheet-confirm { flex:1; min-width:0; height:46px; min-height:46px; padding:0; border-radius:12px; font-size:15px; }
button.sheet-cancel { background:var(--soft); color:var(--ink); }
button.sheet-confirm { background:var(--brand); color:#FFFFFF; font-weight:600; }
