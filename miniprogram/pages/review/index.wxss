.review-page{padding:24px 20px 32px;color:var(--ink,#172638)}.page-heading{margin-bottom:20px}.page-title{display:block;font-size:25px;font-weight:650;line-height:1.4}.page-description{display:block;font-size:14px;color:var(--muted,#647084);line-height:1.6;margin-top:6px}.tabs{display:flex;gap:8px;margin-bottom:16px;border-bottom:1px solid var(--line,#e5eaf1)}.tab{margin:0;padding:0 16px;min-height:48px;display:flex;align-items:center;justify-content:center;font-size:15px;background:transparent;color:var(--muted,#647084);border-radius:0;border-bottom:2px solid transparent}.tab.active{color:var(--blue,#165dcc);border-bottom-color:var(--blue,#165dcc);font-weight:600}.tab[disabled]{background:transparent}.tab::after,.review-row::after,.text-button::after{border:0}.review-list{background:var(--surface,#fff);border-radius:12px;padding:0 16px}button.review-row{display:block;width:100%;margin:0;padding:20px 0;border-radius:0;border-bottom:1px solid var(--line,#e5eaf1);background:transparent;text-align:left;line-height:1.5;font-weight:400}.review-row:last-child{border-bottom:0}.review-row:active{opacity:.65}.row-top,.row-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px}.row-top{font-size:14px;color:var(--muted,#647084)}.submission-title{display:block;font-size:18px;font-weight:600;color:var(--ink,#172638);margin:10px 0 8px;line-height:1.45}.conditions{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:14px;color:var(--muted,#647084);line-height:1.6}.review-note{display:block;padding:10px 12px;background:#fff6ea;border-radius:6px;margin-top:12px;color:#874311;font-size:14px;line-height:1.6}.row-bottom{margin-top:12px;font-size:14px;color:var(--blue,#165dcc)}.chevron{font-size:22px;line-height:1}.text-button{min-height:48px;display:flex;align-items:center;justify-content:center;background:transparent;color:var(--blue,#165dcc);font-size:14px}.empty{padding:32px 16px;text-align:center;background:var(--surface,#fff);border-radius:12px}.empty-title{display:block;font-size:19px;font-weight:600}.error{padding:12px 16px;background:#fff3f1;color:#9c3429;border-radius:8px;font-size:14px;line-height:1.6;margin-bottom:16px}.loading{padding:32px 0;color:var(--muted,#647084);font-size:14px}
.refresh-notice,.refresh-copy{display:block;font-size:14px;line-height:1.6}.refresh-notice{margin-bottom:16px;color:var(--muted,#626f82)}.refresh-copy{margin-top:8px}
.review-list.is-session-pending{visibility:hidden}
