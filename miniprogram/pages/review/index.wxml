<view class="review-page">
  <view class="page-heading"><text class="page-title">活动审核</text><text class="page-description">核对原始出处与参与入口，再决定是否公开。</text></view>
  <view wx:if="{{denied}}" class="empty"><text class="empty-title">此账号没有审核权限</text><text class="page-description">运营权限由账号授权决定。</text><button class="text-button" bindtap="goBack">返回</button></view>
  <block wx:else>
    <view class="tabs"><button class="tab {{status === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="changeStatus" disabled="{{loading}}" aria-pressed="{{status === 'pending'}}">待审核</button><button class="tab {{status === 'returned' ? 'active' : ''}}" data-status="returned" bindtap="changeStatus" disabled="{{loading}}" aria-pressed="{{status === 'returned'}}">已退回</button><button class="tab {{status === 'published' ? 'active' : ''}}" data-status="published" bindtap="changeStatus" disabled="{{loading}}" aria-pressed="{{status === 'published'}}">已发布</button></view>
    <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view>
    <view wx:if="{{loading}}" class="loading">正在读取投稿…</view>
    <view wx:elif="{{!items.length}}" class="empty"><text class="empty-title">{{status === 'pending' ? '没有待审核投稿' : status === 'returned' ? '没有退回的投稿' : '还没有已发布投稿'}}</text><text class="page-description">{{status === 'pending' ? '新的活动线索会出现在这里。' : '处理结果会保留在这里，便于核查。'}}</text></view>
    <view wx:else class="review-list">
      <button wx:for="{{items}}" wx:key="id" class="review-row" bindtap="open" data-id="{{item.id}}"><view class="row-top"><text>{{item.bankName}}</text><text>{{item.dateLabel}}</text></view><text class="submission-title">{{item.draft.title}}</text><text class="conditions">{{item.draft.conditions}}</text><text wx:if="{{status === 'returned'}}" class="review-note">{{item.reviewNote}}</text><view class="row-bottom"><text>{{status === 'pending' ? '核实与审核' : '查看处理结果'}}</text><text class="chevron" aria-hidden="true">›</text></view></button>
    </view>
    <button wx:if="{{nextCursor}}" class="text-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
  </block>
</view>
