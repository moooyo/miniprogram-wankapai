<design-nav title="提醒设置" back />
<view class="preferences-page">
  <text class="page-description">修改后请保存，站内待办将持续保留。</text>
  <view wx:if="{{error}}" class="error" role="alert"><text>{{error}}</text><button wx:if="{{!ready && !loading}}" class="text-button" bindtap="load" hover-class="tap-soft">重试</button></view>
  <view wx:if="{{loading}}" class="loading" role="status">正在读取设置…</view>
  <block wx:elif="{{ready}}">
    <view class="settings-group">
      <button class="setting-row" data-field="newActivities" bindtap="toggle" disabled="{{saving}}" aria-label="匹配到新活动提醒" aria-pressed="{{newActivities}}" hover-class="tap-soft">
        <view class="setting-copy"><text class="setting-title">匹配到新活动</text><text class="setting-description">按卡包中的银行与卡片条件匹配</text></view>
        <view class="setting-switch {{newActivities ? 'is-on' : ''}}" aria-hidden="true"><view class="switch-thumb"></view></view>
      </button>
      <button class="setting-row" data-field="deadlines" bindtap="toggle" disabled="{{saving}}" aria-label="活动即将截止提醒" aria-pressed="{{deadlines}}" hover-class="tap-soft">
        <view class="setting-copy"><text class="setting-title">活动即将截止</text><text class="setting-description">已加入且本期未完成的活动</text></view>
        <view class="setting-switch {{deadlines ? 'is-on' : ''}}" aria-hidden="true"><view class="switch-thumb"></view></view>
      </button>
      <button class="setting-row" data-field="rewards" bindtap="toggle" disabled="{{saving}}" aria-label="返现待到账提醒" aria-pressed="{{rewards}}" hover-class="tap-soft">
        <view class="setting-copy"><text class="setting-title">返现待到账</text><text class="setting-description">按预计到账日提醒确认</text></view>
        <view class="setting-switch {{rewards ? 'is-on' : ''}}" aria-hidden="true"><view class="switch-thumb"></view></view>
      </button>
      <button class="setting-row" data-field="repayments" bindtap="toggle" disabled="{{saving}}" aria-label="信用卡还款提醒" aria-pressed="{{repayments}}" hover-class="tap-soft">
        <view class="setting-copy"><text class="setting-title">信用卡还款</text><text class="setting-description">按账单还款日发送微信提醒，需单独授权</text></view>
        <view class="setting-switch {{repayments ? 'is-on' : ''}}" aria-hidden="true"><view class="switch-thumb"></view></view>
      </button>
    </view>
    <view class="note">
      <button class="note-toggle" bindtap="toggleHelp" aria-expanded="{{helpExpanded}}" aria-controls="reminder-help" hover-class="tap-soft"><text>如何开启微信提醒</text><text class="disclosure" aria-hidden="true">{{helpExpanded ? '−' : '+'}}</text></button>
      <text class="note-summary">保存后，还需在活动或账单中单独授权。</text>
      <view wx:if="{{helpExpanded}}" id="reminder-help" class="note-content">
        <text class="note-copy">还款提醒：开启「信用卡还款」并保存后，在卡包对应账单中点击「开启本期微信提醒」。每期需重新授权。</text>
        <text class="note-copy">新活动提醒在活动页开启；截止与到账提醒在具体活动中开启。演示模式不会发送消息。</text>
        <text class="note-copy">还款日期以银行账单为准，提醒不替代银行通知。</text>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{ready && !loading}}" class="preferences-dock">
  <text class="save-status {{saved ? 'saved-message' : dirty ? 'dirty-message' : ''}}" role="status">{{saving ? '正在保存提醒设置…' : saved ? '提醒设置已保存' : dirty ? '设置已修改，保存后生效' : '每条微信消息仍需单独授权'}}</text>
  <button class="primary-button" bindtap="save" loading="{{saving}}" disabled="{{saving || !dirty}}" hover-class="tap-primary">{{saving ? '正在保存' : '保存设置'}}</button>
</view>
