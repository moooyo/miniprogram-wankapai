.preferences-page{padding:24px 20px calc(144px + env(safe-area-inset-bottom));color:var(--ink,#172638)}
.page-heading{margin-bottom:24px}.page-title{display:block;font-size:25px;font-weight:650;line-height:1.4}.page-description{display:block;font-size:14px;color:var(--muted,#647084);line-height:1.6;margin-top:6px}
.settings-group{padding:0 16px;background:var(--surface,#fff);border-radius:12px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 0;border-bottom:1px solid var(--line,#e5eaf1)}.setting-row:last-child{border-bottom:0}.setting-copy{display:flex;flex-direction:column;gap:6px;flex:1;min-width:0}.setting-title{font-size:17px}.setting-description{font-size:14px;color:var(--muted,#647084);line-height:1.6}.setting-row switch{flex:none}
.note{padding:16px 4px}.note-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;margin:0;padding:8px 0;background:transparent;color:var(--ink,#172638);font-size:15px;font-weight:600;line-height:1.5;text-align:left}.disclosure{flex:none;color:var(--blue,#165dcc);font-size:22px}.note-summary,.note-copy{display:block;color:var(--muted,#647084);font-size:14px;line-height:1.7}.note-content{padding-top:4px}.note-copy{margin-top:12px}
.preferences-dock{position:fixed;bottom:0;left:0;right:0;padding:8px max(20px, calc((100vw - 680px) / 2)) calc(12px + env(safe-area-inset-bottom));background:var(--surface,#fff);border-top:1px solid var(--line,#e5eaf1);z-index:10}.save-status{display:block;margin-bottom:8px;color:var(--muted,#647084);font-size:14px;line-height:1.5;text-align:center}.saved-message{color:var(--blue,#165dcc)}
button.primary-button{width:100%;background:var(--blue,#165dcc);color:#fff;min-height:48px;margin:0;padding:12px 16px;line-height:1.5;display:flex;align-items:center;justify-content:center;font-size:16px;border-radius:8px}.primary-button::after,.text-button::after,.note-toggle::after{border:0}.primary-button[disabled]{background:#dde5f1;color:#657389}.text-button{background:transparent;color:var(--blue,#165dcc);min-height:48px;font-size:14px}
.error{padding:12px 16px;background:#fff3f1;color:#9c3429;border-radius:8px;font-size:14px;line-height:1.6;margin-bottom:16px}.loading{padding:32px 0;color:var(--muted,#647084);font-size:14px}
@media(max-width:350px){.preferences-page{padding-left:16px;padding-right:16px}.preferences-dock{padding-left:16px;padding-right:16px}}
