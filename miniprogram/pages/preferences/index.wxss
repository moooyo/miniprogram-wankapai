page{background:#F3F6FB;color:#0F1B2D}
.preferences-page{padding:4px 16px calc(110px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:12px;font-family:'PingFang SC','Microsoft YaHei',sans-serif}
.page-description{display:block;padding:0 4px;font-size:13px;color:#5E6E84;line-height:1.5}
.settings-group{background:#FFFFFF;border:1px solid #E3E9F2;border-radius:18px;overflow:hidden}
button.setting-row{display:flex;align-items:center;gap:12px;width:100%;min-height:68px;padding:12px 14px 12px 16px;margin:0;box-sizing:border-box;border-top:1px solid #E3E9F2;background:#FFFFFF;border-radius:0;text-align:left;line-height:1.45}
button.setting-row:first-child{border-top:0}
.setting-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.setting-title{font-size:15px;font-weight:500;color:#0F1B2D}
.setting-description{font-size:12px;line-height:1.45;color:#5E6E84}
.setting-switch{position:relative;flex:none;width:44px;height:26px;border-radius:13px;background:#C5D0DF;transition:background .2s}
.switch-thumb{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:#FFFFFF;box-shadow:0 1px 3px rgba(15,35,70,.3);transition:transform .2s}
.setting-switch.is-on{background:#1F61D8}
.setting-switch.is-on .switch-thumb{transform:translateX(18px)}
.setting-row[disabled]{opacity:.6}
.note{padding:0 16px;background:#FFFFFF;border:1px solid #E3E9F2;border-radius:18px}
.note-toggle{display:flex;align-items:center;gap:12px;width:100%;min-height:50px;padding:0;margin:0;border-radius:0;background:transparent;color:#0F1B2D;text-align:left;font-size:14px;font-weight:500;line-height:1.5}
.note-toggle>text:first-child{flex:1;min-width:0}
.disclosure{flex:none;font-family:'DM Mono',monospace;font-size:18px;color:#1A56C4}
.note-summary{display:block;padding-bottom:12px;font-size:12px;color:#5E6E84;line-height:1.5}
.note-content{display:flex;flex-direction:column;gap:8px;padding-bottom:14px}
.note-copy{display:block;font-size:13px;color:#3F4D63;line-height:1.6}
.preferences-dock{position:fixed;bottom:0;left:0;right:0;z-index:10;display:flex;align-items:center;gap:12px;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:#FFFFFF;border-top:1px solid #E3E9F2}
.save-status{flex:1;min-width:0;font-size:12px;color:#5E6E84;line-height:1.5}
.saved-message{color:#176B4B}
.dirty-message{color:#9A5B07}
button.primary-button{display:flex;align-items:center;justify-content:center;flex:none;min-width:104px;min-height:46px;height:46px;padding:0 22px;margin:0;border-radius:14px;background:#1F61D8;color:#FFFFFF;font-size:15px;font-weight:600;line-height:1.5}
.primary-button[disabled]{background:#C5D0DF;color:#FFFFFF}
.text-button{display:flex;align-items:center;justify-content:center;min-height:44px;margin:12px 0 0;background:#E6EEFC;color:#1A56C4;font-size:14px;border-radius:12px}
.error{padding:12px 14px;background:#FBE4E1;color:#B8392C;border-radius:12px;font-size:13px;line-height:1.6}
.loading{padding:28px 4px;color:#5E6E84;font-size:13px;line-height:1.5}
.primary-button::after,.text-button::after,.note-toggle::after,.setting-row::after{border:0}
.tap-soft{background:#F4F7FC!important}
.tap-primary{background:#1A56C4!important}
@media (prefers-reduced-motion:reduce){.setting-switch,.switch-thumb{transition:none}}
