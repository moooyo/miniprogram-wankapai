.preferences-page{padding:24px 20px calc(32px + env(safe-area-inset-bottom));color:var(--ink,#172638)}.page-heading{margin-bottom:24px}.page-title{display:block;font-size:25px;font-weight:650;line-height:1.4}.page-description{display:block;font-size:14px;color:var(--muted,#647084);line-height:1.6;margin-top:6px}.settings-group{padding:0 16px;background:var(--surface,#fff);border-radius:12px}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 0;border-bottom:1px solid var(--line,#e5eaf1)}.setting-row:last-child{border-bottom:0}.setting-copy{display:flex;flex-direction:column;gap:6px;flex:1}.setting-title{font-size:17px}.setting-description{font-size:13px;color:var(--muted,#647084);line-height:1.6}.setting-row switch{flex:none}.note{padding:24px 4px}.note-title{display:block;font-size:15px;font-weight:600;margin-bottom:8px}.note-copy{display:block;color:var(--muted,#647084);font-size:13px;line-height:1.7;margin-top:8px}button.primary-button{background:var(--blue,#165dcc);color:#fff;min-height:48px;padding:12px 16px;line-height:1.5;display:flex;align-items:center;justify-content:center;font-size:16px;border-radius:8px;margin-top:8px}.primary-button::after,.text-button::after{border:0}.primary-button[disabled]{background:#dde5f1;color:#657389}.text-button{background:transparent;color:var(--blue,#165dcc);min-height:48px;font-size:14px}.saved-message{display:block;color:var(--blue,#165dcc);font-size:14px;text-align:center;margin-bottom:12px}.error{padding:12px 16px;background:#fff3f1;color:#9c3429;border-radius:8px;font-size:14px;line-height:1.6;margin-bottom:16px}.loading{padding:32px 0;color:var(--muted,#647084);font-size:14px}
