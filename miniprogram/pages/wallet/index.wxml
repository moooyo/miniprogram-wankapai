<view class="page wallet-page">
  <view class="page-heading row-between"><view><view class="heading">卡包</view><text class="text-muted wallet-count">{{cardCount}} 张卡 · {{bankCount}} 家银行</text></view><button class="text-button" bindtap="addCard">添加卡片</button></view>
  <view class="benefits-entry">
    <button class="benefits-primary" bindtap="openEntitlements" disabled="{{!!busyId || !!reminderBusyId}}"><text class="benefits-title">当前持有权益</text><text class="benefits-caption">贵宾厅、体检等 · 查看剩余次数</text></button>
    <button class="benefits-airports" bindtap="openLounges" disabled="{{!!busyId || !!reminderBusyId}}">按机场查贵宾厅<text aria-hidden="true"> ›</text></button>
  </view>
  <view wx:if="{{refreshing || refreshError}}" class="refresh-notice" role="status"><text>{{refreshing ? '正在更新卡包，已读记录仍然保留…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="load">重新刷新</button></view>
  <view class="loading text-muted" wx:if="{{loading}}">正在更新卡包…</view>
  <view class="empty" wx:elif="{{failed}}"><view class="empty-title">卡包暂时无法加载</view><button class="secondary" bindtap="load">重试</button></view>
  <block wx:else>
    <view wx:if="{{namingCards.length}}" class="naming-notice">
      <view class="naming-title">给卡片设置容易区分的昵称</view>
      <text class="naming-help">有 {{namingCards.length}} 张卡需要补充或调整昵称。可以按卡面名称或用途命名，参加活动时更容易选对卡。</text>
      <view wx:for="{{namingCards}}" wx:key="id" wx:for-item="card" class="naming-row">
        <view class="naming-card"><view class="member-title">{{card.title}}</view><text class="member-description">{{card.issuer || card.bank}}</text></view>
        <button class="text-button" data-id="{{card.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" aria-label="为{{card.title}}设置昵称">设置昵称</button>
      </view>
    </view>
    <view wx:if="{{groups.length}}" class="section-heading">还款计划</view>
    <view class="account-group" wx:for="{{groups}}" wx:key="id" wx:for-item="group">
      <view wx:if="{{group.archived}}" class="archived-label">{{group.settledArchive ? '已归档账户历史' : '已归档账户待还'}}</view>
      <view class="account-head"><image class="bank-logo" src="{{group.logo}}" mode="aspectFit" /><view class="account-info"><view class="account-title">{{group.title}}</view><text wx:if="{{group.identity}}" class="account-identity">{{group.identity}}</text><text class="account-subtitle">{{group.subtitle}}</text></view><button class="account-settings" data-id="{{group.id}}" bindtap="toggleGroup" aria-expanded="{{group.expanded}}">{{group.expanded ? '收起' : group.settledArchive ? '历史账单' : group.otherBills.length ? '更多账单' : '账单设置'}}<text aria-hidden="true">{{group.expanded ? '⌃' : '⌄'}}</text></button></view>
      <view wx:if="{{!group.reminderAvailable && !group.settledArchive}}" class="schedule bill-main">账户已停用，历史账单不再提供微信提醒；仍可标记还款和修改日期。</view>
      <view wx:if="{{group.primaryBill && (!group.settledArchive || group.expanded)}}" class="bill-main">
        <view class="row-between bill-date-row"><view><view class="due-date {{group.primaryBill.late ? 'late' : ''}}">{{group.primaryBill.dateLabel}}</view><text class="bill-status">{{group.primaryBill.period}} · {{group.primaryBill.paid ? '已标记还款' : group.primaryBill.late ? '登记的还款日已过' : '还款日'}}</text></view><button class="{{group.primaryBill.paid ? 'small-secondary' : 'small-primary'}}" data-id="{{group.primaryBill.id}}" loading="{{busyId === group.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" bindtap="togglePaid">{{group.primaryBill.paid ? '撤销还款' : '标记还款'}}</button></view>
        <button wx:if="{{!group.primaryBill.paid && group.reminderAvailable && !group.primaryBill.reminderExpired}}" class="reminder-button" data-id="{{group.primaryBill.id}}" loading="{{reminderBusyId === group.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" bindtap="requestBillReminder">开启本期微信提醒</button>
        <view wx:elif="{{!group.primaryBill.paid && group.reminderAvailable && group.primaryBill.reminderExpired}}" class="schedule bill-reminder-expired">已逾期，不补发微信提醒；仍可标记还款和修改日期。</view>
        <text wx:if="{{!group.primaryBill.paid && group.reminderAvailable && !group.primaryBill.reminderExpired && reminderNoticeId === group.primaryBill.id}}" class="reminder-notice" role="status">{{reminderNotice}}</text>
      </view>
      <view wx:elif="{{!group.primaryBill}}" class="missing-bill">本期待还款日期尚未生成，可在卡片设置中补充。</view>
      <view wx:if="{{group.expanded}}" class="account-extra">
        <view class="schedule">{{group.statement}}</view>
        <button wx:if="{{group.primaryCardId && !group.archived}}" class="text-button account-edit" data-id="{{group.primaryCardId}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">编辑卡片与账单规则</button>
        <view wx:if="{{group.primaryBill}}" class="row-between bill-meta-row"><text>{{group.primaryBill.period}}账单</text><picker mode="date" value="{{group.primaryBill.dueOn}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" data-id="{{group.primaryBill.id}}" aria-label="{{group.title}}，{{group.identity || group.subtitle}}，{{group.primaryBill.period}}账单还款日期，当前{{group.primaryBill.dueOn}}" bindchange="changeDueDate"><view class="date-edit">修改本期日期</view></picker></view>
        <view wx:if="{{group.cards.length > 1}}" class="members"><view wx:for="{{group.cards}}" wx:key="id" wx:for-item="card" class="member-row"><view><view class="member-title">{{card.title}}</view><text wx:if="{{card.description}}" class="member-description">{{card.description}}</text></view><button class="text-button" data-id="{{card.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">编辑</button></view></view>
        <view class="older-bill" wx:for="{{group.otherBills}}" wx:key="id" wx:for-item="bill"><view class="row-between"><view><view class="member-title">{{bill.dateLabel}}</view><text class="member-description">{{bill.period}} · {{bill.paid ? '已标记还款' : bill.late ? '登记日已过' : '待还款'}}</text></view><button class="text-button" data-id="{{bill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" loading="{{busyId === bill.id}}" bindtap="togglePaid">{{bill.paid ? '撤销还款' : '标记还款'}}</button></view><button wx:if="{{!bill.paid && group.reminderAvailable && !bill.reminderExpired}}" class="reminder-button" data-id="{{bill.id}}" loading="{{reminderBusyId === bill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" bindtap="requestBillReminder">开启本期微信提醒</button><view wx:elif="{{!bill.paid && group.reminderAvailable && bill.reminderExpired}}" class="schedule bill-reminder-expired">已逾期，不补发微信提醒；仍可标记还款和修改日期。</view><text wx:if="{{!bill.paid && group.reminderAvailable && !bill.reminderExpired && reminderNoticeId === bill.id}}" class="reminder-notice" role="status">{{reminderNotice}}</text><picker mode="date" value="{{bill.dueOn}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" data-id="{{bill.id}}" aria-label="{{group.title}}，{{group.identity || group.subtitle}}，{{bill.period}}账单还款日期，当前{{bill.dueOn}}" bindchange="changeDueDate"><view class="date-edit">修改本期日期</view></picker></view>
      </view>
    </view>
    <view wx:if="{{looseCards.length}}" class="section-heading loose-heading">{{groups.length ? '其他卡片' : '我的卡片'}}</view>
    <view class="loose-card" wx:for="{{looseCards}}" wx:key="id"><image class="bank-logo" src="{{item.logo}}" mode="aspectFit" /><view class="account-info"><view class="account-title">{{item.issuer || item.bank}}</view><text class="account-subtitle">{{item.title}}</text><view wx:if="{{item.description}}" class="member-description">{{item.description}}</view><view wx:if="{{item.credit}}" class="member-description">未设置还款计划</view></view><button class="text-button" data-id="{{item.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">编辑</button></view>
    <view class="empty" wx:if="{{!cardCount && !groups.length}}"><view class="empty-title">把常用的卡放进来</view><text class="text-muted">选择银行和卡种，就能筛选适合你的活动。</text><button class="primary" bindtap="addCard">添加第一张卡</button></view>
    <button wx:if="{{cardCount}}" class="browse-mine" bindtap="browseMine">查看我的卡能参加的活动 <text>›</text></button>
    <view class="privacy-note">手动添加，无需卡号。还款以银行账单为准。站内待办会保留；启用账户的微信消息需开启还款偏好，并在具体账单点“开启本期微信提醒”完成每期授权。停用账户的历史账单不提供微信提醒。{{demo ? '演示模式只展示说明，不发送微信消息。' : ''}}</view>
    <button class="text-button reminder-settings" bindtap="openPreferences">查看提醒偏好</button>
  </block>
</view>
