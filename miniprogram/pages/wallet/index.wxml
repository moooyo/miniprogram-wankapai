<design-nav title="卡与权益" />
<view class="page wallet-page" aria-hidden="{{cardSheet}}">
  <view class="wallet-segment"><button class="segment-button {{segment === 'cards' ? 'selected' : ''}}" data-value="cards" bindtap="changeSegment" aria-pressed="{{segment === 'cards'}}">我的卡<text class="segment-count">{{cardCount}}</text></button><button class="segment-button {{segment === 'perks' ? 'selected' : ''}}" data-value="perks" bindtap="changeSegment" aria-pressed="{{segment === 'perks'}}">权益速查<text class="segment-count">{{perkCount}}</text></button></view>
  <view wx:if="{{refreshing || refreshError}}" class="refresh-notice" role="status"><text>{{refreshing ? '正在更新卡包…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="load">重新刷新</button></view>
  <view class="empty" wx:if="{{loading}}">正在更新卡包…</view>
  <view class="empty" wx:elif="{{failed}}"><view class="empty-title">卡包暂时无法加载</view><button class="secondary" bindtap="load">重试</button></view>
  <block wx:elif="{{segment === 'cards'}}">
    <view class="stack-intro"><view class="stack-caption"><text>按还款日排列，点击卡片查看详情</text><text class="repayment-summary">{{pendingBillCount ? pendingBillCount + ' 笔账单尚未标记还款' : cardCount ? cardCount + ' 张卡 · ' + bankCount + ' 家银行' : '手动添加，无需卡号'}}</text></view><button class="add-card" bindtap="addCard"><text class="plus-mark" aria-hidden="true">+</text>添加卡片</button></view>
    <view class="card-stack">
      <view wx:for="{{stackCards}}" wx:key="id" class="stack-card {{index ? 'stacked' : ''}}" style="background-color:{{item.color}}" data-id="{{item.id}}" bindtap="openCard" role="button" aria-label="查看{{item.title}}详情">
        <view class="stack-card-head"><image class="stack-logo" src="{{item.logo}}" mode="aspectFit" /><view class="stack-card-name"><text class="stack-nickname">{{item.title}}</text><text class="stack-bank">{{item.issuer || item.bank}}</text></view><text wx:if="{{item.dueSoon}}" class="due-chip">{{item.dueChip}}</text><text class="stack-kind">{{item.kindLabel}}</text></view>
        <view class="stack-card-bottom"><view class="stack-due"><text class="stack-due-label">{{item.dueLabel}}</text><text class="stack-due-date">{{item.dueAmount}}</text><text class="stack-due-label">{{item.dueDate}} · {{item.activityCount === null ? '' : item.activityCount + ' 个活动 · '}}{{item.perkCount}} 项权益</text></view><text class="stack-network">{{item.network}}</text></view>
      </view>
    </view>
    <view wx:if="{{!cardCount}}" class="empty"><view class="empty-title">把常用的卡放进来</view><text>选择银行和卡种，就能筛选适合你的活动。</text><button class="primary" bindtap="addCard">添加第一张卡</button></view>
    <view wx:if="{{namingCards.length}}" class="naming-notice"><view class="naming-title">{{namingCards.length}} 张卡需要设置昵称</view><text class="naming-help">按卡面名称或用途命名，参加活动时更容易选对卡。</text><view wx:for="{{namingCards}}" wx:key="id" wx:for-item="card" class="naming-row"><view class="member-title">{{card.title}}</view><button class="text-button" data-id="{{card.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">设置昵称</button></view></view>
    <button wx:if="{{cardCount}}" class="browse-mine" bindtap="browseMine">查看我的卡能参加的活动<text aria-hidden="true">›</text></button>
    <button wx:if="{{groups.length}}" class="bill-management" bindtap="toggleBillManagement" aria-expanded="{{showBills}}"><view><view class="bill-management-title">账单与还款管理</view><text class="bill-management-caption">含已归档账户的历史账单</text></view><text aria-hidden="true">{{showBills ? '⌃' : '⌄'}}</text></button>
    <block wx:if="{{showBills}}">    <view wx:if="{{groups.length}}" class="section-heading">还款计划</view>
    <view class="account-group" wx:for="{{groups}}" wx:key="id" wx:for-item="group">
      <view wx:if="{{group.archived}}" class="archived-label">{{group.settledArchive ? '已归档账户历史' : '已归档账户待还'}}</view>
      <view class="account-head"><image class="bank-logo" src="{{group.logo}}" mode="aspectFit" /><view class="account-info"><view class="account-title">{{group.title}}</view><text wx:if="{{group.identity}}" class="account-identity">{{group.identity}}</text><text class="account-subtitle">{{group.subtitle}}</text></view><button class="account-settings" data-id="{{group.id}}" bindtap="toggleGroup" aria-expanded="{{group.expanded}}">{{group.expanded ? '收起' : group.settledArchive ? '历史账单' : group.otherBills.length ? '更多账单' : '账单设置'}}<text aria-hidden="true">{{group.expanded ? '⌃' : '⌄'}}</text></button></view>
      <view wx:if="{{!group.reminderAvailable && !group.settledArchive}}" class="schedule bill-main">账户已停用，历史账单不再提供微信提醒；仍可标记还款和修改日期。</view>
      <view wx:if="{{group.primaryBill && (!group.settledArchive || group.expanded)}}" class="bill-main">
        <view class="row-between bill-date-row"><view><view class="due-date {{group.primaryBill.late ? 'late' : ''}}">{{group.primaryBill.dateLabel}}</view><text class="bill-status">{{group.primaryBill.period}} · {{group.primaryBill.paid ? '已标记还款' : group.primaryBill.late ? '登记的还款日已过' : '还款日'}}</text></view><button class="{{group.primaryBill.paid ? 'small-secondary' : 'small-primary'}}" data-id="{{group.primaryBill.id}}" loading="{{busyId === group.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" bindtap="togglePaid">{{group.primaryBill.paid ? '撤销还款' : '标记还款'}}</button></view>
        <button wx:if="{{!group.primaryBill.paid && group.reminderAvailable && !group.primaryBill.reminderExpired}}" class="reminder-button" data-id="{{group.primaryBill.id}}" loading="{{reminderBusyId === group.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" bindtap="requestBillReminder">开启本期微信提醒</button>
        <view wx:elif="{{!group.primaryBill.paid && group.reminderAvailable && group.primaryBill.reminderExpired}}" class="schedule bill-reminder-expired">已逾期，不补发微信提醒；仍可标记还款和修改日期。</view>
        <text wx:if="{{!group.primaryBill.paid && group.reminderAvailable && !group.primaryBill.reminderExpired && reminderNoticeId === group.primaryBill.id}}" class="reminder-notice" role="status">{{reminderNotice}}</text>
      </view>
      <view wx:elif="{{!group.primaryBill}}" class="missing-bill">本期待还款日期尚未生成，可在卡片设置中补充。</view>
      <view wx:if="{{group.expanded}}" class="account-extra">
        <view class="schedule">{{group.statement}}</view>
        <button wx:if="{{group.primaryCardId && !group.archived}}" class="text-button account-edit" data-id="{{group.primaryCardId}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">编辑卡片与账单规则</button>
        <view wx:if="{{group.primaryBill}}" class="row-between bill-meta-row"><text>{{group.primaryBill.period}}账单</text><picker mode="date" value="{{group.primaryBill.dueOn}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" data-id="{{group.primaryBill.id}}" aria-label="{{group.title}}，{{group.identity || group.subtitle}}，{{group.primaryBill.period}}账单还款日期，当前{{group.primaryBill.dueOn}}" bindchange="changeDueDate"><view class="date-edit">修改本期日期</view></picker></view>
        <view wx:if="{{group.cards.length > 1}}" class="members"><view wx:for="{{group.cards}}" wx:key="id" wx:for-item="card" class="member-row"><view><view class="member-title">{{card.title}}</view><text wx:if="{{card.description}}" class="member-description">{{card.description}}</text></view><button class="text-button" data-id="{{card.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">编辑</button></view></view>
        <view class="older-bill" wx:for="{{group.otherBills}}" wx:key="id" wx:for-item="bill"><view class="row-between"><view><view class="member-title">{{bill.dateLabel}}</view><text class="member-description">{{bill.period}} · {{bill.paid ? '已标记还款' : bill.late ? '登记日已过' : '待还款'}}</text></view><button class="text-button" data-id="{{bill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" loading="{{busyId === bill.id}}" bindtap="togglePaid">{{bill.paid ? '撤销还款' : '标记还款'}}</button></view><button wx:if="{{!bill.paid && group.reminderAvailable && !bill.reminderExpired}}" class="reminder-button" data-id="{{bill.id}}" loading="{{reminderBusyId === bill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" bindtap="requestBillReminder">开启本期微信提醒</button><view wx:elif="{{!bill.paid && group.reminderAvailable && bill.reminderExpired}}" class="schedule bill-reminder-expired">已逾期，不补发微信提醒；仍可标记还款和修改日期。</view><text wx:if="{{!bill.paid && group.reminderAvailable && !bill.reminderExpired && reminderNoticeId === bill.id}}" class="reminder-notice" role="status">{{reminderNotice}}</text><picker mode="date" value="{{bill.dueOn}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" data-id="{{bill.id}}" aria-label="{{group.title}}，{{group.identity || group.subtitle}}，{{bill.period}}账单还款日期，当前{{bill.dueOn}}" bindchange="changeDueDate"><view class="date-edit">修改本期日期</view></picker></view>
      </view>
    </view>
    </block>
    <view class="privacy-note">还款以银行账单为准。微信提醒需在具体账单中每期单独授权。{{demo ? '演示模式不发送微信消息。' : ''}}</view>
    <button class="text-button reminder-settings" bindtap="openPreferences">查看提醒偏好</button>
  </block>
  <block wx:else>
    <view class="perk-kind-grid"><button wx:for="{{perkKinds}}" wx:key="value" class="perk-kind {{perkKind === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="changePerkKind"><text class="perk-kind-name">{{item.label}}</text><text class="perk-kind-stat">{{item.stat}}</text><text class="perk-kind-sub">{{item.sub}}</text></button></view>
    <button wx:if="{{perkKind === 'lounge'}}" class="airport-entry" bindtap="openLounges"><view class="airport-icon"><text aria-hidden="true">↗</text></view><view class="airport-copy"><text class="airport-title">按机场查贵宾厅</text><text class="airport-caption">输入机场，查询贵宾厅及可用卡片</text></view><text class="airport-arrow" aria-hidden="true">›</text></button>
    <view class="perk-heading"><view><view class="perk-heading-title">{{perkKindLabel}}{{perkKind === 'points' || perkKind === 'delay_insurance' ? '' : '权益'}}</view><text class="perk-heading-caption">按已登记资料显示，使用前请核实</text></view><button class="add-perk" bindtap="addEntitlement"><text aria-hidden="true">+</text>登记权益</button></view>
    <view wx:if="{{perkError}}" class="refresh-notice">{{perkError}}<button class="text-button" bindtap="openEntitlements">前往持有权益</button></view>
    <view wx:elif="{{perkRows.length}}" class="perk-list"><view wx:for="{{perkRows}}" wx:key="id" class="perk-row" data-id="{{item.id}}" bindtap="openEntitlements"><image wx:if="{{item.logo}}" class="perk-logo" src="{{item.logo}}" mode="aspectFit" /><view wx:else class="perk-kind-symbol">益</view><view class="perk-identity"><view class="perk-name-line"><text class="perk-name">{{item.title}}</text><text wx:if="{{item.counted}}" class="transfer-chip {{item.greyTransfer ? 'grey' : item.transferLabel === '明确可转让' ? '' : 'restricted'}}">{{item.transferLabel}}</text></view><text class="perk-description">{{item.cardName || item.provider || item.kindLabel}}</text><text wx:if="{{item.description}}" class="perk-description">{{item.description}}</text><text class="perk-period">{{item.period}}</text></view><view class="perk-balance"><text class="perk-balance-number {{item.kind === 'delay_insurance' || (item.kind === 'points' && item.pointsBalance === null) ? 'information-balance' : ''}}">{{item.balanceText}} {{item.balanceUnit}}</text><text class="perk-balance-status">{{item.status}}</text></view></view></view>
    <view wx:else class="empty"><view class="empty-title">还没有登记这类权益</view><text>登记已持有的次数和有效期，方便随时核对。</text><button class="primary" bindtap="addEntitlement">登记权益</button></view>
    <button class="all-perks" bindtap="openEntitlements">管理全部持有权益<text aria-hidden="true">›</text></button><button class="other-perks {{perkKind === 'other' ? 'selected' : ''}}" data-value="other" bindtap="changePerkKind">其他权益 {{otherPerkCount}}<text aria-hidden="true">›</text></button>
  </block>
</view>
<app-sheet id="card-detail-sheet" full-screen="{{true}}" show="{{cardSheet}}" title="{{selectedCard.title || ''}}" dismissible="{{!busyId && !reminderBusyId}}" bind:close="closeCard" content-state="{{[selectedCard, selectedGroup, selectedPerkRows, selectedActivities, showBillControls, busyId, reminderBusyId, reminderNotice]}}">
  <block wx:if="{{selectedCard}}">
    <view class="detail-card" style="background-color:{{selectedCard.color}}"><view class="detail-card-head"><image class="detail-logo" src="{{selectedCard.logo}}" mode="aspectFit" /><text>{{selectedCard.issuer || selectedCard.bank}}</text><text class="detail-network">{{selectedCard.network}}</text></view><view class="detail-card-title">{{selectedCard.title}}</view><view class="detail-card-footer"><text>{{selectedCard.kindLabel}}</text><text wx:if="{{selectedGroup.primaryBill && selectedGroup.primaryBill.amountMinor !== null}}">{{selectedGroup.primaryBill.currency}} 账单</text><text wx:else>无需记录卡号</text></view></view>
    <view class="detail-actions"><button class="secondary" data-id="{{selectedCard.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}"><text class="detail-edit-symbol" aria-hidden="true"></text>编辑卡片</button><button class="secondary" bindtap="registerCardEntitlement" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}"><text class="detail-plus-symbol" aria-hidden="true"></text>登记权益</button></view>
    <view wx:if="{{outdated}}" class="refresh-notice">{{refreshError}}</view>
    <view wx:if="{{selectedGroup.primaryBill}}" class="bill-summary"><view class="bill-summary-grid"><view class="bill-summary-item"><text class="bill-summary-label">账单日</text><text class="bill-summary-value">{{selectedGroup.primaryBill.statementDateLabel}}</text></view><view class="bill-summary-item"><text class="bill-summary-label">还款日</text><text class="bill-summary-value {{selectedGroup.primaryBill.late && !selectedGroup.primaryBill.paid ? 'late' : ''}}">{{selectedGroup.primaryBill.compactDueDate}}</text><text class="bill-summary-note">{{selectedGroup.primaryBill.paid ? '已标记还款' : selectedCard.dueChip}}</text></view><view class="bill-summary-item"><text class="bill-summary-label">本期应还</text><text class="bill-summary-value bill-summary-amount">{{selectedGroup.primaryBill.amountText}}</text><text class="bill-summary-note">{{selectedGroup.primaryBill.period}}</text></view></view><button class="bill-paid-action" data-id="{{selectedGroup.primaryBill.id}}" bindtap="togglePaid" loading="{{busyId === selectedGroup.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">{{selectedGroup.primaryBill.paid ? '撤销还款' : '我已还款'}}</button></view>
    <view wx:elif="{{selectedCard.credit}}" class="no-bill-card"><text>{{selectedGroup ? '本期账单尚未生成，补充还款规则后会显示在这里。' : '这张卡尚未设置还款计划。'}}</text><button data-id="{{selectedCard.id}}" bindtap="editCard" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">去设置</button></view>
    <view class="card-detail-list"><view class="card-detail-list-heading"><text>持有权益</text><text>{{selectedPerkRows.length}}</text></view><view wx:if="{{selectedPerkRows.length}}" class="card-detail-rows"><view wx:for="{{selectedPerkRows}}" wx:key="id" class="card-detail-perk" data-id="{{item.id}}" bindtap="openEntitlements"><view class="card-detail-row-copy"><text class="card-detail-row-title">{{item.title}}</text><text class="card-detail-row-note">{{item.description || item.kindLabel}} · {{item.status}}</text></view><text class="card-detail-row-number">{{item.balanceText}} {{item.balanceUnit}}</text><text class="card-detail-row-arrow" aria-hidden="true">›</text></view></view><view wx:else class="card-detail-empty">{{perks ? '这张卡还没有登记权益。' : '权益资料暂未读取，请返回卡包刷新。'}}</view></view>
    <view class="card-detail-list"><view class="card-detail-list-heading"><text>参与中的活动</text><text>{{selectedActivities.length}}</text></view><view wx:if="{{selectedActivities.length}}" class="card-detail-rows"><view wx:for="{{selectedActivities}}" wx:key="id" class="card-detail-activity" data-id="{{item.id}}" bindtap="openCardActivity"><view class="card-detail-row-copy"><text class="card-detail-row-title">{{item.title}}</text><text class="card-detail-row-note">{{item.scopeLabel}} · {{item.status}}</text></view><text class="card-detail-row-number">{{item.progress}}</text><text class="card-detail-row-arrow" aria-hidden="true">›</text></view></view><view wx:else class="card-detail-empty">{{dashboard ? '还没有关联这张卡的参与记录。' : '参与记录暂未读取，请返回卡包刷新。'}}</view></view>
    <view wx:if="{{selectedGroup.primaryBill}}" class="bill-management-shell"><button class="bill-management-toggle" bindtap="toggleBillControls" aria-expanded="{{showBillControls}}" disabled="{{loading || refreshing || !!busyId || !!reminderBusyId}}"><text>管理本期账单</text><text aria-hidden="true">{{showBillControls ? '⌃' : '⌄'}}</text></button><view wx:if="{{showBillControls}}" class="bill-management-details"><text class="schedule">{{selectedGroup.statement}}</text><view class="bill-amount-editor"><label class="bill-amount-label" for="bill-amount">本期账单金额</label><view class="bill-amount-fields"><picker range="{{billCurrencies}}" range-key="label" value="{{billCurrencyIndex}}" bindchange="changeBillCurrency" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}"><view class="bill-currency">{{billCurrencies[billCurrencyIndex].value}}⌄</view></picker><input id="bill-amount" class="bill-amount-input" type="digit" value="{{billAmountInput}}" bindinput="changeBillAmount" placeholder="按银行账单填写" maxlength="17" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}" /></view><text wx:if="{{billAmountError}}" class="bill-amount-error" role="alert">{{billAmountError}}</text><button class="save-amount" bindtap="saveBillAmount" loading="{{busyId === selectedGroup.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">保存账单金额</button></view><picker mode="date" value="{{selectedGroup.primaryBill.dueOn}}" data-id="{{selectedGroup.primaryBill.id}}" bindchange="changeDueDate" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}"><view class="date-edit">修改本期日期</view></picker><button wx:if="{{!selectedGroup.primaryBill.paid && selectedGroup.reminderAvailable && !selectedGroup.primaryBill.reminderExpired}}" class="reminder-button" data-id="{{selectedGroup.primaryBill.id}}" bindtap="requestBillReminder" loading="{{reminderBusyId === selectedGroup.primaryBill.id}}" disabled="{{loading || refreshing || outdated || !!busyId || !!reminderBusyId}}">开启本期微信提醒</button><text wx:if="{{reminderNoticeId === selectedGroup.primaryBill.id}}" class="reminder-notice">{{reminderNotice}}</text><text wx:if="{{selectedGroup.primaryBill.reminderExpired && !selectedGroup.primaryBill.paid}}" class="schedule">已逾期，不补发微信提醒；仍可标记还款和修改日期。</text></view></view>
  </block>
</app-sheet>
