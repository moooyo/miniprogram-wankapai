.wallet-page { background:#fff; min-height:100vh; padding-bottom:40rpx; }
.page-heading { gap:20rpx; padding:12rpx 0 32rpx; }
.heading { color:#14243a; font-size:48rpx; font-weight:650; }
.wallet-count { display:block; font-size:26rpx; margin-top:10rpx; }
.text-button { color:#1764d9; background:transparent; min-height:48px; line-height:48px; padding:0 12rpx; margin:0; font-size:26rpx; flex-shrink:0; }
.text-button::after,.disclosure::after,.browse-mine::after { border:0; }
.section-heading { font-size:28rpx; color:#647084; padding:20rpx 0; }
.account-group { border-top:1rpx solid #e5eaf1; padding:20rpx 0 24rpx; }
.archived-label { color:#647084; font-size:23rpx; margin-bottom:16rpx; }
.account-head { display:flex; gap:20rpx; align-items:center; }
.bank-logo { width:56rpx; height:56rpx; flex-shrink:0; }
.account-info { flex:1; min-width:0; }
.account-title { font-size:32rpx; line-height:1.5; color:#14243a; font-weight:600; }
.account-subtitle { display:block; font-size:25rpx; line-height:1.55; color:#647084; margin-top:4rpx; }
.bill-main { padding-top:20rpx; }
.bill-date-row { gap:16rpx; }
.due-date { font-size:40rpx; color:#14243a; font-weight:600; font-variant-numeric:tabular-nums; }
.late { color:#a8442c; }
.bill-status { font-size:24rpx; line-height:1.5; color:#647084; display:block; margin-top:6rpx; }
.small-primary,.small-secondary { min-height:48px; line-height:48px; padding:0 24rpx; margin:0; border-radius:12rpx; font-size:26rpx; flex-shrink:0; }
.small-primary { color:#1764d9; background:#edf4ff; }
.small-primary::after { border:0; }
.small-secondary { color:#526579; background:#fff; }
.small-secondary::after { border-color:#c8d2df; border-radius:24rpx; }
.bill-meta-row { color:#647084; font-size:23rpx; margin-top:6rpx; gap:12rpx; }
.date-edit { color:#1764d9; font-size:24rpx; min-height:48px; display:flex; align-items:center; }
.schedule { font-size:24rpx; color:#647084; line-height:1.6; }
.missing-bill { margin:16rpx 0; font-size:25rpx; color:#647084; line-height:1.6; }
.disclosure { display:flex; align-items:center; justify-content:space-between; min-height:48px; padding:14rpx 0 0; background:transparent; color:#526579; font-size:25rpx; margin:0; }
.disclosure text { font-size:32rpx; }
.account-extra { margin-top:4rpx; padding-left:24rpx; border-left:3rpx solid #dce7f6; }
.member-row { display:flex; gap:16rpx; align-items:center; justify-content:space-between; border-bottom:1rpx solid #edf0f5; padding:10rpx 0; }
.member-title { font-size:28rpx; line-height:1.5; color:#243b58; }
.member-description { font-size:24rpx; color:#647084; line-height:1.6; }
.older-bill { padding-top:20rpx; }
.loose-heading { border-top:1rpx solid #e5eaf1; margin-top:16rpx; }
.loose-card { display:flex; gap:20rpx; align-items:center; padding:24rpx 0; border-bottom:1rpx solid #e5eaf1; }
.browse-mine { display:flex; align-items:center; justify-content:space-between; color:#1764d9; font-size:28rpx; min-height:104rpx; padding:0; margin:20rpx 0 0; background:#fff; text-align:left; line-height:1.5; }
.browse-mine text { font-size:36rpx; }
.privacy-note { color:#647084; font-size:24rpx; line-height:1.7; margin-top:20rpx; }
.loading,.empty { padding:64rpx 12rpx; text-align:center; font-size:28rpx; line-height:1.65; }
.empty-title { color:#14243a; font-size:32rpx; font-weight:600; margin-bottom:12rpx; }
.empty button { margin-top:28rpx; }
