<design-nav title="{{activityId ? '参与记录' : '全部参与记录'}}" back />
<view class="history-page" aria-hidden="{{showAudit}}">
  <view class="history-intro">
    <view class="history-intro-head">
      <text class="history-scope">{{activityId ? '当前活动 · 全部周期' : '全部活动 · 全部周期'}}</text>
      <button class="history-help" bindtap="toggleRecordHelp" aria-expanded="{{showRecordHelp}}" aria-controls="history-record-help" hover-class="tap-soft">{{showRecordHelp ? '收起说明' : '记录说明'}}</button>
    </view>
    <text wx:if="{{showRecordHelp}}" id="history-record-help" class="history-description">包含已跳过及未达标的记录。返现按实际到账日计入，优惠按实际使用日计入。点击「操作记录」可查看每一步操作。</text>
    <view class="history-tabs">
      <button class="history-tab {{filter === 'all' ? 'is-selected' : ''}}" data-filter="all" bindtap="chooseFilter" aria-pressed="{{filter === 'all'}}" hover-class="tap-soft">全部<text wx:if="{{counts.all !== ''}}" class="tab-count">{{counts.all}}</text></button>
      <button class="history-tab {{filter === 'unfinished' ? 'is-selected' : ''}}" data-filter="unfinished" bindtap="chooseFilter" aria-pressed="{{filter === 'unfinished'}}" hover-class="tap-soft">未完成<text wx:if="{{counts.unfinished !== ''}}" class="tab-count">{{counts.unfinished}}</text></button>
      <button class="history-tab {{filter === 'pending' ? 'is-selected' : ''}}" data-filter="pending" bindtap="chooseFilter" aria-pressed="{{filter === 'pending'}}" hover-class="tap-soft">待确认<text wx:if="{{counts.pending !== ''}}" class="tab-count">{{counts.pending}}</text></button>
    </view>
  </view>
  <view wx:if="{{loading && !items.length}}" class="state-block" role="status">正在加载记录…</view>
  <view wx:elif="{{error && !items.length}}" class="state-block" role="alert"><text>{{error}}</text><button class="retry-button" bindtap="retry" hover-class="tap-soft">重新加载</button></view>
  <block wx:else>
    <text wx:if="{{loading}}" class="list-notice" role="status">正在更新记录，已显示的内容仍可查看…</text>
    <view wx:elif="{{error}}" class="list-notice" role="alert"><text>{{error}}当前显示上次加载的内容。</text><button class="retry-button" bindtap="retry" hover-class="tap-soft">重新加载</button></view>
    <view wx:for="{{items}}" wx:key="id" class="history-record">
      <button class="record-main" data-id="{{item.id}}" data-activity="{{item.activityId}}" bindtap="openRecord" hover-class="tap-soft">
        <view class="record-period"><text>{{item.displayPeriod}}</text><text class="record-stage {{item.stageTone}}">{{item.displayStage}}</text></view>
        <view class="record-title"><image src="{{item.logo}}" class="bank-logo" mode="aspectFit" aria-hidden="true"/><text>{{item.bankName}} · {{item.title}}</text></view>
        <text wx:if="{{item.cardName}}" class="record-card">{{item.cardName}}</text>
        <view class="record-value"><text>{{item.displayAmountLabel}}</text><text class="amount">{{item.displayValue}}</text></view>
      </button>
      <view class="record-footer">
        <text wx:if="{{item.withdrawn}}" class="record-note">已退出活动 · 可在活动页重新参加</text>
        <text wx:elif="{{item.receivedOn}}" class="record-note">{{item.receivedOn}} {{item.dateEvent}}</text>
        <text wx:elif="{{item.expectedOn && item.stage === 'completed'}}" class="record-note">预计 {{item.expectedOn}} {{item.dateEvent}}</text>
        <text wx:elif="{{item.stage === 'skipped'}}" class="record-note">本期已跳过 · 原有记录保留</text>
        <text wx:else class="record-note">{{item.progress}} · {{item.endsOn}} 截止</text>
        <button class="audit-link" data-id="{{item.id}}" data-activity="{{item.activityId}}" data-title="{{item.period}} · {{item.title}}" bindtap="openAudit" hover-class="tap-soft">操作记录</button>
      </view>
    </view>
    <view wx:if="{{!items.length}}" class="state-block empty-state">
      <view class="empty-illustration" aria-hidden="true"><view class="empty-cloud"></view><view class="empty-face"><view class="empty-eye"></view><view class="empty-eye"></view></view></view>
      <text class="empty-title">{{filter === 'pending' ? '暂无待确认记录' : filter === 'unfinished' ? '暂无未完成记录' : '还没有参与记录'}}</text>
      <text>参加活动后，各期进度与结果将记录在此</text>
    </view>
    <text wx:if="{{loadMoreError}}" class="list-notice" role="alert">{{loadMoreError}}</text>
    <button wx:if="{{cursor}}" class="more-button" loading="{{loadingMore}}" disabled="{{loading || loadingMore}}" bindtap="loadMore" hover-class="tap-soft">{{loadingMore ? '加载中' : loadMoreError ? '重试加载更多' : '查看更多记录'}}</button>
  </block>
</view>
<app-sheet id="history-audit" show="{{showAudit}}" title="操作记录" content-state="{{[auditLoading, auditError, audit, auditTitle]}}" bindclose="closeAudit">
  <text class="audit-caption">{{auditTitle}}</text>
  <text wx:if="{{auditLoading}}" class="audit-caption" role="status">正在加载…</text>
  <view wx:elif="{{auditError}}" class="audit-caption" role="alert"><text>{{auditError}}</text><button class="retry-button" bindtap="loadAudit" hover-class="tap-soft">重新加载</button></view>
  <view wx:else class="audit-list">
    <view wx:for="{{audit}}" wx:key="id" class="audit-row"><view><text class="audit-label">{{item.label}}</text><text wx:if="{{item.description}}" class="audit-description">{{item.description}}</text></view><text class="audit-date">{{item.at}}</text></view>
    <text wx:if="{{!audit.length}}" class="audit-empty">暂无操作记录</text>
  </view>
  <text class="audit-footnote">每次记录进度、确认到账均会留存记录，便于核对银行发放情况。</text>
</app-sheet>
