page{background:#F3F6FB;color:#0F1B2D}
.history-page{padding:0 16px calc(28px + env(safe-area-inset-bottom));font-family:'PingFang SC','Microsoft YaHei',sans-serif}
.history-intro{padding-bottom:12px;display:flex;flex-direction:column;gap:10px}
.history-intro-head{display:flex;align-items:center;gap:8px;padding-left:4px;min-height:36px}
.history-scope{flex:1;min-width:0;font-size:13px;color:#3F4D63;line-height:1.5}
.history-help{flex:none;display:flex;align-items:center;min-height:36px;margin:0;padding:0 4px;background:transparent;border-radius:8px;color:#1A56C4;font-size:13px;font-weight:500;line-height:1.5}
.history-description{display:block;padding:10px 12px;border-radius:12px;background:#E6EEFC;color:#1A56C4;font-size:13px;line-height:1.55}
.history-tabs{display:flex;padding:3px;border-radius:13px;background:#EBF0F7}
.history-tab{flex:1;min-width:0;height:38px;min-height:38px;display:flex;align-items:center;justify-content:center;gap:5px;margin:0;padding:0 4px;background:transparent;border-radius:10px;font-size:14px;font-weight:500;line-height:1.4;color:#5E6E84}
.history-tab.is-selected{background:#FFFFFF;color:#0F1B2D;box-shadow:0 2px 6px rgba(15,35,70,.08)}
.tab-count{font-family:'DM Mono',monospace;font-size:12px;font-weight:400}
.history-record{background:#FFFFFF;border:1px solid #E3E9F2;border-radius:18px;margin-bottom:10px;overflow:hidden}
button.record-main{display:flex;flex-direction:column;gap:7px;width:100%;padding:12px 14px 10px;margin:0;text-align:left;background:transparent;border-radius:0;color:#0F1B2D;font-size:13px;line-height:1.4}
.record-period{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;line-height:1.4;color:#3F4D63}
.record-stage{margin-left:auto;flex:none;font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;background:#EEF3FA;color:#3F4D63;line-height:1.4}
.record-stage.active{background:#E6EEFC;color:#1A56C4}
.record-stage.registration{background:#FFF2D6;color:#9A5B07}
.record-stage.received{background:#E4F2EB;color:#176B4B}
.record-title{display:flex;align-items:flex-start;gap:8px;font-size:15px;font-weight:500;line-height:1.4}
.record-title>text{flex:1;min-width:0;overflow-wrap:anywhere}
.bank-logo{width:22px;height:22px;margin-top:1px;flex:none;border-radius:50%;background:#FFFFFF;border:1px solid #EBF0F7;box-sizing:border-box;padding:2px}
.record-card{display:block;margin-left:30px;color:#5E6E84;font-size:12px;line-height:1.5;overflow-wrap:anywhere}
.record-value{display:flex;align-items:baseline;gap:6px;padding-left:30px;color:#5E6E84;font-size:12px;line-height:1.5}
.amount{font-family:'DM Mono',monospace;font-size:15px;font-weight:500;font-variant-numeric:tabular-nums;color:#0F1B2D}
.record-footer{display:flex;align-items:center;gap:8px;min-height:42px;padding:0 6px 0 14px;border-top:1px solid #EBF0F7}
.record-note{flex:1;min-width:0;font-size:12px;color:#5E6E84;line-height:1.5;padding:8px 0;overflow-wrap:anywhere}
.audit-link{flex:none;display:flex;align-items:center;min-height:40px;margin:0;padding:0 8px;border-radius:8px;background:transparent;color:#1A56C4;font-size:13px;font-weight:500;line-height:1.5}
.state-block{display:flex;align-items:center;flex-direction:column;gap:10px;text-align:center;padding:28px 16px;color:#5E6E84;font-size:13px;line-height:1.55}
.empty-state{border:1px dashed #C5D0DF;border-radius:18px}
.empty-title{color:#0F1B2D;font-size:16px;font-weight:600}
.empty-illustration{position:relative;width:92px;height:92px;border-radius:50%;background:#EEF3FA;border:1px dashed #C5D0DF;box-sizing:border-box}
.empty-cloud{position:absolute;left:24px;top:24px;width:44px;height:43px;background:#FFFFFF;border-radius:45%;box-shadow:-7px 2px 0 #FFFFFF,7px 2px 0 #FFFFFF,0 -6px 0 #FFFFFF}
.empty-face{position:absolute;left:34px;top:36px;width:24px;height:30px;background:#D8E3F4;border-radius:12px 12px 14px 14px;display:flex;justify-content:center;gap:7px;padding-top:11px;box-sizing:border-box}
.empty-eye{width:3px;height:3px;border-radius:50%;background:#3F4D63}
.more-button,.retry-button{display:flex;align-items:center;justify-content:center;min-height:44px;background:#E6EEFC;color:#1A56C4;font-size:14px;border-radius:12px;margin:0;padding:0 16px;line-height:1.5}
.more-button[disabled]{color:#5E6E84;background:#EBF0F7}
.list-notice{display:block;padding:12px 0;color:#5E6E84;font-size:13px;line-height:1.6}
.list-notice button,.audit-caption button{margin-top:12px}
.audit-caption{display:block;color:#3F4D63;font-size:13px;line-height:1.55;margin-bottom:16px;overflow-wrap:anywhere}
.audit-list{border-radius:14px;background:#F3F6FB;padding:0 14px}
.audit-row{display:flex;gap:12px;padding:11px 0;border-top:1px solid #E3E9F2;line-height:1.5}
.audit-row:first-child{border-top:0}
.audit-row>view{flex:1;min-width:0;overflow-wrap:anywhere}
.audit-label{font-size:14px;font-weight:500;color:#0F1B2D}
.audit-description{display:block;margin-top:2px;font-size:12px;line-height:1.55;color:#5E6E84}
.audit-date{flex:none;max-width:82px;text-align:right;font-family:'DM Mono',monospace;font-size:12px;color:#5E6E84;line-height:1.5}
.audit-empty{display:block;padding:16px 0;text-align:center;font-size:13px;color:#5E6E84}
.audit-footnote{display:block;margin-top:16px;font-size:12px;line-height:1.5;color:#5E6E84}
.history-help::after,.history-tab::after,.record-main::after,.audit-link::after,.more-button::after,.retry-button::after{border:0}
.tap-soft{background:#F4F7FC!important}
