page{background:#f4f7fb}.history-page{padding:20px 16px calc(28px + env(safe-area-inset-bottom));color:#172c49}.history-heading{display:block;font-size:22px;font-weight:600;line-height:1.5}.history-description{display:block;margin-top:8px;color:#626f82;font-size:14px;line-height:1.7}.history-tabs{display:flex;gap:16px;border-bottom:1px solid #d9e3f0;margin:16px 0}.history-tab{position:relative;background:transparent;min-height:48px;min-width:64px;margin:0;padding:12px 4px;color:#626f82;font-size:15px;line-height:1.5;border-radius:0}.history-tab::after,.record-main::after,.audit-link::after,.more-button::after{border:0}.history-tab.is-selected{color:#174fae;font-weight:600;border-bottom:3px solid #1f61d8}.history-record{background:#fff;border:1px solid #e5ebf3;border-radius:12px;margin-bottom:12px;overflow:hidden}button.record-main{display:block;width:100%;padding:16px 16px 10px;margin:0;text-align:left;background:transparent;color:#172c49;font-size:14px;line-height:1.6}.record-period{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#626f82;font-size:14px}.record-stage{color:#40618d}.record-stage.received{color:#176547}.record-title{display:flex;align-items:flex-start;gap:9px;font-size:17px;font-weight:600;line-height:1.6;margin-top:12px}.bank-logo{width:22px;height:22px;flex-shrink:0;margin-top:2px}.record-card{display:block;margin:7px 0 0 31px;color:#626f82;font-size:14px}.record-value{display:flex;align-items:baseline;gap:8px;margin-top:14px;color:#626f82;font-size:14px}.amount{font-size:20px;font-weight:600;color:#184b9c;font-variant-numeric:tabular-nums}.chevron{margin-left:auto;font-size:20px}.record-note{display:block;margin-top:6px;color:#626f82;font-size:14px}button.audit-link{display:flex;align-items:center;justify-content:flex-end;min-height:48px;margin:0 16px;padding:8px 0;border-top:1px solid #edf1f6;border-radius:0;background:transparent;color:#315fa5;font-size:14px;line-height:1.5}.state-block{display:flex;align-items:center;flex-direction:column;gap:14px;text-align:center;padding:36px 12px;color:#626f82;font-size:14px;line-height:1.7}.empty-title{color:#172c49;font-size:18px;font-weight:600}.more-button{min-height:48px;background:#fff;color:#1f61d8;font-size:14px;border-radius:8px}.audit-caption{display:block;color:#626f82;font-size:14px;line-height:1.7;margin-bottom:16px}.audit-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid #e5ebf3;font-size:14px;color:#172c49}.audit-date{font-size:14px;color:#626f82}
.audit-description{display:block;margin-top:5px;font-size:14px;line-height:1.7;color:#626f82}.audit-date{flex-shrink:0}
.history-description,.record-period,.record-card,.record-value,.record-note,.audit-caption,.audit-description,.audit-date{font-size:14px;line-height:1.6}
.record-period,.record-value,.audit-row{flex-wrap:wrap}
.record-card{overflow-wrap:anywhere}
.audit-date{margin-left:auto}
.list-notice{display:block;padding:12px 0;color:#626f82;font-size:14px;line-height:1.6}.list-notice button,.audit-caption button{margin-top:12px}.record-title>text{min-width:0;overflow-wrap:anywhere}.history-tabs{flex-wrap:wrap;gap:8px}.audit-row>view{min-width:0;overflow-wrap:anywhere}
.history-intro-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0 12px}.history-scope{color:#626f82;font-size:14px;line-height:1.6}.history-help{display:flex;align-items:center;justify-content:flex-end;min-width:72px;min-height:48px;margin:0 0 0 auto;padding:10px 0;background:transparent;border-radius:0;color:#315fa5;font-size:14px;line-height:1.5}.history-help::after{border:0}.history-description{margin:0 0 12px}.record-footer{display:flex;align-items:center;flex-wrap:wrap;column-gap:12px;margin:0 16px;border-top:1px solid #edf1f6}.record-footer .record-note{flex:1 1 150px;min-width:0;margin:0;padding:10px 0;overflow-wrap:anywhere}.record-footer .audit-link{flex:0 0 auto;min-width:64px;min-height:48px;margin:0 0 0 auto;padding:8px 0;border-top:0}
