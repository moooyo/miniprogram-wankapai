.mine-page{padding:24px 20px 32px;color:var(--ink,#172638)}
.page-heading{display:flex;flex-direction:column;gap:8px;margin-bottom:28px}.page-title{font-size:28px;font-weight:650;line-height:1.3}.page-description{font-size:14px;line-height:1.6;color:var(--muted,#647084)}
.group{background:var(--surface,#fff);border-radius:12px;margin-bottom:16px;padding:0 16px}.menu-row{padding:18px 0;margin:0;width:100%;display:flex;justify-content:space-between;align-items:center;gap:12px;background:transparent;text-align:left;line-height:1.5;border-bottom:1px solid var(--line,#e5eaf1);border-radius:0;font-weight:400}.menu-row:last-child{border-bottom:0}.menu-row::after,.text-button::after{border:0}.menu-row:active{opacity:.65}.menu-copy{display:flex;flex-direction:column;gap:4px;flex:1}.menu-title{font-size:17px;color:var(--ink,#172638)}.menu-description{font-size:13px;color:var(--muted,#647084)}.chevron{color:var(--muted,#647084);font-size:25px;line-height:1;min-width:20px;text-align:right}
.demo-section{padding:12px 4px}.demo-heading{display:flex;align-items:center;justify-content:space-between;font-size:14px;color:var(--muted,#647084)}.role-picker{min-height:48px;display:flex;align-items:center;gap:12px;color:var(--blue,#165dcc);font-size:14px}.small-copy{display:block;font-size:12px;line-height:1.6;color:var(--muted,#647084)}.feedback{padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:14px;line-height:1.6}.error{background:#fff3f1;color:#9c3429}.text-button{background:transparent;min-height:44px;padding:4px 0;color:var(--blue,#165dcc);font-size:14px}.loading{padding:32px 0;color:var(--muted,#647084);font-size:14px}
