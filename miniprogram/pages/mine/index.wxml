<view class="mine-page">
  <view class="page-heading"><text class="page-title">我的</text><text class="page-description">整理自己的权益，也分享值得参加的活动。</text></view>
  <view wx:if="{{error}}" class="feedback error" role="alert"><text>{{error}}</text><button class="text-button" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="loading">正在读取…</view>
  <block wx:else>
    <view class="group">
      <button class="menu-row" bindtap="openSubmissions"><view class="menu-copy"><text class="menu-title">我的投稿</text><text class="menu-description">{{returnedCount ? '有投稿需要补充' : pendingCount ? '有投稿等待审核' : '查看投稿与审核结果'}}</text></view><text class="chevron" aria-hidden="true">›</text></button>
      <button class="menu-row" bindtap="openSubmission"><view class="menu-copy"><text class="menu-title">分享活动</text><text class="menu-description">提交规则和出处，核实后公开</text></view><text class="chevron" aria-hidden="true">›</text></button>
    </view>
    <view class="group">
      <button class="menu-row" bindtap="openPreferences"><view class="menu-copy"><text class="menu-title">提醒设置</text><text class="menu-description">截止、待到账与信用卡还款</text></view><text class="chevron" aria-hidden="true">›</text></button>
      <button class="menu-row" bindtap="showPrivacy"><view class="menu-copy"><text class="menu-title">数据与隐私</text><text class="menu-description">个人记录与公开内容的范围</text></view><text class="chevron" aria-hidden="true">›</text></button>
    </view>
    <view wx:if="{{session.isModerator}}" class="group">
      <button class="menu-row" bindtap="openReview"><view class="menu-copy"><text class="menu-title">活动审核</text><text class="menu-description">核实来源、补齐规则、处理投稿</text></view><text class="chevron" aria-hidden="true">›</text></button>
    </view>
    <view wx:if="{{session.demo}}" class="demo-section">
      <view class="demo-heading"><text>演示角色</text><picker range="{{['普通用户', '运营审核']}}" value="{{session.isModerator ? 1 : 0}}" bindchange="changeDemoRole" disabled="{{changingRole}}"><view class="role-picker">{{session.isModerator ? '运营审核' : '普通用户'}}<text aria-hidden="true">⌄</text></view></picker></view>
      <text class="small-copy">当前使用演示数据。正式环境的运营权限由账号授权决定。</text>
    </view>
  </block>
</view>
