<design-nav title="我的" />
<view class="mine-page">
  <view class="profile">
    <view class="profile-avatar" aria-hidden="true">头像</view>
    <view class="profile-copy">
      <text class="profile-name">{{loading ? '正在确认账号…' : userDisplay || '账号暂不可用'}}</text>
      <text class="profile-detail">{{session ? (session.demo ? '演示数据' : '微信登录') + ' · ' + (session.isModerator ? '运营审核' : '普通用户') : '请重新读取账号信息'}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="feedback error" role="alert">
    <text>{{error}}</text>
    <button class="text-button" bindtap="load" disabled="{{loading || countsLoading || changingRole}}">重新读取账号</button>
  </view>
  <view wx:if="{{countsError}}" class="feedback error" role="alert">
    <text>{{countsError}}</text>
    <button class="text-button" bindtap="load" disabled="{{loading || countsLoading || changingRole}}">重试投稿状态</button>
  </view>

  <view class="group">
    <button class="menu-row" bindtap="openHistory" hover-class="menu-pressed">
      <view class="menu-copy"><text class="menu-title">全部参与记录</text><text class="menu-description">往期进度、返现与优惠</text></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
    <button class="menu-row" bindtap="openSubmissions" hover-class="menu-pressed">
      <view class="menu-copy"><text class="menu-title">我的投稿</text><text class="menu-description">{{countsLoading ? '正在更新投稿状态…' : countsReady && returnedCount ? '有投稿需要补充' : countsReady && pendingCount ? '有投稿等待审核' : '查看投稿与审核结果'}}</text></view>
      <text wx:if="{{countsReady && (returnedCount || pendingCount)}}" class="submission-badge">{{returnedCount ? '待补充' : '审核中'}}</text>
      <view class="chevron" aria-hidden="true"></view>
    </button>
    <button class="menu-row" bindtap="openPreferences" hover-class="menu-pressed">
      <view class="menu-copy"><text class="menu-title">提醒设置</text><text class="menu-description">新活动、截止、到账与还款</text></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
  </view>

  <view class="tools-group">
    <button class="tool-entry" bindtap="openEntitlements" hover-class="menu-pressed" aria-label="持有权益，余量、期限与规则">
      <view class="tool-icon" aria-hidden="true"><view class="icon gift-icon"></view></view>
      <text class="tool-title">持有权益</text>
      <text class="tool-description">余量、期限与规则</text>
    </button>
    <button class="tool-entry" bindtap="openLounges" hover-class="menu-pressed" aria-label="贵宾厅速查，按机场查询可用卡片">
      <view class="tool-icon" aria-hidden="true"><view class="icon plane-icon"></view></view>
      <text class="tool-title">贵宾厅速查</text>
      <text class="tool-description">按机场查询可用卡片</text>
    </button>
  </view>

  <view class="group">
    <button class="menu-row" bindtap="openSubmission" hover-class="menu-pressed">
      <view class="menu-copy"><text class="menu-title">提交活动线索</text><text class="menu-description">填写银行、活动名称及一种来源即可</text></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
    <button class="menu-row" bindtap="showPrivacy" hover-class="menu-pressed">
      <view class="menu-copy"><text class="menu-title">数据与隐私</text><text class="menu-description">个人记录与公开内容的范围</text></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
  </view>

  <view wx:if="{{session.isModerator}}" class="group">
    <button class="menu-row" bindtap="openReview" hover-class="menu-pressed">
      <view class="menu-copy"><text class="menu-title">活动审核</text><text class="menu-description">核实来源、完善规则、处理投稿</text></view>
      <view class="chevron" aria-hidden="true"></view>
    </button>
  </view>

  <view wx:if="{{session.demo}}" class="demo-section">
    <view class="demo-heading">
      <text class="demo-title">演示角色</text>
      <view class="role-picker" aria-label="演示角色">
        <button class="role-option {{!session.isModerator ? 'role-selected' : ''}}" data-value="0" bindtap="onDemoRole" disabled="{{changingRole}}" aria-label="普通用户{{!session.isModerator ? '，当前已选' : ''}}">普通用户</button>
        <button class="role-option {{session.isModerator ? 'role-selected' : ''}}" data-value="1" bindtap="onDemoRole" disabled="{{changingRole}}" aria-label="运营审核{{session.isModerator ? '，当前已选' : ''}}">运营审核</button>
      </view>
    </view>
    <text class="small-copy">当前为演示数据。正式环境的审核权限由账号授权决定。</text>
  </view>
</view>
