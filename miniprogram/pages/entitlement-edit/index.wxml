<view class="page entitlement-editor" aria-hidden="{{loungeVisible}}">
  <view wx:if="{{loading}}" class="status">正在读取权益资料…</view>
  <view wx:elif="{{!ready}}" class="status"><text class="status-title">权益资料暂时无法读取</text><text>{{loadError}}</text><view class="status-actions"><button class="secondary" bindtap="back">返回卡包</button><button class="primary" bindtap="load">重试读取</button></view></view>
  <block wx:else>
    <text class="intro">记录已经持有的次数权益。一次记录对应一个有效期，到期后不会自动补充次数。</text>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view wx:if="{{dirty}}" class="notice {{!draftSaved ? 'warning' : ''}}">{{draftSaved ? '填写内容已暂存本机，保存权益后才会更新记录。' : '本机草稿暂存失败，请保持此页面并完成保存。'}}</view>
    <view wx:if="{{formError}}" class="notice error-notice">{{formError}}</view>
    <view wx:if="{{conflict}}" class="notice warning">这条权益已有更新。读取最新记录会保留当前填写内容，请核对后再次保存。<button bindtap="reloadLatest" loading="{{reloading}}" disabled="{{saving || reloading || identityChanged}}">读取最新记录</button></view>
    <view wx:if="{{errorSummary.length}}" class="validation-summary" id="entitlement-errors" role="alert"><text class="validation-title">请检查以下内容</text><button wx:for="{{errorSummary}}" wx:key="field" class="validation-link" data-field="{{item.field}}" bindtap="focusError" disabled="{{saving || reloading || pending || identityChanged}}">{{item.label}}：{{item.message}}</button></view>

    <view class="section" id="section-basic">
      <button class="section-heading" data-section="basic" bindtap="toggleSection" aria-expanded="{{openSection === 'basic'}}" disabled="{{saving || reloading || pending || identityChanged}}"><view><text class="section-title">基本信息</text><text class="section-summary">{{draft.title || '名称、类型与关联卡片'}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'basic' ? '收起' : '展开'}}</text></button>
      <view wx:if="{{openSection === 'basic'}}" class="section-body">
        <view class="field" id="field-title"><label class="field-label" for="title">权益名称 <text class="optional">必填</text></label><input id="title" class="form-input" value="{{draft.title}}" data-field="title" bindinput="input" focus="{{focusField === 'title'}}" maxlength="80" placeholder="例如：年度机场贵宾厅 6 次" placeholder-class="placeholder" disabled="{{saving || reloading || pending || identityChanged}}" /><text wx:if="{{errors.title}}" class="field-error">{{errors.title}}</text></view>
        <view class="field" id="field-kind"><text class="field-label">权益类型</text><picker range="{{kinds}}" range-key="label" value="{{kindIndex}}" aria-label="权益类型，{{kinds[kindIndex].label}}" data-field="kind" bindchange="select" disabled="{{saving || reloading || pending || identityChanged}}"><view class="select-input"><text>{{kinds[kindIndex].label}}</text><text aria-hidden="true">选择</text></view></picker><text wx:if="{{errors.kind}}" class="field-error">{{errors.kind}}</text></view>
        <view class="field" id="field-cardId"><text class="field-label">关联卡片 <text class="optional">选填</text></text><picker range="{{cardChoices}}" range-key="label" value="{{cardIndex}}" aria-label="关联卡片，{{cardChoices[cardIndex].label}}" data-field="cardId" bindchange="select" disabled="{{saving || reloading || pending || identityChanged}}"><view class="select-input"><text>{{cardChoices[cardIndex].label}}</text><text aria-hidden="true">选择</text></view></picker><text class="field-help">没有关联卡片，也可以单独管理这条权益。</text><text wx:if="{{errors.cardId}}" class="field-error">{{errors.cardId}}</text></view>
        <view class="field" id="field-provider"><label class="field-label" for="provider">提供方 <text class="optional">选填</text></label><input id="provider" class="form-input" value="{{draft.provider}}" data-field="provider" bindinput="input" focus="{{focusField === 'provider'}}" maxlength="120" placeholder="银行、权益平台或服务机构" placeholder-class="placeholder" disabled="{{saving || reloading || pending || identityChanged}}" /><text wx:if="{{errors.provider}}" class="field-error">{{errors.provider}}</text></view>
        <button class="next-section" data-section="quota" bindtap="toggleSection" disabled="{{saving || reloading || pending || identityChanged}}">填写次数与有效期<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="section" id="section-quota">
      <button class="section-heading" data-section="quota" bindtap="toggleSection" aria-expanded="{{openSection === 'quota'}}" disabled="{{saving || reloading || pending || identityChanged}}"><view><text class="section-title">次数与有效期</text><text class="section-summary">{{draft.totalUses !== '' ? '总计 ' + draft.totalUses + ' 次 · 剩余 ' + remaining + ' 次' : '总次数、已使用次数与到期日期'}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'quota' ? '收起' : '展开'}}</text></button>
      <view wx:if="{{openSection === 'quota'}}" class="section-body">
        <view class="field" id="field-totalUses"><label class="field-label" for="totalUses">本有效期总次数 <text class="optional">必填</text></label><input id="totalUses" class="form-input" type="number" value="{{draft.totalUses}}" data-field="totalUses" bindinput="input" focus="{{focusField === 'totalUses'}}" maxlength="4" placeholder="例如：6" placeholder-class="placeholder" disabled="{{saving || reloading || pending || identityChanged}}" /><text wx:if="{{errors.totalUses}}" class="field-error">{{errors.totalUses}}</text></view>
        <view class="field" id="field-initialUsed"><label class="field-label" for="initialUsed">录入前已使用</label><input id="initialUsed" class="form-input" type="number" value="{{draft.initialUsed}}" data-field="initialUsed" bindinput="input" focus="{{focusField === 'initialUsed'}}" maxlength="4" placeholder="没有使用过填 0" placeholder-class="placeholder" disabled="{{saving || reloading || pending || identityChanged}}" /><text class="field-help">{{editing ? '仅用于修正录入前的历史次数。之后每次使用请在权益详情中记录，已有使用记录不会被这里的修改覆盖。' : '只计入添加这条权益之前用过的次数，不会生成逐次使用记录。'}}</text><text wx:if="{{errors.initialUsed}}" class="field-error">{{errors.initialUsed}}</text></view>
        <view class="quota-preview"><view><text class="quota-caption">保存后剩余</text><text class="quota-calculation">录入前 {{draft.initialUsed || '0'}} 次{{editing ? ' · 已记录使用 ' + trackedUsed + ' 次' : ''}}</text></view><text class="quota-value">{{remaining}}<text class="quota-unit">次</text></text></view>
        <view class="field" id="field-startsOn"><text class="field-label">生效日期 <text class="optional">必填</text></text><picker mode="date" value="{{draft.startsOn || today}}" aria-label="生效日期，{{draft.startsOn || '尚未选择'}}" data-field="startsOn" bindchange="input" disabled="{{saving || reloading || pending || identityChanged}}"><view class="select-input"><text>{{draft.startsOn || '选择生效日期'}}</text><text aria-hidden="true">选择</text></view></picker><text wx:if="{{errors.startsOn}}" class="field-error">{{errors.startsOn}}</text></view>
        <view class="field" id="field-endsOn"><text class="field-label">到期日期 <text class="optional">必填</text></text><picker mode="date" value="{{draft.endsOn || today}}" start="{{draft.startsOn}}" aria-label="到期日期，{{draft.endsOn || '尚未选择'}}" data-field="endsOn" bindchange="input" disabled="{{saving || reloading || pending || identityChanged}}"><view class="select-input"><text>{{draft.endsOn || '选择到期日期'}}</text><text aria-hidden="true">选择</text></view></picker><text class="field-help">下一期获得新次数时，请另建一条权益。{{editing ? '有效期必须覆盖已有使用记录的日期。' : ''}}</text><text wx:if="{{errors.endsOn}}" class="field-error">{{errors.endsOn}}</text></view>
        <button class="next-section" data-section="transfer" bindtap="toggleSection" disabled="{{saving || reloading || pending || identityChanged}}">填写转让与补充说明<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view class="section" id="section-transfer">
      <button class="section-heading" data-section="transfer" bindtap="toggleSection" aria-expanded="{{openSection === 'transfer'}}" disabled="{{saving || reloading || pending || identityChanged}}"><view><text class="section-title">转让与补充说明</text><text class="section-summary">{{transfers[transferIndex].label}}</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'transfer' ? '收起' : '展开'}}</text></button>
      <view wx:if="{{openSection === 'transfer'}}" class="section-body">
        <view class="field" id="field-transferability"><text class="field-label">可转让性</text><picker range="{{transfers}}" range-key="label" value="{{transferIndex}}" aria-label="可转让性，{{transfers[transferIndex].label}}" data-field="transferability" bindchange="select" disabled="{{saving || reloading || pending || identityChanged}}"><view class="select-input"><text>{{transfers[transferIndex].label}}</text><text aria-hidden="true">选择</text></view></picker><text class="field-help">按提供方规则填写。允许携伴不等于权益可以转让。</text><text wx:if="{{errors.transferability}}" class="field-error">{{errors.transferability}}</text></view>
        <view wx:if="{{draft.transferability === 'grey'}}" class="transfer-note">官方未明确允许，请先自行核实</view>
        <view class="field" id="field-transferNote"><label class="field-label" for="transferNote">转让说明 <text class="optional">选填</text></label><textarea id="transferNote" class="form-textarea" value="{{draft.transferNote}}" data-field="transferNote" bindinput="input" focus="{{focusField === 'transferNote'}}" maxlength="1000" auto-height placeholder="例如：是否需要持卡人到场、转让方式或限制" placeholder-class="placeholder" disabled="{{saving || reloading || pending || identityChanged}}" /><text wx:if="{{errors.transferNote}}" class="field-error">{{errors.transferNote}}</text></view>
        <view class="field" id="field-notes"><label class="field-label" for="notes">补充说明 <text class="optional">选填</text></label><textarea id="notes" class="form-textarea" value="{{draft.notes}}" data-field="notes" bindinput="input" focus="{{focusField === 'notes'}}" maxlength="2000" auto-height placeholder="{{draft.kind === 'health_check' ? '例如：体检机构、预约方式、适用套餐及使用限制' : '例如：领取途径、核销方式或其他使用限制'}}" placeholder-class="placeholder" disabled="{{saving || reloading || pending || identityChanged}}" /><text wx:if="{{errors.notes}}" class="field-error">{{errors.notes}}</text></view>
        <button wx:if="{{draft.kind === 'lounge' || draft.lounges.length}}" class="next-section" data-section="lounges" bindtap="toggleSection" disabled="{{saving || reloading || pending || identityChanged}}">填写可用贵宾厅<text aria-hidden="true">›</text></button>
      </view>
    </view>

    <view wx:if="{{draft.kind === 'lounge' || draft.lounges.length}}" class="section" id="section-lounges">
      <button class="section-heading" data-section="lounges" bindtap="toggleSection" aria-expanded="{{openSection === 'lounges'}}" disabled="{{saving || reloading || pending || identityChanged}}"><view><text class="section-title">可用贵宾厅<text class="lounge-count">{{draft.lounges.length}} / 30</text></text><text class="section-summary">每个贵宾厅分别记录预约与客户限制</text></view><text class="disclosure" aria-hidden="true">{{openSection === 'lounges' ? '收起' : '展开'}}</text></button>
      <view wx:if="{{openSection === 'lounges'}}" class="section-body" id="field-lounges">
        <text class="field-help">同一权益在不同机场的规则可能不同。未核实的规则会保留为「待核实」。</text>
        <view class="lounge-list"><button wx:for="{{loungeRows}}" wx:key="id" class="lounge-row" data-index="{{index}}" bindtap="openLounge" disabled="{{saving || reloading || pending || identityChanged}}"><view class="lounge-head"><text class="lounge-name">{{item.title}}</text><text class="lounge-edit">编辑</text></view><text class="lounge-location">{{item.location}}</text><text class="rule-line">{{item.banks}}</text><text class="rule-line">{{item.reservation}}</text><text class="rule-line">{{item.customer}}</text><text wx:if="{{item.error}}" class="field-error">{{item.error}}</text></button></view>
        <view wx:if="{{!loungeRows.length}}" class="lounge-empty">还没有记录贵宾厅。可先保存权益，之后再补充已核实的机场与使用规则。</view>
        <text wx:if="{{errors.lounges}}" class="field-error">{{errors.lounges}}</text>
        <button class="add-lounge" bindtap="openLounge" disabled="{{saving || reloading || pending || identityChanged || draft.lounges.length >= 30}}">{{draft.lounges.length >= 30 ? '已达到 30 个贵宾厅上限' : '添加贵宾厅'}}</button>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{ready && !loading && !loungeVisible}}" class="editor-dock"><button class="back-button" bindtap="back" disabled="{{saving || reloading}}">返回</button><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || reloading || identityChanged || conflict || saved}}">{{saving ? '正在保存' : pending ? '重试上次保存' : '保存权益'}}</button></view>

<app-sheet show="{{loungeVisible}}" title="{{loungeIndex < 0 ? '添加贵宾厅' : '编辑贵宾厅'}}" dismissible="{{!saving && !reloading}}" bindclose="closeLounge" scroll-into-view="{{loungeScrollTarget}}" content-state="{{[loungeVisible, loungeAdvanced, loungeDraft.reservation, loungeDraft.customerScope, loungeErrorSummary]}}">
  <block wx:if="{{loungeDraft}}">
    <text class="sheet-note">确认后加入当前权益，保存权益后生效。</text>
    <view wx:if="{{loungeErrorSummary.length}}" class="validation-summary" role="alert"><text class="validation-title">请检查贵宾厅规则</text><button wx:for="{{loungeErrorSummary}}" wx:key="field" class="validation-link" data-field="{{item.field}}" bindtap="focusLoungeError">{{item.label}}：{{item.message}}</button></view>
    <text class="sheet-section-title first">机场与贵宾厅</text>
    <view class="field" id="lounge-field-airportName"><label class="field-label" for="airportName">机场名称 <text class="optional">必填</text></label><input id="airportName" class="form-input" value="{{loungeDraft.airportName}}" data-field="airportName" bindinput="loungeInput" focus="{{loungeFocus === 'airportName'}}" maxlength="120" placeholder="例如：首都国际机场" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.airportName}}" class="field-error">{{loungeErrors.airportName}}</text></view>
    <view class="field" id="lounge-field-airportCode"><label class="field-label" for="airportCode">机场三字码 <text class="optional">选填</text></label><input id="airportCode" class="form-input" value="{{loungeDraft.airportCode}}" data-field="airportCode" bindinput="loungeInput" focus="{{loungeFocus === 'airportCode'}}" maxlength="3" placeholder="例如：PEK" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.airportCode}}" class="field-error">{{loungeErrors.airportCode}}</text></view>
    <view class="field" id="lounge-field-city"><label class="field-label" for="city">城市 <text class="optional">选填</text></label><input id="city" class="form-input" value="{{loungeDraft.city}}" data-field="city" bindinput="loungeInput" focus="{{loungeFocus === 'city'}}" maxlength="80" placeholder="例如：北京" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.city}}" class="field-error">{{loungeErrors.city}}</text></view>
    <view class="field" id="lounge-field-loungeName"><label class="field-label" for="loungeName">贵宾厅名称 <text class="optional">必填</text></label><input id="loungeName" class="form-input" value="{{loungeDraft.loungeName}}" data-field="loungeName" bindinput="loungeInput" focus="{{loungeFocus === 'loungeName'}}" maxlength="120" placeholder="填写权益清单中的具体贵宾厅名称" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.loungeName}}" class="field-error">{{loungeErrors.loungeName}}</text></view>
    <view class="field" id="lounge-field-terminal"><label class="field-label" for="terminal">航站楼 <text class="optional">选填</text></label><input id="terminal" class="form-input" value="{{loungeDraft.terminal}}" data-field="terminal" bindinput="loungeInput" focus="{{loungeFocus === 'terminal'}}" maxlength="40" placeholder="例如：T3" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.terminal}}" class="field-error">{{loungeErrors.terminal}}</text></view>
    <view class="field" id="lounge-field-zone"><text class="field-label">出发区域</text><picker range="{{zones}}" range-key="label" value="{{zoneIndex}}" aria-label="出发区域，{{zones[zoneIndex].label}}" data-field="zone" bindchange="loungeSelect"><view class="select-input"><text>{{zones[zoneIndex].label}}</text><text aria-hidden="true">选择</text></view></picker><text wx:if="{{loungeErrors.zone}}" class="field-error">{{loungeErrors.zone}}</text></view>
    <view class="field" id="lounge-field-supportedBanksInput"><label class="field-label" for="supportedBanksInput">支持的银行 <text class="optional">选填</text></label><textarea id="supportedBanksInput" class="form-textarea" value="{{loungeDraft.supportedBanksInput}}" data-field="supportedBanksInput" bindinput="loungeInput" focus="{{loungeFocus === 'supportedBanksInput'}}" maxlength="5000" auto-height placeholder="每行填写一家银行" placeholder-class="placeholder" /><text class="field-help">每行一家，也可用逗号、顿号或分号分隔。最多 30 家，每家名称不超过 120 个字符。请填写已核实支持的银行，不要把服务平台填为银行。</text><text wx:if="{{loungeErrors.supportedBanksInput}}" class="field-error">{{loungeErrors.supportedBanksInput}}</text></view>

    <text class="sheet-section-title">预约要求</text>
    <view class="field" id="lounge-field-reservation"><text class="field-label">是否需要预约</text><picker range="{{reservations}}" range-key="label" value="{{reservationIndex}}" aria-label="是否需要预约，{{reservations[reservationIndex].label}}" data-field="reservation" bindchange="loungeSelect"><view class="select-input"><text>{{reservations[reservationIndex].label}}</text><text aria-hidden="true">选择</text></view></picker><text wx:if="{{loungeErrors.reservation}}" class="field-error">{{loungeErrors.reservation}}</text></view>
    <view wx:if="{{loungeDraft.reservation === 'required'}}" class="field" id="lounge-field-advanceHours"><label class="field-label" for="advanceHours">至少提前多少小时</label><input id="advanceHours" class="form-input" type="number" value="{{loungeDraft.advanceHours}}" data-field="advanceHours" bindinput="loungeInput" focus="{{loungeFocus === 'advanceHours'}}" maxlength="3" placeholder="例如：4" placeholder-class="placeholder" /><text class="field-help">例如需提前 4 小时预约，请填写 4。提前时限待核实时填 0；即时预约等具体规则可补充在下方说明中。</text><text wx:if="{{loungeErrors.advanceHours}}" class="field-error">{{loungeErrors.advanceHours}}</text></view>
    <view class="field" id="lounge-field-reservationNote"><label class="field-label" for="reservationNote">预约说明 <text class="optional">选填</text></label><textarea id="reservationNote" class="form-textarea" value="{{loungeDraft.reservationNote}}" data-field="reservationNote" bindinput="loungeInput" focus="{{loungeFocus === 'reservationNote'}}" maxlength="1000" auto-height placeholder="预约入口、取消时限或其他限制" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.reservationNote}}" class="field-error">{{loungeErrors.reservationNote}}</text></view>

    <text class="sheet-section-title">适用客户</text>
    <view class="field" id="lounge-field-customerScope"><text class="field-label">哪些客户可以使用</text><picker range="{{customerScopes}}" range-key="label" value="{{customerIndex}}" aria-label="哪些客户可以使用，{{customerScopes[customerIndex].label}}" data-field="customerScope" bindchange="loungeSelect"><view class="select-input"><text>{{customerScopes[customerIndex].label}}</text><text aria-hidden="true">选择</text></view></picker><text wx:if="{{loungeErrors.customerScope}}" class="field-error">{{loungeErrors.customerScope}}</text></view>
    <view class="field" id="lounge-field-customerNote"><label class="field-label" for="customerNote">客户限制说明 <text class="optional">{{loungeDraft.customerScope === 'local_bank' || loungeDraft.customerScope === 'specified' ? '必填' : '选填'}}</text></label><textarea id="customerNote" class="form-textarea" value="{{loungeDraft.customerNote}}" data-field="customerNote" bindinput="loungeInput" focus="{{loungeFocus === 'customerNote'}}" maxlength="1000" auto-height placeholder="请写明银行、当地地区或客户等级等具体条件" placeholder-class="placeholder" /><text class="field-help">选择「仅本地银行客户」时，请明确是哪家银行、哪个地区。</text><text wx:if="{{loungeErrors.customerNote}}" class="field-error">{{loungeErrors.customerNote}}</text></view>

    <button class="advanced-toggle" bindtap="toggleLoungeAdvanced" aria-expanded="{{loungeAdvanced}}">同行人、扣次与详细规则<text aria-hidden="true">{{loungeAdvanced ? '收起' : '展开'}}</text></button>
    <view wx:if="{{loungeAdvanced}}">
      <view class="field" id="lounge-field-guestNote"><label class="field-label" for="guestNote">同行人规则 <text class="optional">选填</text></label><textarea id="guestNote" class="form-textarea" value="{{loungeDraft.guestNote}}" data-field="guestNote" bindinput="loungeInput" focus="{{loungeFocus === 'guestNote'}}" maxlength="1000" auto-height placeholder="可携带人数、儿童规则及额外费用" placeholder-class="placeholder" /><text class="field-help">携伴规则独立于权益转让规则。</text><text wx:if="{{loungeErrors.guestNote}}" class="field-error">{{loungeErrors.guestNote}}</text></view>
      <view class="field" id="lounge-field-openingHours"><label class="field-label" for="openingHours">营业时间 <text class="optional">选填</text></label><input id="openingHours" class="form-input" value="{{loungeDraft.openingHours}}" data-field="openingHours" bindinput="loungeInput" focus="{{loungeFocus === 'openingHours'}}" maxlength="200" placeholder="例如：06:00–22:00" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.openingHours}}" class="field-error">{{loungeErrors.openingHours}}</text></view>
      <view class="field" id="lounge-field-location"><label class="field-label" for="location">具体位置 <text class="optional">选填</text></label><textarea id="location" class="form-textarea" value="{{loungeDraft.location}}" data-field="location" bindinput="loungeInput" focus="{{loungeFocus === 'location'}}" maxlength="300" auto-height placeholder="安检前后、楼层、附近登机口" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.location}}" class="field-error">{{loungeErrors.location}}</text></view>
      <view class="field" id="lounge-field-unitsPerVisit"><label class="field-label" for="unitsPerVisit">每次使用扣除次数</label><input id="unitsPerVisit" class="form-input" type="number" value="{{loungeDraft.unitsPerVisit}}" data-field="unitsPerVisit" bindinput="loungeInput" focus="{{loungeFocus === 'unitsPerVisit'}}" maxlength="4" placeholder="通常为 1" placeholder-class="placeholder" /><text class="field-help">按这条权益的计次规则填写，实际使用时可核对。</text><text wx:if="{{loungeErrors.unitsPerVisit}}" class="field-error">{{loungeErrors.unitsPerVisit}}</text></view>
      <view class="field" id="lounge-field-sourceNote"><label class="field-label" for="sourceNote">规则来源 <text class="optional">选填</text></label><textarea id="sourceNote" class="form-textarea" value="{{loungeDraft.sourceNote}}" data-field="sourceNote" bindinput="loungeInput" focus="{{loungeFocus === 'sourceNote'}}" maxlength="1000" auto-height placeholder="例如：权益平台的机场清单、官方说明或客服答复" placeholder-class="placeholder" /><text wx:if="{{loungeErrors.sourceNote}}" class="field-error">{{loungeErrors.sourceNote}}</text></view>
      <view class="field" id="lounge-field-verifiedOn"><text class="field-label">最近核实日期 <text class="optional">选填</text></text><picker mode="date" value="{{loungeDraft.verifiedOn || today}}" end="{{today}}" aria-label="最近核实日期，{{loungeDraft.verifiedOn || '尚未记录'}}" data-field="verifiedOn" bindchange="loungeInput"><view class="select-input"><text>{{loungeDraft.verifiedOn || '尚未记录核实日期'}}</text><text aria-hidden="true">选择</text></view></picker><text wx:if="{{loungeErrors.verifiedOn}}" class="field-error">{{loungeErrors.verifiedOn}}</text><button wx:if="{{loungeDraft.verifiedOn}}" class="clear-date" bindtap="clearVerifiedOn">清除核实日期</button></view>
    </view>
    <view class="sheet-actions"><button class="cancel-button" bindtap="closeLounge">取消</button><button class="primary" bindtap="commitLounge">{{loungeIndex === -1 ? '加入权益' : '确认修改'}}</button></view>
    <button wx:if="{{loungeIndex >= 0}}" class="remove-lounge" bindtap="removeLounge">移除这个贵宾厅</button>
  </block>
</app-sheet>
