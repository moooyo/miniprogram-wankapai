.entitlement-editor{min-height:100vh;background:var(--surface);padding-bottom:calc(108px + env(safe-area-inset-bottom))}
.intro{display:block;color:var(--muted);font-size:14px;line-height:1.7;margin:0 0 24px}
.status{padding:40px 8px;text-align:center;color:var(--muted);font-size:14px}.status-title{display:block;color:var(--ink);font-size:18px;font-weight:600;margin-bottom:8px}.status-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.status-actions button{flex:1}
.notice{padding:14px 16px;border-radius:8px;background:var(--tint);color:#355578;font-size:14px;line-height:1.7;margin-bottom:16px}.notice.warning{background:#fff6ee;color:#8c481e}.notice.error-notice{background:#fff5f3;color:var(--danger)}.notice button{margin-top:8px!important;width:100%!important;background:var(--surface);color:inherit;border:1px solid currentColor}
.validation-summary{border:1px solid #c78376;background:#fff6f2;border-radius:8px;padding:16px;margin-bottom:20px;color:var(--danger)}.validation-title{font-size:16px;font-weight:600;display:block}.validation-link{display:block!important;text-align:left;min-height:48px;padding:12px 0;width:100%!important;background:transparent;color:var(--danger);font-size:14px;white-space:normal;overflow-wrap:anywhere}
.section{border-top:1px solid var(--line);padding-bottom:8px}.section-heading{display:flex;justify-content:space-between;width:100%!important;padding:20px 0;text-align:left;gap:16px;background:transparent;min-height:72px;border-radius:0;color:var(--ink)}.section-heading>view{min-width:0;flex:1}.section-title{display:block;font-size:17px;font-weight:600}.section-summary{display:block;margin-top:4px;font-size:14px;color:var(--muted);font-weight:400;line-height:1.6}.disclosure{flex-shrink:0;color:var(--brand);font-size:14px}.section-body{padding:4px 0 20px}
.field{margin-bottom:24px;gap:8px}.field-label{display:block;font-size:16px;font-weight:500;color:var(--ink)}.optional{color:var(--muted);font-size:14px;font-weight:400}.field-help{display:block;color:var(--muted);font-size:14px;line-height:1.7}.field-error{display:block;color:var(--danger);font-size:14px;line-height:1.65}.form-input,.select-input,.form-textarea{width:100%;border:1px solid var(--control-border);border-radius:8px;padding:12px;color:var(--ink);background:var(--surface);font-size:16px;line-height:1.5}.form-input{height:48px;min-height:48px}.select-input{min-height:48px;display:flex;justify-content:space-between;align-items:center;gap:12px;overflow-wrap:anywhere}.select-input>text:first-child{min-width:0}.select-input>text:last-child:not(:first-child){color:var(--muted);flex-shrink:0}.form-textarea{min-height:96px}.placeholder{color:var(--muted)}
.quota-preview{display:flex;justify-content:space-between;align-items:baseline;gap:16px;background:var(--tint);border-left:3px solid var(--brand);padding:16px;margin:8px 0 24px;color:var(--ink)}.quota-caption{font-size:14px;color:#355578}.quota-value{font-size:28px;font-weight:650;line-height:1.2;font-variant-numeric:tabular-nums;word-break:break-all}.quota-unit{font-size:14px;font-weight:400;margin-left:6px}.quota-calculation{display:block;font-size:14px;color:#355578;margin-top:8px}
.next-section{display:flex;justify-content:space-between;text-align:left;width:100%!important;background:var(--tint);color:var(--brand);font-size:14px;padding:14px 16px}.transfer-note{background:#fff6ee;color:#8c481e;padding:12px 14px;border-radius:8px;margin:0 0 24px;font-size:14px;line-height:1.7}
.lounge-list{margin:16px 0}.lounge-row{display:block!important;text-align:left;width:100%!important;border:1px solid var(--line);border-radius:10px;background:var(--surface);padding:16px;margin-bottom:12px!important;white-space:normal}.lounge-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.lounge-name{min-width:0;font-size:16px;font-weight:600;color:var(--ink);overflow-wrap:anywhere}.lounge-edit{color:var(--brand);font-size:14px;flex-shrink:0}.lounge-location{display:block;color:var(--muted);font-size:14px;margin:6px 0 12px;line-height:1.7;overflow-wrap:anywhere}.rule-line{display:block;color:#355578;background:#f3f7fc;font-size:14px;line-height:1.7;padding:8px 10px;margin-top:6px;border-radius:6px;overflow-wrap:anywhere}.lounge-empty{font-size:14px;color:var(--muted);line-height:1.7;padding:16px 0}.add-lounge{width:100%!important;border:1px solid var(--brand);background:var(--surface);color:var(--brand);font-size:16px}.lounge-count{font-size:14px;color:var(--muted);font-weight:400;margin-left:8px}
.editor-dock{position:fixed;z-index:10;bottom:0;left:0;right:0;display:flex;gap:12px;padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--surface)}.editor-dock .primary{flex:1;font-size:16px;min-width:0}.editor-dock .back-button{flex:none;color:var(--muted);background:var(--surface);border:1px solid var(--line);font-size:14px}.dock-hidden{display:none}
.sheet-note{display:block;font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:24px}.sheet-section-title{font-size:16px;font-weight:600;color:var(--ink);display:block;border-top:1px solid var(--line);padding:20px 0 16px}.sheet-section-title.first{border-top:0;padding-top:0}.advanced-toggle{display:flex;justify-content:space-between;text-align:left;width:100%!important;background:transparent;border-top:1px solid var(--line);border-radius:0;padding:16px 0;color:var(--brand);font-size:14px}.sheet-actions{display:flex;flex-wrap:wrap;gap:12px;border-top:1px solid var(--line);padding-top:20px;margin-top:12px}.sheet-actions button{flex:1;font-size:16px;min-width:104px}.cancel-button{border:1px solid var(--control-border);background:var(--surface);color:var(--muted)}.remove-lounge{color:var(--danger);background:transparent;width:100%!important;margin-top:12px!important;font-size:14px}.limit-hint{display:block;font-size:14px;color:var(--muted);margin-top:12px}
.clear-date{align-self:flex-start;color:var(--brand);background:transparent;font-size:14px;padding:10px 0;min-height:48px}
