.rewards-page { background:#fff; min-height:100vh; padding-bottom:40rpx; }
.heading { font-size:48rpx; font-weight:650; color:#14243a; padding:12rpx 0 28rpx; }
.tabs { display:flex; gap:36rpx; border-bottom:1rpx solid #e5eaf1; }
.tab { background:transparent; border-radius:0; margin:0; padding:0 0 4rpx; min-height:48px; font-size:30rpx; color:#647084; border-bottom:4rpx solid transparent; }
.tab::after,.ledger-row::after,.pending-open::after,.load-more::after { border:0; }
.tab.active { color:#1764d9; border-bottom-color:#1764d9; font-weight:600; }
.tab text { margin-left:6rpx; font-size:14px; }
.reward-filters { gap:16rpx; padding:12rpx 0; min-height:48px; flex-wrap:wrap; }
.picker-text { font-size:26rpx; color:#243b58; min-height:48px; display:flex; align-items:center; gap:16rpx; }
.picker-text text { color:#647084; font-size:30rpx; }
.currency-picker { color:#647084; }
.all-periods { font-size:14px; color:#647084; }
.income-summary { padding:28rpx 0 36rpx; }
.income-summary > .text-muted { font-size:26rpx; }
.income-total { font-size:64rpx; line-height:1.3; font-weight:600; color:#14243a; letter-spacing:-1rpx; font-variant-numeric:tabular-nums; margin:12rpx 0; }
.income-note { font-size:14px; line-height:1.6; color:#647084; }
.income-breakdown { display:flex; flex-wrap:wrap; gap:12px 24px; margin:12px 0 16px; }
.income-breakdown > view { min-width:120px; flex:1; }
.income-kind { display:block; font-size:14px; color:#647084; }
.income-part { display:block; margin-top:4px; font-size:19px; line-height:1.5; color:#243b58; font-weight:600; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.ledger-kind { color:#315fa5; }
.section-heading { display:flex; justify-content:space-between; align-items:center; gap:16rpx; font-size:28rpx; padding:22rpx 0; border-bottom:1rpx solid #e5eaf1; font-weight:600; }
.section-heading .text-muted { font-size:14px; font-weight:400; }
.ledger-row { display:flex; align-items:flex-start; gap:22rpx; padding:28rpx 0; margin:0; border-radius:0; border-bottom:1rpx solid #e5eaf1; background:#fff; text-align:left; line-height:1.5; }
.ledger-date { width:70rpx; flex-shrink:0; font-size:14px; color:#647084; padding-top:3rpx; font-variant-numeric:tabular-nums; }
.ledger-main { min-width:0; flex:1; }
.bank-line { display:flex; align-items:center; gap:10rpx; flex-wrap:wrap; color:#647084; font-size:14px; }
.bank-logo { width:28rpx; height:28rpx; flex-shrink:0; }
.ledger-title { font-size:29rpx; color:#14243a; margin:8rpx 0; font-weight:500; }
.ledger-period { font-size:14px; color:#647084; }
.ledger-amount { color:#1764d9; font-size:27rpx; font-weight:600; font-variant-numeric:tabular-nums; flex-shrink:0; padding-top:3rpx; max-width:230rpx; overflow-wrap:anywhere; }
.pending-note { background:#f2f6fc; padding:22rpx 24rpx; color:#50627a; font-size:26rpx; line-height:1.6; border-radius:12rpx; margin:10rpx 0 12rpx; }
.pending-row { padding:26rpx 0; border-bottom:1rpx solid #e5eaf1; }
button.pending-open { display:block; width:100%; background:transparent; text-align:left; border-radius:0; padding:0; line-height:1.5; }
.pending-period { margin-left:auto; font-size:14px; }
.pending-title { font-size:32rpx; font-weight:600; color:#14243a; margin-top:10rpx; }
.expected { color:#647084; font-size:14px; margin-top:10rpx; }
.expected.late { color:#a8442c; }
.pending-footer { margin-top:18rpx; gap:16rpx; }
.pending-amount { color:#243b58; font-size:26rpx; font-variant-numeric:tabular-nums; }
.small-primary { color:#1764d9; background:#edf4ff; min-height:48px; line-height:48px; border-radius:12rpx; margin:0; padding:0 24rpx; font-size:26rpx; }
.small-primary::after { border:0; }
.loading,.empty { padding:64rpx 12rpx; text-align:center; font-size:28rpx; line-height:1.65; }
.empty-title { color:#14243a; font-size:32rpx; font-weight:600; margin-bottom:12rpx; }
.empty button { margin-top:28rpx; }
button.load-more { min-height:48px; margin-top:12rpx; color:#1764d9; background:#fff; font-size:27rpx; }
.record-card { display:block; color:#526579; font-size:14px; line-height:1.6; overflow-wrap:anywhere; margin:8rpx 0; }
.currency-tabs { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 16px; }
button.currency-tab { min-height:48px; margin:0; padding:8px 12px; background:#f2f6fc; border-radius:8px; font-size:14px; line-height:1.5; color:#526579; }
.currency-tab::after { border:0; }
button.currency-tab.selected { background:#e8f0ff; color:#1764d9; font-weight:600; box-shadow:inset 0 0 0 1px #b6d0f5; }
