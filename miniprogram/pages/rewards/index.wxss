.rewards-page { min-height:100vh; background:#F3F6FB; color:#0F1B2D; }
.rewards-content { padding:4px 16px calc(40px + env(safe-area-inset-bottom)); display:flex; flex-direction:column; gap:14px; }
.income-summary { padding:18px; border-radius:22px; background:#1F61D8; color:#FFFFFF; }
.summary-head { display:flex; align-items:baseline; justify-content:space-between; gap:8px; }
.summary-head picker { min-width:0; }
.summary-month,.summary-currency { display:flex; align-items:center; gap:4px; min-height:30px; font-size:13px; color:#E3ECFD; white-space:nowrap; }
.summary-currency { font-size:12px; }
.picker-arrow { font-size:14px; }
.income-total,.summary-stat-value,.summary-stat-note,.pending-amount,.ledger-date,.ledger-amount { font-family:"DM Mono","SFMono-Regular",Consolas,"PingFang SC",sans-serif; font-variant-numeric:tabular-nums; }
.income-total { font-size:36px; font-weight:500; line-height:1.25; letter-spacing:-1px; margin:2px 0 6px; overflow-wrap:anywhere; }
.income-subtitle { font-size:12px; color:#E3ECFD; }
.summary-divider { height:1px; background:#4C80E0; margin:16px 0; }
.summary-bottom { display:flex; justify-content:space-between; gap:12px; }
.summary-stat { display:flex; flex-direction:column; gap:3px; min-width:0; }
.summary-stat-right { align-items:flex-end; text-align:right; }
.summary-stat-label { font-size:12px; color:#E3ECFD; }
.summary-stat-value { font-size:15px; line-height:1.45; overflow-wrap:anywhere; }
.summary-stat-note { font-size:11px; line-height:1.45; color:#E3ECFD; overflow-wrap:anywhere; }
.section-heading { display:flex; align-items:center; gap:8px; min-height:30px; padding:4px 4px 0; }
.section-heading .section-title { font-size:15px; font-weight:600; }
.section-count { font-size:12px; color:#5E6E84; }
.section-hint { margin-left:auto; font-size:12px; color:#1A56C4; white-space:nowrap; }
.section-switch { display:flex; flex:none; gap:2px; margin-left:auto; padding:3px; border-radius:10px; background:#E8EDF5; }
button.section-tab { min-height:32px; padding:4px 10px; background:transparent; color:#5E6E84; border-radius:7px; font-size:12px; line-height:1.5; }
button.section-tab.selected { background:#FFFFFF; color:#1A56C4; box-shadow:0 1px 3px rgba(15,35,70,.1); }
.record-card-list { overflow:hidden; background:#FFFFFF; border:1px solid #E3E9F2; border-radius:18px; }
.pending-row { display:flex; align-items:center; padding:10px 6px 10px 14px; border-top:1px solid #E3E9F2; }
.pending-row:first-child,.ledger-row:first-child { border-top:0; }
button.pending-open { display:flex; flex:1; justify-content:flex-start; gap:10px; min-width:0; min-height:44px; padding:0; background:transparent; text-align:left; border-radius:0; }
.bank-logo,.bank-placeholder { flex:none; border-radius:50%; background:#FFFFFF; border:1px solid #EBF0F7; object-fit:contain; box-sizing:border-box; }
.bank-placeholder { display:flex; align-items:center; justify-content:center; color:#5E6E84; font-size:9px; overflow:hidden; }
.pending-logo { width:32px; height:32px; padding:3px; }
.pending-main,.ledger-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
.pending-title,.ledger-title { display:block; font-size:14px; font-weight:500; line-height:1.45; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.record-subtitle { display:block; font-size:11px; line-height:1.45; color:#5E6E84; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.expected { display:block; font-size:12px; font-weight:400; line-height:1.45; color:#2D7A4F; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.expected.late { color:#A65A20; }
.pending-amount { flex:none; max-width:90px; font-size:14px; font-weight:500; color:#0F1B2D; text-align:right; overflow-wrap:anywhere; }
button.pending-action { display:flex; flex:none; min-width:64px; min-height:44px; padding:0 6px; background:transparent; border-radius:0; }
.pending-action-label { display:flex; align-items:center; min-height:32px; padding:5px 10px; border-radius:999px; background:#E6EEFC; color:#1A56C4; font-size:12px; font-weight:600; white-space:nowrap; }
.pending-note,.income-note { display:block; margin:0 4px; color:#5E6E84; font-size:12px; line-height:1.6; }
.pending-note { margin-top:-6px; }
.currency-tabs { display:flex; flex-wrap:wrap; gap:6px; margin-top:-6px; }
button.currency-tab { min-height:36px; padding:6px 10px; border-radius:999px; background:#EBF0F7; color:#5E6E84; font-size:12px; }
button.currency-tab.selected { color:#1A56C4; background:#E6EEFC; font-weight:600; }
button.ledger-row { display:flex; align-items:center; gap:10px; width:100%; min-height:62px; padding:12px 14px; border-top:1px solid #E3E9F2; border-radius:0; background:#FFFFFF; text-align:left; }
.ledger-date { flex:none; width:32px; font-size:12px; font-weight:400; color:#5E6E84; }
.ledger-logo { width:26px; height:26px; padding:2px; }
.ledger-title { font-weight:400; }
.ledger-main { gap:2px; }
.ledger-amount { flex:none; max-width:94px; font-size:14px; font-weight:500; color:#2D7A4F; text-align:right; overflow-wrap:anywhere; }
.list-empty { padding:20px; color:#5E6E84; font-size:13px; text-align:center; }
.state-card { border:1px solid #E3E9F2; border-radius:18px; background:#FFFFFF; }
.loading,.empty { padding:32px 20px; text-align:center; color:#5E6E84; font-size:13px; line-height:1.6; }
.empty-title { margin-bottom:8px; color:#0F1B2D; font-size:15px; font-weight:600; }
.empty button { min-height:44px; margin:16px auto 0; border-radius:12px; font-size:13px; }
.refresh-notice { padding:12px 14px; border:1px solid #D8E4F6; border-radius:14px; color:#3F4D63; background:#E6EEFC; font-size:13px; line-height:1.6; }
button.load-more { min-height:44px; padding:8px 16px; border-radius:12px; background:#FFFFFF; color:#1A56C4; font-size:13px; }
.pagination-error { padding:0 4px; color:#AC3737; font-size:13px; }
@media (max-width:360px) {
  .summary-head { flex-wrap:wrap; gap:0; }
  .summary-month,.summary-currency { min-height:26px; }
  .pending-row { padding-left:10px; }
  .pending-open { gap:8px; }
  .pending-amount { max-width:72px; font-size:12px; }
  .pending-action-label { padding:5px 8px; font-size:11px; }
  .ledger-row { gap:8px; padding:12px 10px; }
  .ledger-date { width:28px; }
  .ledger-amount { max-width:78px; font-size:13px; }
  .section-switch { gap:0; }
  .section-tab { padding:4px 8px; }
}
