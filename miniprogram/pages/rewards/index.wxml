<view class="page rewards-page">
  <view class="heading">收益</view>
  <view class="tabs" role="tablist"><button class="tab {{tab === 'received' ? 'active' : ''}}" data-tab="received" bindtap="selectTab" role="tab" aria-selected="{{tab === 'received'}}">已记录</button><button class="tab {{tab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="selectTab" role="tab" aria-selected="{{tab === 'pending'}}">待确认 <text>{{pendingCount}}</text></button></view>
  <view class="reward-filters row-between">
    <picker wx:if="{{tab === 'received'}}" mode="date" fields="month" value="{{month}}" start="2020-01" end="{{maxDate}}" bindchange="changeMonth" aria-label="选择收益归属月份"><view class="picker-text">{{monthLabel}} <text>⌄</text></view></picker>
    <text wx:else class="all-periods">全部周期、全部币种共 {{pendingCount}} 笔</text>
    <picker wx:if="{{tab === 'received'}}" range="{{currencies}}" range-key="label" value="{{currencyIndex}}" bindchange="changeCurrency" aria-label="选择收益币种"><view class="picker-text currency-picker">{{currencies[currencyIndex].label}} <text>⌄</text></view></picker>
  </view>
  <view wx:if="{{refreshing || refreshError}}" class="refresh-notice" role="status"><text>{{refreshing ? '正在更新收益，已读记录仍然保留…' : refreshError}}</text><button wx:if="{{refreshError}}" class="load-more" bindtap="load">重新刷新</button></view>
  <view wx:if="{{loading}}" class="loading text-muted">正在更新收益…</view>
  <view wx:elif="{{failed}}" class="empty"><view class="empty-title">收益暂时无法加载</view><button class="secondary" bindtap="load">重试</button></view>
  <block wx:elif="{{tab === 'received'}}">
    <view class="income-summary {{!received.length ? 'is-empty' : ''}}"><text class="text-muted">所选月份已记录收益</text><view class="income-total">{{total}}</view><block wx:if="{{received.length}}"><view class="income-breakdown"><view><text class="income-kind">返现到账</text><text class="income-part income-cashback">{{cashbackTotal}}</text></view><view><text class="income-kind">已享优惠</text><text class="income-part income-discount">{{discountTotal}}</text></view></view><text class="income-note">返现按到账日期、立减按享受优惠日期统计，不合并不同币种。</text></block></view>
    <view wx:if="{{received.length}}" class="section-heading"><text>收益记录</text><text class="text-muted">点击可更正</text></view>
    <button wx:for="{{received}}" wx:key="id" class="ledger-row" data-id="{{item.id}}" bindtap="editReceived" disabled="{{refreshing || outdated}}">
      <view class="ledger-date">{{item.date}}</view><view class="ledger-main"><view class="bank-line"><image wx:if="{{item.logo}}" class="bank-logo" src="{{item.logo}}" mode="aspectFit" /><text>{{item.bank}}</text><text class="ledger-kind">{{item.kindLabel}}</text></view><view class="ledger-title">{{item.title}}</view><text wx:if="{{item.cardName}}" class="record-card">{{item.cardName}}</text><text class="ledger-period">来自 {{item.period}}活动</text></view><text class="ledger-amount">{{item.amountPrefix}}{{item.amount}}</text>
    </button>
    <text wx:if="{{loadMoreError}}" class="pagination-error" role="alert">{{loadMoreError}}</text>
    <button wx:if="{{nextCursor}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore || refreshing || outdated}}" bindtap="loadMore">{{loadMoreError ? '重试加载更多' : '加载更多记录'}}</button>
    <view wx:if="{{!received.length}}" class="empty income-empty"><view class="empty-title">这个月还没有收益记录</view><text class="text-muted">{{pendingCount ? '已完成的活动还在待确认中。返现到账或享受优惠后，记录实际金额。' : '返现按到账日期、立减按享受优惠日期统计。可以切换月份查看，或找一项活动参加。'}}</text><button wx:if="{{pendingCount}}" class="primary" data-tab="pending" bindtap="selectTab">查看全部待确认</button><button wx:else class="secondary" bindtap="openActivities">浏览活动</button></view>
  </block>
  <block wx:else>
    <view class="currency-tabs"><button wx:for="{{pendingCurrencies}}" wx:key="value" class="currency-tab {{currencyIndex === item.index ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="choosePendingCurrency" aria-pressed="{{currencyIndex === item.index}}">{{item.name}} {{item.count}} 笔</button></view>
    <view class="pending-note">返现收到后确认到账；立减享受后记录优惠，无需等待银行到账。跨月未确认的记录会一直保留。</view>
    <view class="section-heading"><text>{{currencies[currencyIndex].name}} {{pending.length}} 笔待确认</text><text class="text-muted">预计合计 {{pendingTotal}}</text></view>
    <view class="pending-row" wx:for="{{pending}}" wx:key="id">
      <button class="pending-open" data-id="{{item.id}}" bindtap="openPending" disabled="{{refreshing || outdated}}"><view class="bank-line"><image wx:if="{{item.logo}}" class="bank-logo" src="{{item.logo}}" mode="aspectFit" /><text>{{item.bank}}</text><text class="pending-period">{{item.period}}</text></view><view class="pending-title">{{item.title}}</view><text wx:if="{{item.cardName}}" class="record-card">{{item.cardName}}</text><view class="expected {{item.late ? 'late' : ''}}">{{item.expected}}{{item.late ? ' · 可向银行核实' : ''}}</view></button>
      <view class="row-between pending-footer"><text class="pending-amount">{{item.expectedLabel}} {{item.reward}}</text><button class="small-primary" data-id="{{item.id}}" bindtap="confirmPending" disabled="{{refreshing || outdated}}">{{item.recordAction}}</button></view>
    </view>
    <view wx:if="{{!pending.length}}" class="empty"><view class="empty-title">没有待确认的{{currencies[currencyIndex].label}}收益</view><text class="text-muted">返现收到后确认到账；立减享受后记录实际优惠。</text><button class="secondary" bindtap="openActivities">浏览活动</button></view>
  </block>
</view>
