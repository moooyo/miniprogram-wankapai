<design-nav title="玩卡派" subtitle="进度" />
<view class="page todo-page" aria-hidden="{{showActions}}">
  <view class="progress-intro"><text class="eyebrow">{{dateLabel}}</text><view class="heading">{{headline}}</view></view>
  <view wx:if="{{refreshing || refreshError}}" class="refresh-notice" role="status"><text>{{refreshing ? mutationNotice + '正在更新待办，已读记录和分组仍然保留…' : refreshError}}</text><button wx:if="{{refreshError}}" class="text-button" bindtap="load">重新刷新</button></view>
  <view class="loading text-muted" wx:if="{{loading}}">正在更新进度…</view>
  <view class="empty" wx:elif="{{failed}}"><view class="empty-title">进度暂时无法加载</view><button class="secondary" bindtap="load">重试</button></view>
  <block wx:else>
    <view wx:if="{{focusTask}}" class="focus-card">
      <view class="focus-top"><text class="next-label">下一步</text><text class="focus-position">{{focusPosition}}</text><view class="focus-controls"><button class="focus-arrow previous" data-direction="-1" bindtap="changeFocus" aria-label="上一个待办"><view class="arrow-shape" /></button><button class="focus-arrow next" data-direction="1" bindtap="changeFocus" aria-label="下一个待办"><view class="arrow-shape" /></button></view></view>
      <button class="focus-open" data-id="{{focusTask.id}}" bindtap="openTask" disabled="{{loading || refreshing || outdated || !!busyId}}"><view class="focus-bank"><image wx:if="{{focusTask.logo}}" class="focus-logo" src="{{focusTask.logo}}" mode="aspectFit" /><text>{{focusTask.bankLine}}</text></view><view class="focus-title">{{focusTask.title}}</view><view class="focus-reward">奖励 <text>{{focusTask.reward}}</text> · {{focusTask.rewardKind}}</view></button>
      <text wx:if="{{focusTask.showPeriod}}" class="focus-period">参与期 · {{focusTask.period}}</text>
      <view wx:if="{{focusTask.isSegment}}" class="progress-segments"><view wx:for="{{focusTask.segments}}" wx:key="index" class="progress-segment {{item.active ? 'filled' : ''}}" /></view>
      <view wx:else class="progress-track"><view class="progress-fill" style="width:{{focusTask.progressPct}}%;" /></view>
      <view class="focus-progress"><text class="focus-hint">{{focusTask.hint}}</text><text class="focus-numbers">{{focusTask.progressText}}</text></view>
      <view class="focus-deadline"><view class="clock-icon"><view class="clock-hand" /></view><text>{{focusTask.deadlineLabel}}</text></view>
      <view class="focus-actions"><button class="focus-primary" data-id="{{focusTask.id}}" bindtap="runPrimaryAction" loading="{{busyId === focusTask.id}}" disabled="{{loading || refreshing || outdated || !!busyId}}">{{focusTask.primaryLabel}}</button><button class="focus-detail" data-id="{{focusTask.id}}" bindtap="openTask" disabled="{{loading || refreshing || outdated || !!busyId}}">详情</button></view>
    </view>
    <view wx:else class="focus-empty empty"><view class="sheep-placeholder"><view class="sheep-face"><view class="sheep-eye left" /><view class="sheep-eye right" /></view></view><view class="empty-title">今日待办已全部完成</view><text class="text-muted">其余事项暂无临近截止</text><button wx:if="{{!allCount}}" class="secondary" bindtap="browse">去找一项活动</button></view>
    <view class="upcoming-section"><view class="section-heading"><text>近期待办</text><text class="section-count">{{upcomingCount}} 项</text></view><view wx:if="{{upcoming.length}}" class="upcoming-list"><button wx:for="{{upcoming}}" wx:key="id" class="upcoming-row {{item.done ? 'is-done' : ''}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openUpcoming" disabled="{{loading || refreshing || outdated || !!busyId}}"><view class="upcoming-date {{item.today || item.late ? 'is-urgent' : ''}}"><text class="date-top {{item.today ? 'is-today' : ''}}">{{item.dateTop}}</text><text class="date-sub">{{item.dateSub}}</text></view><image wx:if="{{item.logo}}" class="upcoming-logo" src="{{item.logo}}" mode="aspectFit" /><view class="upcoming-copy"><text class="upcoming-title">{{item.title}}</text><text class="upcoming-note {{item.done ? 'is-received' : ''}}">{{item.note}}</text></view><text class="upcoming-reward">{{item.reward}}</text></button></view><view wx:else class="upcoming-empty">暂时没有其他待办，可以安心安排下一步。</view></view>
    <button class="income-entry" bindtap="openIncome"><view class="income-copy"><text class="income-label">{{incomeMonth}}</text><text class="income-amount">{{incomeCny}}</text><text class="income-other">{{incomeOther}}</text></view><view class="income-pending" catchtap="openRewards"><text class="income-label">待确认 {{pendingCount}} 笔</text><text class="income-pending-amount">{{pendingShort}}</text></view><view class="income-arrow" /></button>
    <view class="management-entry"><button class="manager-toggle" bindtap="toggleManager">管理参与进度<text>{{showManager ? '收起' : '筛选与更多操作'}}</text><view class="manager-chevron {{showManager ? 'is-open' : ''}}" /></button></view>
    <view wx:if="{{showManager}}" class="task-manager">
      <view class="follow-ups" wx:if="{{pendingCount || billCount}}"><button class="follow-up" wx:if="{{pendingCount}}" bindtap="openRewards"><view class="follow-up-copy"><text class="text-muted">待确认</text><text class="follow-up-scope">全部币种</text></view><text class="follow-up-value">{{pendingCount}} 笔</text><text class="arrow">›</text></button><button class="follow-up" wx:if="{{billCount}}" bindtap="openWallet"><text class="text-muted">最近还款</text><text class="follow-up-value">{{nearestBill}}</text><text class="arrow">›</text></button></view>
      <view class="tabs" role="tablist"><button class="tab {{filter === 'unfinished' ? 'active' : ''}}" data-filter="unfinished" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'unfinished'}}">未完成 <text>{{unfinishedCount}}</text></button><button class="tab {{filter === 'completed' ? 'active' : ''}}" data-filter="completed" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'completed'}}">本期已完成 <text>{{completedCount}}</text></button><button class="tab {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="selectFilter" role="tab" aria-selected="{{filter === 'all'}}">当前记录 <text>{{allCount}}</text></button></view>
      <view wx:if="{{filter === 'unfinished'}}" class="closing-filter row-between"><text>仅看{{monthLabel}}</text><switch checked="{{closingOnly}}" color="#1F61D8" bindchange="toggleClosing" aria-label="仅显示本月底前截止的未完成活动" /></view><view wx:else class="scope-note">{{filter === 'completed' ? '显示各活动当前周期的完成结果。' : '显示当前周期及此前未完成记录。'}}历史结果请查看全部参与记录。</view>
      <view class="loading text-muted" wx:if="{{loading}}">正在更新待办…</view><view class="empty" wx:elif="{{failed}}"><view class="empty-title">待办暂时无法加载</view><button class="secondary" bindtap="load">重试</button></view>
      <view wx:elif="{{tasks.length}}" class="task-list"><block wx:for="{{tasks}}" wx:key="id"><view wx:if="{{item.showGroupTitle}}" class="task-group-heading {{item.groupKey}}" data-group="{{item.groupKey}}"><text>{{item.groupTitle}}</text><text class="task-group-count">{{item.groupCount}} 项</text></view><view class="task-row" data-id="{{item.id}}" data-group="{{item.groupKey}}"><view class="date-column {{item.late ? 'overdue' : ''}}" aria-label="{{item.deadline}}截止"><text class="date-day">{{item.dateDay}}</text><text class="date-month">{{item.dateMonth}}</text></view><view class="task-body"><button class="task-open" data-id="{{item.id}}" bindtap="openTask" disabled="{{loading || refreshing || outdated || !!busyId}}"><view class="bank-line"><image wx:if="{{item.logo}}" class="bank-logo" src="{{item.logo}}" mode="aspectFit" /><text>{{item.bank}}</text><text class="task-status">{{item.status}}</text></view><view class="task-title">{{item.title}}</view></button><text wx:if="{{item.showPeriod}}" class="task-period">参与期 · {{item.period}}</text><text wx:if="{{item.cardName}}" class="task-card">{{item.cardName}}</text><view class="task-meta"><text>{{item.resultNote || item.progress}}</text><view class="reward"><text>{{item.rewardLabel}} {{item.reward}}</text><text wx:if="{{item.estimate}}" class="original-estimate">原预计 {{item.estimate}}</text></view></view><view class="task-actions"><button class="small-primary task-primary" data-id="{{item.id}}" data-action="{{item.primaryAction}}" loading="{{busyId === item.id}}" disabled="{{loading || refreshing || outdated || !!busyId}}" bindtap="runPrimaryAction">{{item.primaryLabel}}</button><button class="more-button" data-id="{{item.id}}" bindtap="showMore" disabled="{{loading || refreshing || outdated || !!busyId}}" aria-label="{{item.period}} · {{item.title}}的更多操作">更多</button></view></view></view></block></view>
      <view class="empty" wx:else><view class="empty-title">{{filter === 'unfinished' && closingOnly ? '本月底前没有遗漏的活动' : filter === 'completed' ? '本期还没有完成的活动' : filter === 'all' ? '当前没有活动记录' : '当前没有未完成活动'}}</view><text class="text-muted">{{filter === 'completed' ? '更早的完成结果与已跳过活动，可在全部参与记录中查看。' : '每期单独记录，完成后也能在全部参与记录中回看。'}}</text><button class="secondary" bindtap="browse">浏览活动</button></view>
    </view>
    <button class="history-entry" bindtap="openHistory"><text>全部参与记录</text><text>往期、已记录与已跳过 <text aria-hidden="true">›</text></text></button>
  </block>
</view>
<app-sheet id="todo-actions" show="{{showActions}}" title="{{actionTitle || ''}}" content-state="{{[actionId, actionTitle, actionPeriod, actionDeadline, actionCardName, actionCanProgress, actionCanComplete, actionStage, actionReceiptLabel]}}" bindclose="closeActions">
  <view class="sheet-actions"><view class="action-context"><text class="action-period">参与期 · {{actionPeriod}}</text><text class="action-deadline">截止 {{actionDeadline}}</text></view><text wx:if="{{actionCardName}}" class="action-card">{{actionCardName}}</text><text class="action-note">这里只更新你的记录；银行报名和实际消费需在银行端完成。</text><button wx:if="{{actionCanProgress}}" class="task-more-progress" bindtap="editProgress" disabled="{{loading || refreshing || outdated || !!busyId}}">更新进度</button><button wx:if="{{actionCanComplete}}" class="task-more-complete" bindtap="complete" disabled="{{loading || refreshing || outdated || !!busyId}}">直接标记完成</button><button wx:if="{{actionStage !== 'received' && actionStage !== 'skipped'}}" class="task-more-receipt" bindtap="receipt" disabled="{{loading || refreshing || outdated || !!busyId}}">{{actionReceiptLabel}}</button><button wx:if="{{actionStage === 'completed'}}" bindtap="undoComplete" disabled="{{loading || refreshing || outdated || !!busyId}}">撤销完成</button><button wx:if="{{actionStage !== 'completed' && actionStage !== 'received'}}" bindtap="toggleSkip" disabled="{{loading || refreshing || outdated || !!busyId}}">{{actionStage === 'skipped' ? '恢复本期参与' : '本期不参加'}}</button><button data-id="{{actionId}}" bindtap="openTask" disabled="{{loading || refreshing || outdated || !!busyId}}">查看记录与活动入口</button></view>
</app-sheet>
