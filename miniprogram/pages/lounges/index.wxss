.lounges-page{padding-bottom:calc(32px + env(safe-area-inset-bottom))}.page-heading{margin-bottom:20px}.heading{font-size:26px;line-height:1.4;font-weight:600;margin-bottom:4px}.subtitle{font-size:14px;line-height:1.7;color:var(--muted);overflow-wrap:anywhere}.notice{padding:14px 16px;border:1px solid var(--line);border-radius:10px;background:var(--tint);font-size:14px;line-height:1.7;margin-bottom:16px;overflow-wrap:anywhere}.notice text{display:block}.registry-note{font-size:14px;line-height:1.7;color:var(--muted);margin:0 0 16px;overflow-wrap:anywhere}.scope-notice{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;background:var(--tint);border-radius:10px;margin-bottom:16px;overflow-wrap:anywhere}.scope-notice>view{min-width:0}.scope-notice .text-button{flex-shrink:0}
.search-panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:12px}.field{gap:0;margin-bottom:16px}.field-label{display:block;font-size:16px;margin-bottom:8px}.zone-filters{display:flex;gap:8px;flex-wrap:wrap}.zone-filter{flex:1 1 78px;min-width:0;min-height:48px;background:var(--surface);color:var(--muted);border:1px solid var(--control-border);padding:10px 8px}.zone-filter.selected{color:var(--brand);background:var(--tint);border-color:var(--brand)}.text-button{color:var(--brand);background:transparent;min-height:48px;padding:10px 8px}.clear-row{display:flex;justify-content:flex-end;margin-top:4px}.result-summary{font-size:14px;color:var(--muted);margin:0 0 12px;line-height:1.7}
.lounge-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);padding:18px 16px;margin-bottom:20px;overflow-wrap:anywhere}.airport-line{display:flex;align-items:center;flex-wrap:wrap;gap:8px;color:var(--brand);font-size:14px}.airport-code{padding:2px 7px;border-radius:4px;background:var(--tint);font-weight:600;letter-spacing:1px}.lounge-title{font-size:20px;font-weight:600;line-height:1.5;margin:8px 0}.location-line{font-size:14px;color:var(--muted);line-height:1.7}.supported-banks{margin-top:18px;padding:16px;background:var(--tint);border-radius:8px;border-left:3px solid var(--brand)}.bank-heading{font-size:14px;color:var(--muted);margin-bottom:8px}.bank-list{display:flex;flex-wrap:wrap;gap:8px}.bank-label{font-size:16px;line-height:1.5;font-weight:600;color:var(--brand);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:6px 10px;max-width:100%;overflow-wrap:anywhere}.bank-unknown{font-size:16px;font-weight:500;color:var(--ink)}.bank-help{display:block;font-size:14px;color:var(--muted);line-height:1.6;margin-top:10px}
.access-rules{padding:4px 0 16px;border-bottom:1px solid var(--line);margin-bottom:14px}.rule-row{display:flex;gap:12px;margin-top:16px;align-items:flex-start}.rule-label{flex:0 0 58px;font-size:14px;color:var(--muted);padding-top:2px}.rule-row>view{min-width:0;flex:1}.rule-value{font-size:16px;font-weight:600;line-height:1.6;color:var(--ink)}.rule-detail{font-size:14px;line-height:1.7;color:var(--ink);white-space:pre-wrap}.rule-value+.rule-detail{margin-top:4px}.additional-info{font-size:14px;color:var(--ink);line-height:1.7}.additional-info>view{display:flex;gap:12px;margin:8px 0;align-items:flex-start}.additional-info>view>text:last-child{min-width:0;flex:1;white-space:pre-wrap}.info-label{flex:0 0 58px;color:var(--muted)}.empty{display:flex;flex-direction:column;align-items:center;gap:16px;line-height:1.75}.empty-title{font-size:18px;font-weight:600;color:var(--ink)}
