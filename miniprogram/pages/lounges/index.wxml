<design-nav title="贵宾厅速查" back />
<view class="page lounges-page">
  <view class="search-field"><text class="search-symbol" aria-hidden="true"></text><input id="airport-query" class="airport-input" aria-label="机场名称、城市或三字码" value="{{search}}" bindinput="changeSearch" bindconfirm="confirmSearch" placeholder="搜索机场 / 城市 / 三字码" maxlength="100" confirm-type="search" /><button wx:if="{{search}}" class="clear-search" bindtap="clearFilters" aria-label="清除搜索">×</button></view>
  <view wx:if="{{entitlementId}}" class="scope-notice"><view><text class="subtitle">查询范围</text><view>{{scopeTitle || '指定权益'}}</view></view><button class="text-button" bindtap="clearScope">查看全部</button></view>
  <view wx:if="{{refreshing || outdated}}" class="notice" role="status"><text>{{refreshing ? '正在更新已登记资料…' : error}}</text><button wx:if="{{outdated}}" class="text-button" bindtap="load">重新刷新</button></view>
  <view wx:if="{{loading}}" class="empty" role="status">正在读取已登记的贵宾厅…</view><view wx:elif="{{failed}}" class="empty"><view class="empty-title">资料暂时无法加载</view><text>{{error}}</text><button class="secondary" bindtap="load">重新加载</button></view>
  <block wx:else>
    <block wx:if="{{showAirports}}"><view wx:if="{{recentAirports.length}}" class="landing-section"><view class="section-heading">最近查询</view><view class="recent-airports"><button wx:for="{{recentAirports}}" wx:key="key" class="recent-airport" data-value="{{item.key}}" bindtap="selectAirport"><text class="recent-code">{{item.code}}</text><text>{{item.name}}</text></button></view></view><view wx:if="{{programSummaries.length}}" class="landing-section"><view class="section-heading"><text>我的通道</text><text class="section-note">按已登记权益汇总</text></view><view class="program-list"><view wx:for="{{programSummaries}}" wx:key="value" class="program-row"><view class="program-identity"><text class="program-name">{{item.label}}</text><text class="program-cards">{{item.cards}}</text></view><text class="program-balance">{{item.remaining}} 次</text></view></view></view></block><block wx:if="{{showAirports && airports.length}}"><view class="section-heading"><text>已收录的机场</text><text class="section-count">{{airports.length}}</text></view><view class="airport-list"><view wx:for="{{airports}}" wx:key="key" class="airport-row" data-value="{{item.key}}" bindtap="selectAirport" role="button" aria-label="查询{{item.name}}"><text class="airport-code">{{item.code}}</text><view class="airport-identity"><text class="airport-name">{{item.name}}</text><text class="airport-description">{{item.city ? item.city + ' · ' : ''}}{{item.count}} 条已登记贵宾厅资料</text></view><text class="airport-count">{{item.count}} 条</text></view></view></block>
    <block wx:elif="{{matches.length}}">
      <view class="result-summary" role="status"><view class="result-airport"><text class="result-code">{{resultAirportCode || '机场'}}</text><view><text class="result-name">{{resultAirportName}}</text><text class="result-caption">{{resultCity ? resultCity + ' · ' : ''}}找到 {{matches.length}} 条已登记资料</text></view></view><view class="result-notice">已登记权益与准入规则，使用前请核实</view></view>
      <view class="result-filters"><view class="terminal-field"><input id="terminal-query" class="terminal-input" aria-label="航站楼（选填）" value="{{terminal}}" bindinput="changeTerminal" placeholder="航站楼，如 T2" maxlength="60" confirm-type="search" /></view><view class="zone-filters"><button wx:for="{{zones}}" wx:key="value" class="zone-filter {{zone === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="changeZone" aria-pressed="{{zone === item.value}}">{{item.label}}</button></view></view>
      <view wx:for="{{matches}}" wx:key="key" class="lounge-card"><view class="lounge-main"><view class="lounge-top"><text class="terminal-tag">{{item.terminal}} · {{item.zoneLabel}}</text><text class="lounge-status {{item.usable ? 'available' : ''}}">{{item.usable ? '关联权益可用' : '关联权益不可用'}}</text></view><view class="lounge-title">{{item.title}}</view><view class="location-line">{{item.location || '具体位置待核实'}}</view><view class="hours-line">{{item.openingHours || '营业时间待核实'}} · {{item.reservation}}</view></view><view class="owned-benefit {{item.usable ? 'available' : ''}}"><view class="owned-caption">关联的持有权益</view><view class="owned-row"><image wx:if="{{item.bankLogo}}" class="bank-logo" src="{{item.bankLogo}}" mode="aspectFit" /><view class="owned-identity"><text class="owned-name">{{item.cardName || item.benefitTitle}}</text><text class="owned-hint">{{item.benefitTitle}} · 请核实预约与客户资格</text></view><text class="owned-balance">{{item.remaining}} 次</text><button class="use-button" data-value="{{item.key}}" bindtap="recordUse" disabled="{{!item.usable || loading || refreshing || outdated}}">记录使用</button></view></view><button class="rules-toggle" data-value="{{item.key}}" bindtap="toggleMatch" aria-expanded="{{expandedMatchKey === item.key}}"><text>支持银行与准入规则</text><text class="bank-count">{{item.supportedBanks.length}} 家已登记</text><text class="rules-arrow" aria-hidden="true">{{expandedMatchKey === item.key ? '⌃' : '⌄'}}</text></button><view wx:if="{{expandedMatchKey === item.key}}" class="lounge-details"><view class="bank-heading">支持的银行</view><view wx:if="{{item.supportedBanks.length}}" class="bank-list"><text wx:for="{{item.supportedBanks}}" wx:for-item="bank" wx:key="*this" class="bank-label">{{bank}}</text></view><view wx:else class="bank-unknown">尚未登记支持银行</view><text class="bank-help">具体卡种与客户条件仍需核实</text><view class="access-rules"><view class="rule-row"><text class="rule-label">预约</text><view><view class="rule-value">{{item.reservation}}</view><view wx:if="{{item.reservationNote}}" class="rule-detail">{{item.reservationNote}}</view></view></view><view class="rule-row"><text class="rule-label">客户资格</text><view><view class="rule-value">{{item.customerScope}}</view><view class="rule-detail">{{item.customerNote || '具体卡种与客户条件尚未登记，请先核实。'}}</view></view></view><view class="rule-row"><text class="rule-label">同行人</text><view class="rule-detail">{{item.guestNote || '携伴规则未登记，请提前核实。'}}</view></view></view><view class="additional-info"><view><text class="info-label">营业时间</text><text>{{item.openingHours || '未登记，请核实'}}</text></view><view><text class="info-label">具体位置</text><text>{{item.location || '未登记，请核实'}}</text></view><view wx:if="{{item.sourceNote}}"><text class="info-label">资料来源</text><text>{{item.sourceNote}}</text></view><view><text class="info-label">核实日期</text><text>{{item.verifiedOn || '尚未登记'}}</text></view></view></view></view>
    </block>
    <view wx:if="{{!matches.length}}" class="empty"><view class="empty-title">未找到已登记的贵宾厅</view><text>{{filtered ? '试试其他机场名称、城市或三字码，也可以清除筛选。' : entitlementId ? '这项权益还没有贵宾厅登记，或已归档。' : '在贵宾厅权益中补充机场、支持银行与准入条件，即可在这里查询。'}}</text><text class="subtitle">这不代表该机场没有贵宾厅。</text><button wx:if="{{filtered}}" class="secondary" bindtap="clearFilters">清除筛选</button><button wx:if="{{entitlementId}}" class="secondary" bindtap="clearScope">查询全部权益</button><button wx:if="{{!registeredCount && !entitlementId}}" class="primary" bindtap="addLoungeBenefit">登记贵宾厅资料</button></view>
    <button wx:if="{{filtered && matches.length}}" class="clear-filters text-button" bindtap="clearFilters">重新选择机场</button>
  </block>
  <view class="registry-note">{{demo ? '演示银行与贵宾厅均为虚构示例，不可用于实际出行。' : '仅查询已登记资料，出行前请向银行或贵宾厅核实。'}}</view>
</view>
