page { background:#F3F6FB; color:#0F1B2D; }
.submissions-page { padding:4px 16px 28px; }
.page-heading { display:flex; align-items:center; gap:12px; margin-bottom:12px; padding-left:4px; }
.page-description { display:block; color:#5E6E84; font-size:13px; line-height:1.55; }
.page-heading .page-description { flex:1; min-width:0; }
button.new-button { flex:none; height:36px; min-height:36px; margin:0; padding:0 14px; border-radius:999px; background:#1F61D8; color:#FFFFFF; font-size:13px; font-weight:600; }
.new-button::after,.submission-row::after,.text-button::after,.primary-button::after { border:0; }
.submission-list { display:flex; flex-direction:column; gap:12px; }
button.submission-row { display:flex; flex-direction:column; align-items:stretch; gap:8px; width:100%; margin:0; padding:14px; border:1px solid #E3E9F2; border-radius:18px; background:#FFFFFF; color:#0F1B2D; text-align:left; font-weight:400; line-height:1.5; }
button.submission-row:active:not([disabled]) { background:#F4F7FC; }
.row-top { display:flex; align-items:center; gap:8px; }
.bank-logo { flex:none; width:22px; height:22px; padding:2px; border:1px solid #EBF0F7; border-radius:50%; background:#FFFFFF; }
.bank-name { flex:1; min-width:0; color:#3F4D63; font-size:13px; }
.status { flex:none; padding:3px 9px; border-radius:999px; color:#9A5B07; background:#FDF1DE; font-size:11px; font-weight:600; line-height:1.45; }
.status.returned { color:#9A5B07; background:#FDF1DE; }
.status.published { color:#2D7A4F; background:#E2F0E4; }
.submission-title { display:block; font-size:16px; font-weight:600; line-height:1.35; }
.submission-summary { display:block; overflow:hidden; color:#5E6E84; font-size:12px; line-height:1.5; text-overflow:ellipsis; white-space:nowrap; }
.review-note { display:block; padding:10px 12px; border-radius:12px; background:#FDF1DE; color:#9A5B07; font-size:13px; line-height:1.5; }
.row-bottom { display:flex; align-items:center; gap:8px; padding-top:2px; }
.date-label { flex:1; min-width:0; color:#5E6E84; font-size:12px; font-variant-numeric:tabular-nums; }
.row-link { flex:none; display:flex; align-items:center; gap:5px; color:#1A56C4; font-size:13px; font-weight:500; }
.chevron { font-size:19px; line-height:1; }
button.text-button { min-height:44px; padding:0 12px; border-radius:12px; background:transparent; color:#1A56C4; font-size:14px; }
button.more-button { width:100%; margin-top:12px; }
.empty { display:flex; flex-direction:column; align-items:center; gap:10px; padding:28px 16px; border:1px dashed #C5D0DF; border-radius:18px; text-align:center; }
.empty-art { display:flex; align-items:center; justify-content:center; width:92px; height:92px; border:1.5px dashed #C5D0DF; border-radius:50%; background:#EEF3FA; }
.document-icon { position:relative; width:32px; height:40px; padding:9px 6px; border:2px solid #9AA8BC; border-radius:6px; }
.document-line { height:2px; margin-bottom:5px; border-radius:2px; background:#9AA8BC; }
.document-line.short { width:12px; }
.document-plus { position:absolute; right:-7px; bottom:-3px; width:16px; height:16px; border:2px solid #EEF3FA; border-radius:50%; background:#1F61D8; }
.document-plus::before,.document-plus::after { position:absolute; left:3px; top:6px; width:6px; height:1.5px; background:#FFFFFF; content:""; }
.document-plus::after { transform:rotate(90deg); }
.empty-title { display:block; color:#0F1B2D; font-size:16px; font-weight:600; line-height:1.4; }
button.primary-button { min-height:44px; margin-top:6px; padding:0 18px; border-radius:12px; background:#1F61D8; color:#FFFFFF; font-size:14px; font-weight:600; }
.error { display:block; margin-bottom:12px; padding:12px 14px; border:1px solid #F1C7C1; border-radius:14px; background:#FFF2F0; color:#B8392C; font-size:13px; line-height:1.6; }
.error .text-button { margin-top:8px; }
.error .page-description { margin-top:4px; }
.more-error { margin-top:12px; }
.loading { padding:28px 16px; border:1px solid #E3E9F2; border-radius:18px; background:#FFFFFF; color:#5E6E84; text-align:center; font-size:13px; }
.refresh-notice,.refresh-copy { display:block; font-size:13px; line-height:1.6; }
.refresh-notice { margin-bottom:12px; padding:0 4px; color:#5E6E84; }
.refresh-copy { margin-top:6px; }
.submission-list.is-session-pending { visibility:hidden; }
