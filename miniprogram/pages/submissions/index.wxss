.submissions-page{padding:24px 20px 32px;color:var(--ink,#172638)}.page-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:24px}.page-title{display:block;font-size:25px;font-weight:650;line-height:1.4}.page-description{display:block;font-size:14px;color:var(--muted,#647084);line-height:1.6;margin-top:6px}.new-button{margin:0;flex:none;min-height:48px;padding:0 12px;display:flex;align-items:center;background:#eaf2ff;color:var(--blue,#165dcc);font-size:14px;border-radius:8px}.new-button::after,.submission-row::after,.text-button::after,.primary-button::after{border:0}.submission-list{background:var(--surface,#fff);border-radius:12px;padding:0 16px}button.submission-row{display:block;width:100%;margin:0;padding:20px 0;border-radius:0;border-bottom:1px solid var(--line,#e5eaf1);background:transparent;text-align:left;font-weight:400;line-height:1.5}.submission-row:last-child{border-bottom:0}.submission-row:active{opacity:.65}.row-top,.row-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px}.bank-name,.row-bottom{font-size:12px;color:var(--muted,#647084)}.status{font-size:12px;color:var(--muted,#647084)}.status.returned{color:#a64a13}.status.published{color:var(--blue,#165dcc)}.submission-title{display:block;font-size:18px;font-weight:600;color:var(--ink,#172638);margin:10px 0 12px;line-height:1.45}.review-note{display:block;padding:10px 12px;background:#fff6ea;border-radius:6px;margin-bottom:12px;color:#874311;font-size:13px;line-height:1.6}.row-link{color:var(--blue,#165dcc);display:flex;align-items:center;gap:8px}.chevron{font-size:20px;line-height:1}.text-button{min-height:48px;display:flex;align-items:center;justify-content:center;background:transparent;color:var(--blue,#165dcc);font-size:14px}button.more-button{margin-top:12px}.empty{padding:32px 16px;text-align:center;background:var(--surface,#fff);border-radius:12px}.empty-title{display:block;font-size:19px;font-weight:600}button.primary-button{background:var(--blue,#165dcc);color:#fff;min-height:48px;display:flex;align-items:center;justify-content:center;font-size:16px;border-radius:8px;margin-top:24px}.error{padding:12px 16px;background:#fff3f1;color:#9c3429;border-radius:8px;font-size:14px;line-height:1.6;margin-bottom:16px}.loading{padding:32px 0;color:var(--muted,#647084);font-size:14px}

.submission-summary{display:block;font-size:14px;line-height:1.6;color:var(--muted,#647084);margin:8px 0 16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
