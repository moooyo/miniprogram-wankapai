<design-nav title="我的投稿" back />
<view class="submissions-page">
  <view class="page-heading">
    <text class="page-description">活动经审核通过后公开。</text>
    <button class="new-button" bindtap="create">提交线索</button>
  </view>
  <view wx:if="{{error}}" class="error" role="alert">
    <text>{{error}}</text>
    <text wx:if="{{items.length}}" class="refresh-copy">{{sessionVerified ? '当前显示上次读取的投稿。' : '已保留列表位置。账号暂未核实，重新核实后显示投稿。'}}</text>
    <button class="text-button" bindtap="load" disabled="{{loading}}">{{sessionVerified ? '重新读取投稿' : '重新核实账号'}}</button>
  </view>
  <text wx:if="{{loading && items.length}}" class="refresh-notice" role="status">{{sessionVerified ? '正在更新投稿，已显示的内容仍保留…' : '正在核实账号，核实通过后显示投稿…'}}</text>
  <view wx:if="{{loading && !items.length}}" class="loading" role="status">{{sessionVerified ? '正在读取投稿…' : '正在核实账号…'}}</view>
  <view wx:elif="{{!items.length && !error}}" class="empty">
    <view class="empty-art" aria-hidden="true"><view class="document-icon"><view class="document-line"></view><view class="document-line short"></view><view class="document-plus"></view></view></view>
    <text class="empty-title">暂无投稿记录</text>
    <text class="page-description">填写银行、活动名称并提供一种来源即可提交</text>
    <button class="primary-button" bindtap="create">分享第一个活动</button>
  </view>
  <view wx:else class="submission-list {{!sessionVerified ? 'is-session-pending' : ''}}" aria-hidden="{{!sessionVerified}}">
    <button wx:for="{{items}}" wx:key="id" class="submission-row" bindtap="open" data-id="{{item.id}}" disabled="{{!sessionVerified}}">
      <view class="row-top">
        <image wx:if="{{item.draft || item.lead}}" class="bank-logo" src="/assets/banks/{{item.draft ? item.draft.bankId : item.lead.bankId}}.png" mode="aspectFit" aria-hidden="true" />
        <text class="bank-name">{{item.bankName}}</text>
        <text class="status {{item.status}}">{{item.statusLabel}}</text>
      </view>
      <text class="submission-title">{{item.titleText}}</text>
      <text class="submission-summary">{{item.isLead ? '活动线索 · 来源：' : '完整活动投稿 · '}}{{item.summaryText}}</text>
      <text wx:if="{{item.status === 'returned'}}" class="review-note">{{item.reviewNote}}</text>
      <view class="row-bottom">
        <text class="date-label">{{item.dateLabel}} 更新</text>
        <view class="row-link"><text>{{item.status === 'returned' ? '补充投稿' : item.status === 'pending' ? '查看与修改' : '查看详情'}}</text><text class="chevron" aria-hidden="true">›</text></view>
      </view>
    </button>
  </view>
  <view wx:if="{{loadMoreError && !loading}}" class="error more-error" role="alert"><text>{{loadMoreError}}</text><text class="page-description">已读取的投稿仍保留在上方。</text></view>
  <button wx:if="{{nextCursor && !loading}}" class="text-button more-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore || !sessionVerified || refreshing}}">{{loadingMore ? '正在读取更多投稿' : loadMoreError ? '重试加载更多' : '加载更多'}}</button>
</view>
