<design-nav title="活动"/>
<view class="activity-page" aria-hidden="{{showBanks || showJoin || viewerOpen}}">
  <view class="discovery-controls">
    <scroll-view class="bank-rail" scroll-x enhanced show-scrollbar="{{false}}" enable-flex aria-label="横向滑动选择银行">
      <view class="bank-options">
        <button class="bank-choice {{bankId === '' ? 'is-selected' : ''}}" data-id="" bindtap="chooseBank" aria-label="筛选全部银行" aria-pressed="{{bankId === ''}}"><view class="all-bank-mark">全</view><text>全部</text></button>
        <button wx:for="{{banks}}" wx:key="id" class="bank-choice {{bankId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseBank" aria-pressed="{{bankId === item.id}}"><image class="bank-logo" src="{{item.logo}}" mode="aspectFit" aria-hidden="true"/><text>{{item.shortName}}</text></button>
      </view>
    </scroll-view>
    <view class="filter-row"><text class="filter-count">{{mineOnly ? '已按 ' + cardCount + ' 张卡匹配' : '全部活动'}} · 共 {{totalCount}} 个</text><button class="mine-control" bindtap="toggleMine" aria-label="仅看我的卡" aria-pressed="{{mineOnly}}"><text>仅看我的卡</text><view class="mine-switch {{mineOnly ? 'is-on' : ''}}"><view/></view></button></view>
  </view>
  <view class="activity-content">
    <view class="feed-heading"><text class="section-title">{{bankName}}</text><button class="text-button subscribe-button" bindtap="onSubscribe" loading="{{subscribeBusy}}" disabled="{{subscribeBusy}}">{{subscribed ? '已订阅' : '订阅新活动'}}</button><button class="text-button" bindtap="submitActivity">投稿</button></view>
    <view wx:if="{{loading && !items.length}}" class="state-block" role="status">正在加载活动…</view>
    <view wx:elif="{{error && !items.length}}" class="state-block" role="alert"><text>{{error}}</text><button class="button secondary" bindtap="retry">重新加载</button></view>
    <block wx:else>
      <text wx:if="{{loading}}" class="list-notice" role="status">正在更新活动…</text>
      <view wx:elif="{{error}}" class="list-notice" role="alert"><text>{{error}}当前显示上次加载的内容。</text><button class="text-button" bindtap="retry">重新加载</button></view>
      <view wx:for="{{items}}" wx:key="id" class="activity-tile" data-id="{{item.id}}" data-participation="{{item.participationId}}" bindtap="openActivity">
        <view class="offer-bank"><image class="bank-logo-small" src="{{item.logo}}" mode="aspectFit" aria-hidden="true"/><text class="offer-bank-name">{{item.bankName}}</text><text wx:if="{{item.isNew}}" class="new-badge">新</text><view class="cycle-chip {{item.repeating ? 'is-repeating' : ''}}"><text wx:if="{{item.repeating}}" class="cycle-symbol">↻</text><text>{{item.frequencyLabel}}</text></view></view>
        <view class="offer-body"><view class="offer-copy"><text class="tile-title">{{item.title}}</text><text class="tile-description">{{item.conditions}}</text><text class="tile-facts">{{item.facts}}</text></view><button wx:if="{{item.shotCount}}" class="tile-shot" data-id="{{item.id}}" catchtap="openShot" aria-label="查看活动截图"><image wx:if="{{item.shots[0].url}}" src="{{item.shots[0].url}}" mode="aspectFill"/><text wx:else class="shot-pending">活动截图</text><text class="shot-count">{{item.shotCount}} 张</text></button></view>
        <text wx:if="{{item.invited}}" class="qualification">仅限受邀用户，请核对资格</text>
        <view class="tile-bottom"><view class="tile-reward"><view class="reward-line"><text class="reward-value">{{item.reward}}</text><text class="reward-label">{{item.rewardLabel}}</text></view><text class="tile-status tone-{{item.statusTone}}">{{item.status}}</text></view><button class="tile-action action-{{item.actionTone}}" data-id="{{item.id}}" data-participation="{{item.participationId}}" catchtap="actOnActivity" disabled="{{joinBusy}}">{{item.actionLabel}}</button></view>
      </view>
      <view wx:if="{{!items.length}}" class="state-block empty-block"><text class="empty-title">暂无匹配的活动</text><text>可切换其他银行，或关闭「仅看我的卡」</text><button class="button secondary" bindtap="clearFilters">查看全部活动</button><button class="text-button" bindtap="addCard">管理我的卡包</button></view>
      <text wx:if="{{loadMoreError}}" class="list-notice" role="alert">{{loadMoreError}}</text>
      <button wx:if="{{cursor}}" class="more-button" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loading || loadingMore}}">{{loadingMore ? '加载中' : loadMoreError ? '重试加载更多' : '查看更多活动'}}</button>
    </block>
  </view>
</view>
<app-sheet id="bank-picker" show="{{showBanks}}" title="全部银行" content-state="{{[filteredBanks, bankSearch, bankId]}}" bindclose="closeBanks"><input class="bank-search" value="{{bankSearch}}" placeholder="搜索银行名称" bindinput="searchBanks" confirm-type="search" aria-label="搜索银行名称"/><view class="bank-grid"><button wx:if="{{!bankSearch}}" class="bank-grid-choice {{bankId === '' ? 'is-selected' : ''}}" data-id="" bindtap="chooseBank"><view class="all-bank-mark">全</view><text>全部银行</text></button><button wx:for="{{filteredBanks}}" wx:key="id" class="bank-grid-choice {{bankId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseBank"><image class="bank-logo" src="{{item.logo}}" mode="aspectFit"/><text>{{item.name}}</text></button></view><text wx:if="{{!filteredBanks.length}}" class="search-empty">没有找到这家银行，可尝试银行简称。</text></app-sheet>
<app-sheet id="activity-join" show="{{showJoin}}" title="参加活动" dismissible="{{!joinBusy}}" content-state="{{[joinItem, selectedCardId]}}" bindclose="closeJoin">
  <view wx:if="{{joinItem}}" class="join-summary"><view class="join-bank"><image src="{{joinItem.logo}}" mode="aspectFit"/><text>{{joinItem.bankName}}</text></view><text class="join-title">{{joinItem.title}}</text><text class="join-condition">{{joinItem.conditions}}</text><text class="join-period">{{joinItem.frequencyLabel}} · {{joinItem.facts}}</text></view>
  <text class="join-card-label">选择参加的卡片</text><view class="join-card-options"><button wx:for="{{joinItem.cards}}" wx:key="id" class="join-card {{selectedCardId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseJoinCard" disabled="{{joinBusy}}"><image src="{{item.logo}}" mode="aspectFit"/><view class="join-card-copy"><text class="join-card-name">{{item.name}}</text><text class="join-card-description">{{item.description}}</text></view><view class="selection-mark">{{selectedCardId === item.id ? '✓' : ''}}</view></button></view>
  <text class="join-caption">参加后可随时在活动详情中退出</text><button class="button primary join-confirm" bindtap="confirmJoin" loading="{{joinBusy}}" disabled="{{joinBusy || (joinItem.activity.scope === 'card' && !selectedCardId)}}">加入进度</button>
</app-sheet>
<screenshot-viewer id="activity-viewer" show="{{viewerOpen}}" items="{{viewerItems}}" index="{{viewerIndex}}" context="activity" bindclose="closeViewer"/>
