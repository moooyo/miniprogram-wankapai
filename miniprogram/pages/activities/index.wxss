page{background:#f4f7fb}.activity-page{--activity-line:#e5ebf3;--activity-muted:#626f82;--activity-blue:#1f61d8;--activity-ink:#172c49;padding-bottom:24px;color:var(--activity-ink)}.discovery-controls{padding:12px 16px 0;background:#fff}.bank-toolbar{display:flex;align-items:center;gap:8px}.bank-rail{flex:1;min-width:0;white-space:nowrap}.bank-options{display:flex;gap:8px;padding:2px 6px 4px 0}.bank-choice{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:7px;flex:0 0 56px;width:56px;min-height:72px;margin:0;padding:6px 3px;border:1px solid transparent;border-radius:10px;background:#fff;color:var(--activity-muted);font-size:12px;line-height:1.4}.bank-choice::after,.all-banks::after,.offer-heading::after,.text-button::after,.tile-action::after,.more-button::after,.bank-grid-choice::after{border:0}.bank-choice.is-selected,.bank-grid-choice.is-selected{background:#edf4ff;border-color:#aac6f1;color:#144baf}.bank-logo,.all-bank-mark{height:30px;width:30px;flex-shrink:0}.all-bank-mark{display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:600;color:#315981}.all-banks{flex:0 0 66px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:72px;margin:0;padding:0 0 0 8px;border-left:1px solid var(--activity-line);background:#fff;color:#3e5069;font-size:12px;line-height:1.4}.grid-mark{display:grid;grid-template-columns:repeat(2,7px);gap:3px;height:17px;width:17px}.grid-mark view{border:1.5px solid #466181;border-radius:1px}.filter-row{display:flex;justify-content:space-between;gap:8px;align-items:center;min-height:56px}.filter-count{font-size:12px;color:var(--activity-muted)}.mine-control{display:flex;align-items:center;gap:8px;min-height:48px;color:#364b67;font-size:13px}.mine-control switch{zoom:.8}.activity-content{padding:8px 16px 16px}.feed-heading{display:flex;align-items:center;justify-content:space-between;min-height:48px}.section-title{font-size:16px;font-weight:600}.text-button{min-height:48px;min-width:48px;display:flex;justify-content:center;align-items:center;background:transparent;border:0;margin:0;padding:0 8px;color:var(--activity-blue);font-size:14px;line-height:1.5}.activity-tile{background:#fff;border:1px solid var(--activity-line);border-radius:12px;padding:16px;margin-bottom:12px}.offer-heading{display:flex;flex-direction:column;gap:10px;min-height:64px;text-align:left;width:100%;padding:0;margin:0;background:transparent;color:var(--activity-ink);line-height:1.5}.offer-bank{display:flex;align-items:center;gap:7px;width:100%;font-size:12px;font-weight:400;color:var(--activity-muted)}.bank-logo-small{width:22px;height:22px;flex-shrink:0}.period-label{margin-left:auto;white-space:nowrap}.tile-title{font-size:18px;font-weight:600;word-break:break-all}.tile-description{display:block;margin-top:8px;color:#526178;font-size:13px;line-height:1.7}.tile-facts{display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:10px;color:var(--activity-muted);font-size:12px;line-height:1.6}.qualification{display:block;color:#805316;font-size:12px;margin-top:8px}.tile-bottom{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid #edf1f6;margin-top:14px;padding-top:8px}.tile-reward{display:flex;align-items:baseline;gap:7px}.reward-value{color:#174a9d;font-size:23px;font-weight:600;font-variant-numeric:tabular-nums}.reward-label{font-size:12px;color:var(--activity-muted)}.tile-action{display:flex;align-items:center;justify-content:center;min-height:48px;margin:0;padding:8px 12px;border-radius:8px;background:#edf4ff;color:#174fae;font-size:14px;line-height:1.5}.state-block{display:flex;flex-direction:column;align-items:center;gap:16px;padding:36px 16px;color:var(--activity-muted);font-size:14px;text-align:center}.empty-title{color:var(--activity-ink);font-weight:600;font-size:18px}.more-button{min-height:48px;background:#fff;font-size:14px;color:var(--activity-blue);border-radius:8px}.feed-end{display:block;text-align:center;padding:12px 0;color:var(--activity-muted);font-size:12px}.bank-search{height:48px;border:1px solid #91a8c6;border-radius:8px;background:#f8fafd;padding:0 12px;font-size:16px;box-sizing:border-box}.bank-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:16px}.bank-grid-choice{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;min-height:94px;margin:0;padding:10px 5px;border:1px solid #d5deeb;border-radius:10px;background:#fff;color:#3c506d;font-size:12px;line-height:1.5}.search-empty{display:block;padding:24px 0;color:var(--activity-muted);font-size:14px;text-align:center}
.feed-actions{display:flex;align-items:center;gap:8px}.feed-actions .subscribe-button{color:#526178;font-size:12px}.feed-heading .section-title{flex:1;min-width:0;line-height:1.5}
