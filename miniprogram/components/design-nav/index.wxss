.nav-spacer { width:100%; }.nav { position:fixed; top:0; left:0; right:0; z-index:40; background:#F3F6FB; box-sizing:border-box; }.nav-row { height:44px; display:flex; align-items:center; padding:0 110px 0 16px; position:relative; box-sizing:border-box; }.nav-title { font-family:"PingFang SC","Microsoft YaHei",sans-serif; font-size:20px; font-weight:600; line-height:1.3; display:flex; align-items:center; gap:8px; white-space:nowrap; }.secondary-nav { padding:0; }.secondary-nav .nav-title { position:absolute; left:72px; right:100px; height:44px; justify-content:center; font-size:17px; }.nav-row .back { margin:0 0 0 4px; padding:0; width:44px; height:44px; min-height:44px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:transparent; }.back::after { border:0; }.back:active { background:#EBF0F7; }.back-mark { width:10px; height:10px; border-left:2px solid #0F1B2D; border-bottom:2px solid #0F1B2D; transform:rotate(45deg); }.demo { font-size:10px; font-weight:500; color:#5E6E84; background:#EBF0F7; border-radius:999px; padding:2px 6px; }
