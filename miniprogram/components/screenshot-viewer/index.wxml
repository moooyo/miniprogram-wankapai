<view wx:if="{{show}}" class="viewer" catchtouchmove="stop" role="dialog" aria-modal="true" aria-label="活动截图"><view class="viewer-head" style="padding-top:{{statusHeight}}px"><button class="close" bindtap="close" aria-label="关闭截图">×</button><text class="position">{{activeIndex + 1}} / {{items.length}}</text></view><view class="viewer-body"><view class="shot"><image class="shot-image" src="{{shot.url}}" mode="aspectFit"/><view wx:for="{{regions}}" wx:key="field" class="region" style="{{item.style}}"><text class="region-label">{{item.label}}</text></view></view><button wx:if="{{items.length > 1}}" class="arrow previous {{activeIndex === 0 ? 'is-disabled' : ''}}" bindtap="previous" disabled="{{activeIndex === 0}}" aria-label="上一张">‹</button><button wx:if="{{items.length > 1}}" class="arrow next {{activeIndex === items.length - 1 ? 'is-disabled' : ''}}" bindtap="next" disabled="{{activeIndex === items.length - 1}}" aria-label="下一张">›</button></view><view class="viewer-foot"><view wx:if="{{items.length > 1}}" class="dots"><view wx:for="{{items}}" wx:key="id" class="dot {{index === activeIndex ? 'selected' : ''}}"/></view><view class="metadata"><text class="tag">{{shot.label || '活动规则'}}</text><text>{{shot.uploader || '用户上传'}}{{shot.uploadedOn ? ' · ' + shot.uploadedOn : ''}}</text></view><text class="note">{{note}}</text><view class="actions"><button class="viewer-action" wx:if="{{context === 'form'}}" bindtap="remove">删除截图</button><button class="viewer-action" wx:elif="{{context === 'review'}}" bindtap="copy">复制截图链接</button><block wx:else><button class="viewer-action" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存图片</button><button class="viewer-action" bindtap="feedback">反馈问题</button></block></view></view></view>
