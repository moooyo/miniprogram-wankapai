.viewer { position:fixed; inset:0; z-index:200; background:#0B1220; color:#fff; display:flex; flex-direction:column; animation:fade-in .22s; font-family:"PingFang SC","Microsoft YaHei",sans-serif; box-sizing:border-box; }.viewer-head { flex:none; height:auto; min-height:44px; position:relative; display:flex; align-items:center; box-sizing:content-box; }.viewer-head .close { width:44px; height:44px; min-height:44px; margin:0 0 0 4px; padding:0; border:0; background:transparent; color:white; font-size:30px; line-height:1; }.close::after,.arrow::after,.viewer-action::after { border:0; }.position { position:absolute; left:100px; right:100px; bottom:0; height:44px; display:flex; align-items:center; justify-content:center; font:15px "DM Mono",Consolas,monospace; }.viewer-body { flex:1; min-height:0; position:relative; display:flex; align-items:center; justify-content:center; padding:12px 44px; }.shot { position:relative; width:100%; max-width:300px; aspect-ratio:3/4; border-radius:14px; overflow:hidden; background:white; box-shadow:0 24px 60px -24px rgba(0,0,0,.7); }.shot-image { display:block; width:100%; height:100%; }.region { position:absolute; border:2px solid #2B6DE8; box-sizing:border-box; pointer-events:none; }.region-label { position:absolute; left:-2px; top:-18px; padding:2px 4px; background:#2B6DE8; color:#fff; font-size:10px; white-space:nowrap; }.viewer-body .arrow { position:absolute; top:50%; margin-top:-18px; width:36px; height:36px; min-height:36px; padding:0; border-radius:50%; background:rgba(255,255,255,.14); color:#fff; font-size:26px; display:flex; justify-content:center; align-items:center; }.arrow.is-disabled { opacity:.3; }.previous { left:4px; }.next { right:4px; }.viewer-foot { flex:none; padding:16px 20px calc(16px + env(safe-area-inset-bottom)); display:flex; flex-direction:column; gap:10px; }.dots { display:flex; justify-content:center; gap:6px; padding-bottom:4px; }.dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,.3); }.dot.selected { background:#fff; }.metadata { display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:13px; color:#C9D3E1; }.tag { border-radius:999px; padding:3px 9px; background:rgba(255,255,255,.16); color:#fff; font-size:12px; font-weight:600; }.note { font-size:13px; line-height:1.55; color:#C9D3E1; }.actions { display:flex; gap:10px; padding-top:4px; }.actions .viewer-action { flex:1; height:44px; min-height:44px; border-radius:12px; background:rgba(255,255,255,.12); color:white; font-size:14px; font-weight:500; display:flex; align-items:center; justify-content:center; padding:0; }@keyframes fade-in { from { opacity:0; } to { opacity:1; } }@media(prefers-reduced-motion:reduce) { .viewer { animation:none; } }
